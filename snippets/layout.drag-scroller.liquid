{%- doc -%}
  Wraps horizontally-scrollable content in a custom element that adds
  drag-to-scroll (pointer capture, 6px threshold before a drag counts,
  momentum on release) for mouse/pen input, plus a self-painting
  scroll-progress bar: a thumb whose width is the visible fraction of the
  track and whose position is the scroll progress, hidden entirely when
  the track doesn't overflow.

  Touch input is left to the browser's native scrolling (with its own
  momentum) rather than being hijacked by the drag handler.

  Also sets a `data-overflowing` attribute the caller can use to hide
  other drag affordances (e.g. a "Drag" hint) when nothing overflows.

  @param slot {string} The scrollable track markup (captured HTML)
  @param label {string} Optional aria-label for the scrollable region

  @example
  {% render 'layout.drag-scroller', slot: gallery_track, label: 'Gallery, scroll horizontally' %}
{%- enddoc -%}

{% stylesheet %}
  drag-scroller {
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x proximity;
    cursor: grab;
  }

  drag-scroller::-webkit-scrollbar {
    display: none;
  }

  drag-scroller[data-dragging] {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  drag-scroller[data-dragging] * {
    pointer-events: none;
  }

  /* Background of the bar */
  .drag-scroller__bar {
    position: relative;
    height: 1px;
    margin-top: 12px;
    background: rgba(249, 246, 241, 0.22);
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  /* color of the bar */
  .drag-scroller__bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: rgb(249, 246, 241);
    transform-origin: left center;
    transform: scaleX(1);
    will-change: transform;
  }
{% endstylesheet %}

<drag-scroller tabindex="0" role="region"{% if label != blank %} aria-label="{{ label | escape }}"{% endif %}>
  {{ slot }}
</drag-scroller>
<div class="drag-scroller__bar" aria-hidden="true"><i></i></div>

{% javascript %}
  class DragScroller extends HTMLElement {
    constructor() {
      super()
      this.onPointerDown = this.onPointerDown.bind(this)
      this.onPointerMove = this.onPointerMove.bind(this)
      this.onPointerUp = this.onPointerUp.bind(this)
      this.onScroll = this.onScroll.bind(this)
      this.onKeydown = this.onKeydown.bind(this)
      this.onClickCapture = this.onClickCapture.bind(this)
      this.queuePaint = this.queuePaint.bind(this)
      this.resizeObserver = new ResizeObserver(this.queuePaint)
      this.dragging = false
      this.moved = false
      this.startX = 0
      this.startScrollLeft = 0
      this.paintPending = false
      this.velocity = 0
      this.lastX = 0
      this.lastT = 0
      this.momentumId = null
    }

    connectedCallback() {
      this.bar = this.nextElementSibling && this.nextElementSibling.classList.contains('drag-scroller__bar')
        ? this.nextElementSibling
        : null
      this.thumb = this.bar ? this.bar.firstElementChild : null

      this.addEventListener('pointerdown', this.onPointerDown)
      this.addEventListener('scroll', this.onScroll, { passive: true })
      this.addEventListener('keydown', this.onKeydown)
      this.addEventListener('click', this.onClickCapture, true)
      this.resizeObserver.observe(this)
      window.addEventListener('resize', this.queuePaint)
      window.addEventListener('load', this.queuePaint)
      this.queuePaint()
    }

    disconnectedCallback() {
      this.cancelMomentum()
      this.resizeObserver.disconnect()
      this.removeEventListener('pointerdown', this.onPointerDown)
      this.removeEventListener('scroll', this.onScroll)
      this.removeEventListener('keydown', this.onKeydown)
      this.removeEventListener('click', this.onClickCapture, true)
      window.removeEventListener('resize', this.queuePaint)
      window.removeEventListener('load', this.queuePaint)
    }

    queuePaint() {
      if (this.paintPending) return
      this.paintPending = true
      requestAnimationFrame(() => {
        this.paintPending = false
        this.paint()
      })
    }

    onScroll() {
      this.queuePaint()
    }

    paint() {
      const span = this.scrollWidth - this.clientWidth
      const overflowing = span > 1
      this.toggleAttribute('data-overflowing', overflowing)

      if (!this.bar || !this.thumb) return

      if (!overflowing) {
        this.bar.style.opacity = '0'
        return
      }

      this.bar.style.opacity = '1'
      const visibleFraction = this.clientWidth / this.scrollWidth
      const progress = this.scrollLeft / span
      const position = progress * (1 - visibleFraction) * 100
      this.thumb.style.transform = `translateX(${position.toFixed(3)}%) scaleX(${visibleFraction.toFixed(4)})`
    }

    onPointerDown(event) {
      // Touch already gets native momentum scrolling from the browser;
      // hijacking it with 1:1 JS tracking only makes it feel worse.
      // Only take over for mouse/pen drag.
      if (event.pointerType === 'touch') return

      this.cancelMomentum()
      this.dragging = true
      this.moved = false
      this.startX = event.clientX
      this.startScrollLeft = this.scrollLeft
      this.lastX = event.clientX
      this.lastT = performance.now()
      this.velocity = 0
      this.setPointerCapture(event.pointerId)
      this.addEventListener('pointermove', this.onPointerMove)
      this.addEventListener('pointerup', this.onPointerUp)
      this.addEventListener('pointercancel', this.onPointerUp)
      this.addEventListener('pointerleave', this.onPointerUp)
    }

    onPointerMove(event) {
      if (!this.dragging) return
      const delta = event.clientX - this.startX
      if (Math.abs(delta) > 6) {
        this.moved = true
        this.setAttribute('data-dragging', '')
      }
      this.scrollLeft = this.startScrollLeft - delta

      const now = performance.now()
      const dt = now - this.lastT
      if (dt > 0) {
        this.velocity = (this.lastX - event.clientX) / dt
      }
      this.lastX = event.clientX
      this.lastT = now
    }

    onPointerUp() {
      this.dragging = false
      this.removeAttribute('data-dragging')
      this.removeEventListener('pointermove', this.onPointerMove)
      this.removeEventListener('pointerup', this.onPointerUp)
      this.removeEventListener('pointercancel', this.onPointerUp)
      this.removeEventListener('pointerleave', this.onPointerUp)
      this.startMomentum()
    }

    startMomentum() {
      const friction = 0.95
      const minVelocity = 0.02
      if (Math.abs(this.velocity) < minVelocity) return

      const step = () => {
        this.velocity *= friction
        if (Math.abs(this.velocity) < minVelocity) {
          this.momentumId = null
          return
        }
        this.scrollLeft += this.velocity * 16
        this.momentumId = requestAnimationFrame(step)
      }
      this.momentumId = requestAnimationFrame(step)
    }

    cancelMomentum() {
      if (this.momentumId) {
        cancelAnimationFrame(this.momentumId)
        this.momentumId = null
      }
    }

    onClickCapture(event) {
      if (this.moved) {
        event.preventDefault()
        event.stopPropagation()
        this.moved = false
      }
    }

    onKeydown(event) {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return
      event.preventDefault()
      const amount = this.clientWidth * 0.8
      this.scrollBy({ left: event.key === 'ArrowRight' ? amount : -amount, behavior: 'smooth' })
    }
  }

  customElements.define('drag-scroller', DragScroller)
{% endjavascript %}
