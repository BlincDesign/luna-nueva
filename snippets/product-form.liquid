{% form 'product', product, id: form_id, class: 'product-single__form' %}
  {%- liquid
    assign gift_card_recipient_feature_active = false
    if block.settings.show_gift_card_recipient and product.gift_card?
      assign gift_card_recipient_feature_active = true
    endif

    assign enable_dynamic_buttons = false
    if show_dynamic_checkout and gift_card_recipient_feature_active == false
      unless template contains 'preorder'
        assign enable_dynamic_buttons = true
      endunless
    endif

    assign show_quantity = block.settings.show_quantity
  -%}

  {%- if gift_card_recipient_feature_active -%}
    {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
  {%- endif -%}

  {%- if enable_dynamic_buttons -%}
    <div class="payment-buttons">
  {%- endif -%}

  {%- liquid
    assign default_text = 'products.product.add_to_cart' | t
    assign button_text = 'products.product.add_to_cart' | t
    if template contains 'preorder'
      assign default_text = 'products.product.preorder' | t
      assign button_text = 'products.product.preorder' | t
    endif
    unless current_variant.available
      assign button_text = 'products.product.sold_out' | t
    endunless
  -%}

  {%- if show_quantity -%}
    <div class="product-form__quantity-row">
      <div class="product__quantity">
        {%- assign atc_qty_id = section_id | append: product.id | append: '-atc' -%}
        <label class="visually-hidden" for="Quantity-{{ atc_qty_id }}">{{ 'products.product.quantity' | t }}</label>
        {%- render 'quantity-input', form_id: form_id, id: atc_qty_id, qty: 1, min: 1 -%}
      </div>
  {%- endif -%}

  <button
    {% if product.empty? %}
      type="button"
    {% else %}
      type="submit"
    {% endif %}
    name="add"
    data-add-to-cart
    class="button btn--full button--primary add-to-cart{% if enable_dynamic_buttons and product.selling_plan_groups.size == 0 %} add-to-cart--secondary{% endif %}"
    {% unless current_variant.available %}
      disabled="disabled"
    {% endunless %}
  >
    <span data-add-to-cart-text data-default-text="{{ default_text }}">
      {{ button_text }}
    </span>
    <span class="add-to-cart--price">
      {{ current_variant.price | money_without_trailing_zeros }}
    </span>
  </button>

  {%- if show_quantity -%}
    </div>
  {%- endif -%}

  {% if enable_dynamic_buttons %}
    {{ form | payment_button }}
  {% endif %}

  {% if enable_dynamic_buttons %}
    </div>
  {% endif %}

  <div class="shopify-payment-terms product__policies">{{ form | payment_terms }}</div>

  <select name="id" data-product-select class="product-single__variants no-js">
    {%- for variant in product.variants -%}
      {% if variant.available %}
        <option
          {% if variant == product.selected_or_first_available_variant %}
            selected="selected"
          {% endif %}
          value="{{ variant.id }}"
        >
          {{ variant.title }} - {{ variant.price | money_with_currency }}
        </option>
      {% else %}
        <option disabled="disabled">{{ variant.title }} - {{ 'products.product.sold_out' | t }}</option>
      {% endif %}
    {%- endfor -%}
  </select>
{% endform %}
