{%- doc -%}

  Mobile-only gallery layout, kept separate from the desktop drag-scroller
  gallery so mobile-specific markup/logic can change without touching desktop.

  Layout:
    - The first image is rendered full width.
    - Everything else flows into a 2-column grid.
    - A tile with two images (image_one + image_two) contributes two grid
      cells instead of being squeezed into a single 50%-wide cell.

  @param image_blocks {array} Array of 'image' type blocks from section.blocks

  @example
  {% render 'mobile-gallery', image_blocks: image_blocks %}

{%- enddoc -%}

{%- liquid
  assign first_block = image_blocks.first
-%}

<div class="mobile-gallery" data-aos="fade-up">
  {%- if first_block -%}
    {%- render 'mobile-gallery-media', block: first_block, slot: 'one', modifier: 'full' -%}

    <div class="mobile-gallery__grid">
      {%- if first_block.settings.image_two != blank or first_block.settings.video_two != blank -%}
        {%- render 'mobile-gallery-media', block: first_block, slot: 'two' -%}
      {%- endif -%}

      {%- for block in image_blocks offset: 1 -%}
        {%- render 'mobile-gallery-media', block: block, slot: 'one' -%}

        {%- if block.settings.image_two != blank or block.settings.video_two != blank -%}
          {%- render 'mobile-gallery-media', block: block, slot: 'two' -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
