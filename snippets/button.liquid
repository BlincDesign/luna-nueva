{% doc %}
  Global button component. Renders an anchor styled from the theme's
  Buttons settings (Primary, Secondary, Link) via the .button / .button--{type}
  BEM classes defined in custom.css.

  @param {string} label - Button text
  @param {string} [url] - Link destination (required unless as: 'button')
  @param {string} [type] ('primary'|'secondary'|'link') - Visual style (default: 'primary')
  @param {string} [as] ('a'|'button') - HTML element to render (default: 'a')
  @param {string} [id] - Optional id attribute
  @param {string} [class] - Additional classes to append
  @param {string} [attributes] - Additional raw HTML attributes (e.g. data-* hooks)
  @param {boolean} [arrow] - Append an animated arrow after the label

  @example
  {% render 'button', label: 'Shop now', url: '/collections/all', type: 'primary', arrow: true %}
  {% render 'button', label: 'Yes', as: 'button', type: 'secondary', attributes: 'data-confirm-yes' %}
{% enddoc %}

{% liquid
  assign type = type | default: 'primary'
  assign as = as | default: 'a'
  assign classlist = 'button button--' | append: type
  if class != blank
    assign classlist = classlist | append: ' ' | append: class
  endif
%}

<{{ as }}
  {%- if id != blank %} id="{{ id }}"{% endif %}
  {%- if as == 'a' %} href="{{ url | default: '#' }}"{% endif %}
  {%- if as == 'button' %} type="button"{% endif %}
  class="{{ classlist }}"
  {%- if attributes != blank %} {{ attributes }}{% endif %}
>
  {{- label | escape -}}
  {%- if type == "primary" and arrow != false %}<span class="button__arrow">→</span>{% endif -%}
</{{ as }}>
