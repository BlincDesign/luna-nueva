{%- doc -%}

  @param block {object} An 'image' type block from section.blocks
  @param tile_width {number} Upper bound for the tile's rendered width (px)
  @param tile_width_mobile {number} Same, but for mobile

  @example
  {% render 'media-gallery-tile',
    block: block,
    tile_width: section.settings.tile_width_max,
    tile_width_mobile: section.settings.tile_width_mobile_max
  %}

{%- enddoc -%}

{%- assign tile_width_px = tile_width | append: 'px' -%}
{%- assign tile_width_mobile_px = tile_width_mobile | append: 'px' -%}

<div
  class="media-gallery__tile{% if block.settings.tall %} media-gallery__tile--tall{% endif %}"
  {{- block.shopify_attributes -}}
>
  {%- if block.settings.video_one != blank -%}
    <div class="media-gallery__image media-gallery__image--video">
      {%- render 'element.video',
        video: block.settings.video_one,
        autoplay: true,
        loop: true,
        muted: true,
        background: true
      -%}

      {%- if block.settings.image_one_caption != blank -%}
        <span class="media-gallery__caption">
          {{- block.settings.image_one_caption -}}
        </span>
      {%- endif -%}
    </div>

  {%- elsif block.settings.image_one != blank -%}
    <div class="media-gallery__image">
      {%- render 'image-element',
        img: block.settings.image_one,
        widths: '300, 400, 600, 800, 1000, 1200, 1600',
        sizeVariable: tile_width_px,
        fallback: tile_width_mobile_px,
        classes: 'media-gallery__image-img'
      -%}

      {%- if block.settings.image_one_caption != blank -%}
        <span class="media-gallery__caption">
          {{- block.settings.image_one_caption -}}
        </span>
      {%- endif -%}
    </div>

  {%- else -%}
    <div class="media-gallery__image media-gallery__image--placeholder">
      {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
    </div>
  {%- endif -%}

  {%- if block.settings.video_two != blank -%}
    <div class="media-gallery__image media-gallery__image--video">
      {%- render 'element.video',
        video: block.settings.video_two,
        autoplay: true,
        loop: true,
        muted: true,
        background: true
      -%}

      {%- if block.settings.image_two_caption != blank -%}
        <span class="media-gallery__caption">
          {{- block.settings.image_two_caption -}}
        </span>
      {%- endif -%}
    </div>

  {%- elsif block.settings.image_two != blank -%}
    <div class="media-gallery__image">
      {%- render 'image-element',
        img: block.settings.image_two,
        widths: '300, 400, 600, 800, 1000, 1200, 1600',
        sizeVariable: tile_width_px,
        fallback: tile_width_mobile_px,
        classes: 'media-gallery__image-img'
      -%}

      {%- if block.settings.image_two_caption != blank -%}
        <span class="media-gallery__caption">
          {{- block.settings.image_two_caption -}}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>