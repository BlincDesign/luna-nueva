{%- doc -%}
  Renders one media-gallery__tile. Used by both the grid and scrolling-row
  layout modes in sections/custom__media-gallery.liquid so tile markup
  isn't duplicated between the two.

  @param block {object} An 'image' type block from section.blocks
  @param layout_mode {string} 'grid' or 'scroll', used only to size the
    responsive image `sizes` attribute accurately
  @param card_width {number} section.settings.card_width (scroll mode)
  @param columns_desktop {number} section.settings.columns_desktop (grid mode)

  @example
  {% render 'media-gallery-tile', block: block, layout_mode: section.settings.layout_mode, card_width: section.settings.card_width, columns_desktop: section.settings.columns_desktop %}
{%- enddoc -%}

{%- liquid
  if layout_mode == 'scroll'
    assign tile_size = card_width | append: 'px'
  else
    assign tile_size = 100 | divided_by: columns_desktop | append: 'vw'
  endif

  if block.settings.tall
    assign image_size = tile_size
  else
    assign image_size = '50vw'
  endif
-%}

<div
  class="media-gallery__tile{% if block.settings.tall %} media-gallery__tile--wide{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="media-gallery__tile-media">
    {% if block.settings.image_one != blank %}
      <div class="media-gallery__image">
        {% render 'image-element',
          img: block.settings.image_one,
          widths: '400, 600, 800, 1000, 1200',
          sizeVariable: image_size,
          fallback: '90vw',
          classes: 'media-gallery__image-img'
        %}
        {% if block.settings.image_one_caption != blank %}
          <span class="media-gallery__caption">{{ block.settings.image_one_caption }}</span>
        {% endif %}
      </div>
    {% else %}
      <div class="media-gallery__image media-gallery__image--placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}

    {% if block.settings.image_two != blank %}
      <div class="media-gallery__image">
        {% render 'image-element',
          img: block.settings.image_two,
          widths: '400, 600, 800, 1000, 1200',
          sizeVariable: image_size,
          fallback: '90vw',
          classes: 'media-gallery__image-img'
        %}
        {% if block.settings.image_two_caption != blank %}
          <span class="media-gallery__caption">{{ block.settings.image_two_caption }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
