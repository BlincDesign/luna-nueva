{% style %}
  .scrolling-text--{{ section.id }} {
    --move-speed: {{ section.settings.speed }}s;
  }

  .scrolling-text--{{ section.id }} .text {
    font-size: {{ section.settings.text_size }}px;
  }

   .scrolling-text--{{ section.id }} .scrolling-text__icon {
    width: {{ section.settings.plus_icon_size }}px;
    height: {{ section.settings.plus_icon_size }}px;
    flex: 0 0 {{ section.settings.plus_icon_size }}px;
    display: inline-block;
  }

  .scrolling-text--{{ section.id }} .scrolling-text__icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .scrolling-text--{{ section.id }} .scrolling-text__inner {
      align-items: center;
  }

  {% if section.settings.color_scheme == 'button' %}
    .scrolling-text--{{ section.id }} {
      background: {{ settings.color_button }};
      color: {{ settings.color_button_text }};
    }
  {% endif %}
{% endstyle %}

<div class="scrolling-text scrolling-text--{{ section.id }}">
  <div
    class="scrolling-text__inner scrolling-text__inner--{{ section.settings.direction }}"
    aria-hidden="true"
    tabindex="0"
    style="gap: {% if section.settings.text_spacing %}40px{% else %}10px{% endif %};"
  >
    {% for i in (1..5) %}
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}

        <div class="text" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>

        {% if block.settings.link != blank %}
          </a>
        {% endif %}

        {% if section.settings.plus_icon != blank %}
          <div class="scrolling-text__icon">
            <img
              src="{{ section.settings.plus_icon | image_url: width: 100 }}"
              alt=""
              loading="lazy"
            >
          </div>
        {% endif %}

      {% endfor %}
    {% endfor %}
  </div>
</div>
