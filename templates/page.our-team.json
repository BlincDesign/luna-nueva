          }
        },
        "text_LbYVhx": {
          "type": "text",
          "settings": {
            "text": "<h4><em>Co-Founder & CEO</em></h4>",
            "enlarge_text": false,
            "subheading": false,
            "enable_italic": false,
            "enable_fade": true,
            "enable_primary_font": true,
