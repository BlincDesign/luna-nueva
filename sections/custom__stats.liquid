{% style %}
  #stats-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        text-align: left;
  }

  .stats-heading {
    margin: 0 0 8px;
  }

  .stats-text {
    margin: 0;
  }

  @media screen and (max-width: 1200px) {
    #stats-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

{% endstyle %}

    <section class="stats-section color-{{ section.settings.color_scheme }} 
        {% if section.settings.stylized_bg %} background-image{% endif %}
        {% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
        id="stats-{{ section.id }}">

        <div class="page-width">
            {% if section.blocks.size > 0 %}
            <div class="stats-grid">
                {% for block in section.blocks %}
                <div class="stats-item" {{ block.shopify_attributes }}>
                    
                    {% if block.settings.heading != blank %}
                    <h3 class="stats-heading">
                        {{ block.settings.heading }}
                    </h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                    <div class="stats-text">
                        {{ block.settings.text }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% endif %}

        </div>
    </section>

{% schema %}
{
  "name": "Stats",
  "class": "stats-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },  
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    }, 
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },

    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "100+"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Happy Customers</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}