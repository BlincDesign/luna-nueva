{% style %}
  #custom__image_slider_with_text-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .image-slider-text__content {
    flex: 0 0 40%;
    max-width: {{ section.settings.content_width }}px;
    padding: 30px 70px;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .image-slider-text__preheading {
    margin-bottom: 20px;
    font-size: var(--type-caption-size);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .2em;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading {
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(45, 49, 53, .24);
    padding-bottom: 44px;
    font-size: var(--type-h1-size);
    line-height: 1.06;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading * {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .image-slider-text__highlight {
    color: {{ section.settings.heading_highlight_color }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__text {
    margin-bottom: 35px;
    max-width: 400px;
    font-size: var(--type-body-lg-size);
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .image-slider-text__content .image-slider-text__text * {
    margin: 0 !important;
  }

  #shopify-section-{{ section.id }} .image-slider-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  /*
    IMPORTANT:
    min-width: 0 allows the flex item to properly shrink
    when the Shopify preview/editor width changes.
  */
  #shopify-section-{{ section.id }} .image-slider-text__slides {
    position: relative;
    overflow: hidden;
    flex: 1 1 60%;
    min-width: 0;
    width: 60%;
    box-sizing: border-box;
  }

  /*
    Make Flickity and its viewport use the actual
    available width of the flex container.
  */
  #shopify-section-{{ section.id }} .image-slider-text__slides .flickity-viewport {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides .flickity-slider {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide {
    position: relative;
    width: 100%;
    height: 90vh;
    min-width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .image-slider-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(.4, 0, .2, 1);
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide.is-selected .image-slider-text__image {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides .flickity-page-dots {
    bottom: 18px;
    left: 0;
    right: 0;
    width: max-content;
    margin-inline: auto;
    display: flex;
    gap: .55rem;
    justify-content: center;
    z-index: 3;
    padding: 17px 10px;
    border-radius: 50px;
    background: rgba(45, 49, 53, .42);
    backdrop-filter: blur(5px);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides .flickity-page-dots .dot {
    cursor: pointer;
    display: inline-block;
    height: 2px;
    margin: 0 5px;
    width: 26px;
    background: rgba(249, 246, 241, .55);
    transition: background .3s;
    border: 0;
    border-radius: 0;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides .flickity-page-dots .dot.is-selected {
    background-color: #F9F6F1;
  }


  /*
    TABLET / MOBILE
  */
  @media screen and (max-width: 1200px) {
    #custom__image_slider_with_text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__grid {
      flex-direction: column-reverse;
    }

    #shopify-section-{{ section.id }} .image-slider-text__slides {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__slide {
      height: 70vh;
      width: 100%;
      min-width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__content {
      width: 100%;
      max-width: 100%;
      flex: 0 0 100%;
    }
  }


  @media screen and (max-width: 589px) {
    #shopify-section-{{ section.id }} .image-slider-text__content {
      padding: 2.4rem 1.3rem;
    }
  }
{% endstyle %}


<div
  id="custom__image_slider_with_text-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} image-slider-text__grid{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  <div class="image-slider-text__content">

    {% if section.settings.preheading != blank %}
      <div class="image-slider-text__preheading">
        {{ section.settings.preheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      {% assign heading_parts = section.settings.heading | split: '||' %}

      <div class="image-slider-text__heading">
        {% for part in heading_parts %}
          {% if forloop.index0 == 0 or forloop.index0 == 2 or forloop.index0 == 4 %}
            {{ part }}
          {% else %}
            <span class="image-slider-text__highlight">{{ part }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="image-slider-text__text rte{% if section.settings.enlarge_text %} enlarge-text{% endif %}">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
      <div class="image-slider-text__buttons">

        {% if section.settings.button_1_label != blank %}
          {% render 'button',
            label: section.settings.button_1_label,
            type: section.settings.button_1_type,
            as: 'button',
            arrow: true
          %}
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          {% render 'button',
            label: section.settings.button_2_label,
            type: section.settings.button_2_type,
            as: 'button',
            arrow: false
          %}
        {% endif %}

      </div>
    {% endif %}

  </div>


  <div class="image-slider-text__slides">

    {% for block in section.blocks %}

      <div
        class="image-slider-text__slide"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}

          {% liquid
            assign img_loading = 'lazy'
            assign img_fetchpriority = null

            if forloop.first
              assign img_loading = 'eager'
              assign img_fetchpriority = 'high'
            endif
          %}

          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: img_loading,
              fetchpriority: img_fetchpriority,
              width: block.settings.image.width,
              height: block.settings.image.height,
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'image-slider-text__image',
              alt: block.settings.image.alt
          }}

        {% endif %}

      </div>

    {% endfor %}

  </div>
</div>


<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var sectionSelector = '#shopify-section-' + sectionId;
    var sliderSelector = sectionSelector + ' .image-slider-text__slides';

    var flkty = null;
    var resizeObserver = null;
    var resizeTimeout = null;


    /*
      Get slider element
    */
    function getSlider() {
      return document.querySelector(sliderSelector);
    }


    /*
      Resize Flickity safely
    */
    function resizeSlider() {
      if (!flkty) return;

      clearTimeout(resizeTimeout);

      resizeTimeout = setTimeout(function () {
        if (flkty && !flkty.isAnimating) {
          flkty.resize();
        }
      }, 50);
    }


    /*
      Initialize Flickity
    */
    function initSlider() {
      var sliderEl = getSlider();

      if (!sliderEl) return;


      /*
        If Flickity already exists, don't initialize it again.
      */
      if (flkty) {
        resizeSlider();
        return;
      }


      flkty = new Flickity(sliderEl, {
        cellAlign: 'left',
        contain: true,
        wrapAround: true,

        autoPlay: {% if section.settings.slider_autoplay_enabled %}{{ section.settings.slider_autoplay }}{% else %}false{% endif %},

        prevNextButtons: false,
        pageDots: true,

        fade: true,

        pauseAutoPlayOnHover: true,

        /*
          Important for dynamic Shopify editor resizing.
        */
        resize: true
      });


      /*
        Resize after images are loaded.
      */
      var images = sliderEl.querySelectorAll('.image-slider-text__image');

      images.forEach(function (img) {
        if (!img.complete) {
          img.addEventListener('load', function () {
            resizeSlider();
          });
        }
      });


      /*
        Watch the actual slider container.
        This is the important fix for Shopify's
        stretch / preview resizing.
      */
      if (window.ResizeObserver) {
        resizeObserver = new ResizeObserver(function () {
          resizeSlider();
        });

        resizeObserver.observe(sliderEl);
      }


      /*
        Initial resize after Flickity has calculated
        the dimensions.
      */
      setTimeout(function () {
        resizeSlider();
      }, 100);

      setTimeout(function () {
        resizeSlider();
      }, 500);
    }


    /*
      Destroy Flickity
    */
    function destroySlider() {

      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }

      if (resizeTimeout) {
        clearTimeout(resizeTimeout);
        resizeTimeout = null;
      }

      if (flkty) {
        flkty.destroy();
        flkty = null;
      }
    }


    /*
      Browser resize
    */
    window.addEventListener('resize', function () {
      resizeSlider();
    });


    /*
      Initial load
    */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        initSlider();
      });
    } else {
      initSlider();
    }


    /*
      Shopify Theme Editor
    */
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === sectionId) {
        destroySlider();

        setTimeout(function () {
          initSlider();
        }, 50);
      }
    });


    /*
      Section unloaded
    */
    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId === sectionId) {
        destroySlider();
      }
    });


    /*
      Section selected in Theme Editor
    */
    document.addEventListener('shopify:section:select', function (event) {
      if (event.detail.sectionId === sectionId) {
        if (!flkty) {
          initSlider();
        } else {
          setTimeout(function () {
            resizeSlider();
          }, 50);
        }
      }
    });


    /*
      Section deselected
    */
    document.addEventListener('shopify:section:deselect', function (event) {
      if (event.detail.sectionId === sectionId) {
        resizeSlider();
      }
    });

  })();
</script>


{% schema %}
{
  "name": "Image slider with text",
  "tag": "section",
  "class": "section-image-slider-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_autoplay",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Discover more"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Image slider with text</p>"
    },
    {
      "type": "checkbox",
      "id": "enlarge_text",
      "label": "Enlarge text",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_1_type",
      "label": "Button style",
      "default": "secondary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },

    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_2_type",
      "label": "Button style",
      "default": "link",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Image slider with text",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
