{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .button.button--primary {
    --btn-bg: #2D3135;
    --btn-border: #2D3135;
    --btn-color: #fff;
    --btn-hover-bg: #2D3135;
    --btn-hover-border: #2D3135;
    --btn-hover-color: #fff;
  }


  #shopify-section-{{ section.id }} .button.button--secondary {
    --btn-bg: transparent;
    --btn-border: #2D3135;
    --btn-color: #2D3135;
    --btn-hover-bg: #2D3135;
    --btn-hover-border: #2D3135;
    --btn-hover-color: #fff;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .image-slider-text__content {
    flex: 0 0 40%;
    max-width: {{ section.settings.content_width }}px;
    padding: 55px 70px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__preheading {
    margin-bottom: 20px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .2em; 
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading {
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(45, 49, 53, .24);
    padding-bottom: 44px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading h2 {
    font-size: 70px;
    line-height: 1.06;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading * {
      margin: 0;
  }

  #shopify-section-{{ section.id }} .image-slider-text__highlight {
      color: {{ section.settings.heading_highlight_color }};
    }

  #shopify-section-{{ section.id }} .image-slider-text__text {
    margin-bottom: 35px;
    max-width: 400px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__text h5 {
    font-size: 20px;
    line-height: 1.6;
  }

    #shopify-section-{{ section.id }} .image-slider-text__content  .image-slider-text__text * {
        margin: 0 !important;
    }

  #shopify-section-{{ section.id }} .image-slider-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides {
    position: relative;
    overflow: hidden;
    flex: 0 0 60%;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide {
    width: 100%;
    height: 90vh;
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .image-slider-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(.4, 0, .2, 1);
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide.is-selected .image-slider-text__image {
    opacity: 1;
  }

  .image-slider-text__slides .flickity-page-dots {
      bottom: 18px;
      left: 0;
      right: 0;
      width: max-content;
      margin-inline: auto;
      display: flex;
      gap: .55rem;
      justify-content: center;
      z-index: 3;
      padding: 17px 10px;
      border-radius: 50px;
      background: rgba(45, 49, 53, .42);
      backdrop-filter: blur(5px);
  }

  .image-slider-text__slides .flickity-page-dots .dot {
    cursor: pointer;
    display: inline-block;
    height: 2px;
    margin: 0 5px;
    width: 26px;
    background: rgba(249, 246, 241, .55);
    transition: background .3s;
    border: 0;
    border-radius: 0;
}

.image-slider-text__slides .flickity-page-dots .dot.is-selected {
    background-color: #F9F6F1;
}


  @media screen and (max-width: 1200px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__slide {
    height: 80vh;
  }

    #shopify-section-{{ section.id }} .image-slider-text__slides {
      flex: 0 0 100%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__grid {
      flex-direction: column-reverse;
    }

    #shopify-section-{{ section.id }} .image-slider-text__content {
      width: 100%;
      max-width: 100%;
      flex: 0 0 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__heading {
      font-size: 40px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__text {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .image-slider-text__heading h2 {
      font-size: 44px;
      line-height: 1.06;
    }
  }

  @media screen and (max-width: 425px) {
    #shopify-section-{{ section.id }} .image-slider-text__content {
        padding: 55px 20px;
    }
  }


{% endstyle %}

<div class="image-slider-text__grid">
  <div class="image-slider-text__content">
    {% if section.settings.preheading != blank %}
      <div class="image-slider-text__preheading">
        {{ section.settings.preheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      {% assign heading_parts = section.settings.heading | split: '||' %}

      <div class="image-slider-text__heading">
        {% for part in heading_parts %}
          {% if forloop.index0 == 0 or forloop.index0 == 2 or forloop.index0 == 4 %}
            {{ part }}
          {% else %}
            <span class="image-slider-text__highlight">{{ part }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="image-slider-text__text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% comment %} {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
      <div class="image-slider-text__buttons">
        {% if section.settings.button_1_label != blank %}
          <a
            href="{{ section.settings.button_1_link }}"
            class="image-slider-text__button image-slider-text__button--primary"
          >
            {{ section.settings.button_1_label }}
          </a>
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          <a
            href="{{ section.settings.button_2_link }}"
            class="image-slider-text__button image-slider-text__button--secondary"
          >
            {{ section.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %} {% endcomment %}


    {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
    <div class="image-slider-text__buttons">
      {% if section.settings.button_1_label != blank %}
        {% render 'button',
          label: section.settings.button_1_label,
          type: section.settings.button_1_type,
          as: 'button',
          arrow: true
        %}
      {% endif %}

      {% if section.settings.button_2_label != blank %}
        {% render 'button',
          label: section.settings.button_2_label,
          type: section.settings.button_2_type,
          as: 'button',
          arrow: false
        %}
      {% endif %}
    </div>
  {% endif %}


  </div>

  <div class="image-slider-text__slides">
    {% for block in section.blocks %}
      <div
        class="image-slider-text__slide"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {% liquid
            assign img_loading = 'lazy'
            assign img_fetchpriority = nil
            if forloop.first
              assign img_loading = 'eager'
              assign img_fetchpriority = 'high'
            endif
          %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: img_loading,
              fetchpriority: img_fetchpriority,
              width: block.settings.image.width,
              height: block.settings.image.height,
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'image-slider-text__image',
              alt: block.settings.image.alt
          }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderEl = document.querySelector('#shopify-section-{{ section.id }} .image-slider-text__slides');

    if (!sliderEl) return;

    var flkty = new Flickity(sliderEl, {
      cellAlign: 'left',
      contain: true,
      wrapAround: true,
      autoPlay: {% if section.settings.slider_autoplay_enabled %}{{ section.settings.slider_autoplay }}{% else %}false{% endif %},
      prevNextButtons: false,
      pageDots: true,
      fade: true,
      pauseAutoPlayOnHover: true
    });

    var images = sliderEl.querySelectorAll('.image-slider-text__image');
    images.forEach(function (img) {
      if (!img.complete) {
        img.addEventListener('load', function () {
          flkty.resize();
        });
      }
    });
  });
</script>



{% schema %}
{
  "name": "Image slider with text",
  "tag": "section",
  "class": "section-image-slider-text background-image",
  "settings": [
    {
      "type": "checkbox",
      "id": "slider_autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_autoplay",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Discover more"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Image slider with text</p>"
    },
    {
      "type": "color",
      "id": "heading_highlight_color",
      "label": "Heading highlight color",
      "default": "#C89B6D",
      "info": "Add || before and after text in the heading to apply the highlight color. Example: New collection ||is here||"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_1_type",
      "label": "Button style",
      "default": "secondary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_2_type",
      "label": "Button style",
      "default": "link",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }

  ],

  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Image slider with text",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
