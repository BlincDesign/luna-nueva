{% style %}
  #custom__image_slider_with_text-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid .image-slider-text__content {
    flex: 0 0 40%;
    max-width: {{ section.settings.content_width }}px;
    padding: 30px 70px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__preheading {
    margin-bottom: 20px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading {
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(45, 49, 53, .24);
    padding-bottom: 44px;
    font-size: var(--type-h1-size);
    line-height: 1.06;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading * {
      margin: 0;
  }

  #shopify-section-{{ section.id }} .image-slider-text__highlight {
      color: {{ section.settings.heading_highlight_color }};
    }

  #shopify-section-{{ section.id }} .image-slider-text__text {
    margin-bottom: 35px;
    max-width: 400px;
    font-size: var(--type-body-lg-size);
    line-height: 1.6;
  }

    #shopify-section-{{ section.id }} .image-slider-text__content  .image-slider-text__text * {
        margin: 0 !important;
    }

  #shopify-section-{{ section.id }} .image-slider-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 14px;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides {
  position: relative;
  overflow: hidden;
  flex: 1 1 0;
  min-width: 0;
  width: 100%;
}

  #shopify-section-{{ section.id }} .image-slider-text__slide {
    width: 100%;
    height: 90vh;
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .image-slider-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(.4, 0, .2, 1);
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide.is-selected .image-slider-text__image {
    opacity: 1;
  }

  .image-slider-text__slides .flickity-page-dots {
    bottom: 18px;
    left: 0;
    right: 0;
    width: max-content;
    margin-inline: auto;
    display: flex;
    gap: .55rem;
    justify-content: center;
    z-index: 3;
    padding: 17px 10px;
    border-radius: 50px;
    background: rgba(45, 49, 53, .42);
    backdrop-filter: blur(5px);
  }

  .image-slider-text__slides .flickity-page-dots .dot {
    cursor: pointer;
    display: inline-block;
    height: 2px;
    margin: 0 5px;
    width: 26px;
    background: rgba(249, 246, 241, .55);
    transition: background .3s;
    border: 0;
    border-radius: 0;
  }

  .image-slider-text__slides .flickity-page-dots .dot.is-selected {
    background-color: #F9F6F1;
  }

  .image-slider-text__content .enlarge-text *{
    font-size: 20px;
  }

  #shopify-section-{{ section.id }} .text--faded {
    opacity: 0.84;
  }


  @media screen and (max-width: 1200px) {
    #custom__image_slider_with_text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__slide {
      height: 70vh;
    }

    #shopify-section-{{ section.id }} .image-slider-text__slides {
      flex: 0 0 100%;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__grid {
      flex-direction: column-reverse;
    }

    .image-slider-text__grid .image-slider-text__content {
      width: 100%;
      max-width: 100%;
      flex: 0 0 100%;
    }
  }

  @media screen and (max-width: 589px) {
    #shopify-section-{{ section.id }}  .image-slider-text__grid .image-slider-text__content {
        padding: 2.4rem 1.3rem;
    }
  }
{% endstyle %}

<div
  id="custom__image_slider_with_text-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} image-slider-text__grid{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  <div class="image-slider-text__content">
    {% if section.settings.preheading != blank %}
      <div class="image-slider-text__preheading subheading {% if section.settings.preheading_fade %}text--faded{% endif %}">
        {{ section.settings.preheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      {% assign heading_parts = section.settings.heading | split: '||' %}

      <div class="image-slider-text__heading">
        {% for part in heading_parts %}
          {% if forloop.index0 == 0 or forloop.index0 == 2 or forloop.index0 == 4 %}
            {{ part }}
          {% else %}
            <span class="image-slider-text__highlight">{{ part }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

   {% if section.settings.text != blank %}

  <div class="image-slider-text__text has-primary--font rte{% if section.settings.enlarge_text %} enlarge-text{% endif %} {% if section.settings.description_fade %}text--faded{% endif %}">

    {{ section.settings.text }}

  </div>
{% endif %}

    {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
      <div class="image-slider-text__buttons">
        {% if section.settings.button_1_label != blank %}
          {% render 'button',
            label: section.settings.button_1_label,
            type: section.settings.button_1_type,
            url: section.settings.button_1_link,
            as: 'a',
            arrow: true
          %}
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          {% render 'button',
            label: section.settings.button_2_label,
            type: section.settings.button_2_type,
            url: section.settings.button_2_link,
            as: 'a',
            arrow: false
          %}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="image-slider-text__slides">
    {% for block in section.blocks %}
      <div
        class="image-slider-text__slide"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {% liquid
            assign img_loading = 'lazy'
            assign img_fetchpriority = null
            if forloop.first
              assign img_loading = 'eager'
              assign img_fetchpriority = 'high'
            endif
          %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: img_loading,
              fetchpriority: img_fetchpriority,
              width: block.settings.image.width,
              height: block.settings.image.height,
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'image-slider-text__image',
              alt: block.settings.image.alt
          }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function () {
    var sectionId = 'shopify-section-{{ section.id }}';
    var sliderSelector = '#' + sectionId + ' .image-slider-text__slides';
    var flkty = null;
    var resizeTimer = null;

    function getSlider() {
      return document.querySelector(sliderSelector);
    }

    function destroySlider() {
      if (!flkty) return;

      flkty.destroy();
      flkty = null;
    }

    function initSlider() {
      var sliderEl = getSlider();

      if (!sliderEl || typeof Flickity === 'undefined') return;

      destroySlider();

      flkty = new Flickity(sliderEl, {
        cellAlign: 'left',
        contain: true,
        wrapAround: true,
        autoPlay: {% if section.settings.slider_autoplay_enabled %}{{ section.settings.slider_autoplay }}{% else %}false{% endif %},
        prevNextButtons: false,
        pageDots: true,
        fade: true,
        pauseAutoPlayOnHover: true
      });

      sliderEl.querySelectorAll('.image-slider-text__image').forEach(function (image) {
        if (!image.complete) {
          image.addEventListener('load', function () {
            if (flkty) {
              flkty.resize();
            }
          }, { once: true });
        }
      });
    }

    function resizeSlider() {
      clearTimeout(resizeTimer);

      resizeTimer = setTimeout(function () {
        if (flkty) {
          flkty.resize();
        } else {
          initSlider();
        }
      }, 100);
    }

    function handleSectionLoad(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initSlider();
      }
    }

    function handleSectionUnload(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        destroySlider();
      }
    }

    function handleSectionSelect(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        resizeSlider();
      }
    }

    function init() {
      initSlider();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }

    window.addEventListener('load', init);
    window.addEventListener('resize', resizeSlider);

    document.addEventListener('shopify:section:load', handleSectionLoad);
    document.addEventListener('shopify:section:unload', handleSectionUnload);
    document.addEventListener('shopify:section:select', handleSectionSelect);
  })();
</script>


{% schema %}
{
  "name": "Image slider with text",
  "tag": "section",
  "class": "section-image-slider-text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_autoplay",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Discover more"
    },
    {
      "type": "checkbox",
      "id": "preheading_fade",
      "label": "Lighten text",
      "default": false
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Image slider with text</p>"
    },
    {
      "type": "checkbox",
      "id": "enlarge_text",
      "label": "Enlarge text",
      "default": false
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "checkbox",
      "id": "description_fade",
      "label": "Lighten text",
      "default": false
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_1_type",
      "label": "Button style",
      "default": "secondary",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },

    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_2_type",
      "label": "Button style",
      "default": "link",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "link", "label": "Link" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Image slider with text",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
