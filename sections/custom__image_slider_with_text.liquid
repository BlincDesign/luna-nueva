{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid {
    display: grid;
    grid-template-columns: 38.77fr 61.23fr;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .image-slider-text__content {
    max-width: {{ section.settings.content_width }}px;
    padding: 55px 70px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__preheading {
    margin-bottom: 20px;
    font-size: {{ section.settings.preheading_size }}px;
    {% if section.settings.custom_preheading_font != blank %}
      font-family: '{{ section.settings.custom_preheading_font }}', sans-serif;
    {% else %}
      font-family: {{ section.settings.preheading_font.family }}, {{ section.settings.preheading_font.fallback_families }};
    {% endif %}
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.preheading_color }};
    letter-spacing: .2em; 
    opacity: 0.84;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading {
    margin-bottom: 40px;
    {% if section.settings.custom_heading_font != blank %}
      font-family: '{{ section.settings.custom_heading_font }}', sans-serif;
    {% else %}
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    {% endif %}
    color: {{ section.settings.heading_color }};
    border-bottom: 1px solid rgba(45, 49, 53, .24);
    padding-bottom: 44px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading h2 {
    font-size: {{ section.settings.heading_size }}px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading * {
      margin: 0;
  }

  #shopify-section-{{ section.id }} .image-slider-text__highlight {
      color: {{ section.settings.heading_highlight_color }};
    }

  #shopify-section-{{ section.id }} .image-slider-text__text {
    margin-bottom: 35px;
    {% if section.settings.custom_text_font != blank %}
    font-family: '{{ section.settings.custom_text_font }}', sans-serif;
  {% else %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
  {% endif %}
    font-weight: normal;
    color: {{ section.settings.text_color }};
    opacity: 0.84;
    max-width: 400px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__text h5 {
    font-size: {{ section.settings.text_size }}px;
  }

    #shopify-section-{{ section.id }} .image-slider-text__content  .image-slider-text__text * {
        margin: 0 !important;
    }

  #shopify-section-{{ section.id }} .image-slider-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px;
    font-size: {{ section.settings.button_font_size }}px;
    font-style: {{ section.settings.button_font.style }};
    font-weight: {{ section.settings.button_font.weight }};
    line-height: 1;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .image-slider-text__button--primary {
    background-color: {{ section.settings.button_1_background }};
    color: {{ section.settings.button_1_text_color }};
    border: 1px solid {{ section.settings.button_1_background }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__button--secondary {
    background-color: {{ section.settings.button_2_background }};
    color: {{ section.settings.button_2_text_color }};
    border: 1px solid {{ section.settings.button_2_border_color }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__slides {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide {
    width: 100%;
    height: 90vh;
    aspect-ratio: 1;
  }

  #shopify-section-{{ section.id }} .image-slider-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(.4, 0, .2, 1);
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide.is-selected .image-slider-text__image {
    opacity: 1;
  }

  .image-slider-text__slides .flickity-page-dots {
      bottom: 18px;
      left: 0;
      right: 0;
      width: max-content;
      margin-inline: auto;
      display: flex;
      gap: .55rem;
      justify-content: center;
      z-index: 3;
      padding: 17px 10px;
      border-radius: 50px;
      background: rgba(45, 49, 53, .42);
      backdrop-filter: blur(5px);
  }

  .image-slider-text__slides .flickity-page-dots .dot {
    cursor: pointer;
    display: inline-block;
    height: 2px;
    margin: 0 5px;
    width: 26px;
    background: rgba(249, 246, 241, .55);
    transition: background .3s;
    border: 0;
    border-radius: 0;
}

.image-slider-text__slides .flickity-page-dots .dot.is-selected {
    background-color: #F9F6F1;
}


  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .image-slider-text__content {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__preheading {
      font-size: {{ section.settings.mobile_preheading_size }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="image-slider-text__grid">
  <div class="image-slider-text__content">
    {% if section.settings.preheading != blank %}
      <div class="image-slider-text__preheading">
        {{ section.settings.preheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      {% assign heading_parts = section.settings.heading | split: '||' %}

      <div class="image-slider-text__heading">
        {% for part in heading_parts %}
          {% if forloop.index0 == 0 or forloop.index0 == 2 or forloop.index0 == 4 %}
            {{ part }}
          {% else %}
            <span class="image-slider-text__highlight">{{ part }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="image-slider-text__text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
      <div class="image-slider-text__buttons">
        {% if section.settings.button_1_label != blank %}
          <a
            href="{{ section.settings.button_1_link }}"
            class="image-slider-text__button image-slider-text__button--primary"
          >
            {{ section.settings.button_1_label }}
          </a>
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          <a
            href="{{ section.settings.button_2_link }}"
            class="image-slider-text__button image-slider-text__button--secondary"
          >
            {{ section.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="image-slider-text__slides">
    {% for block in section.blocks %}
      <div
        class="image-slider-text__slide"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {% liquid
            assign img_loading = 'lazy'
            assign img_fetchpriority = nil
            if forloop.first
              assign img_loading = 'eager'
              assign img_fetchpriority = 'high'
            endif
          %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: img_loading,
              fetchpriority: img_fetchpriority,
              width: block.settings.image.width,
              height: block.settings.image.height,
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'image-slider-text__image',
              alt: block.settings.image.alt
          }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderEl = document.querySelector('#shopify-section-{{ section.id }} .image-slider-text__slides');

    if (!sliderEl) return;

    var flkty = new Flickity(sliderEl, {
      cellAlign: 'left',
      contain: true,
      wrapAround: true,
      autoPlay: {% if section.settings.slider_autoplay_enabled %}{{ section.settings.slider_autoplay }}{% else %}false{% endif %},
      prevNextButtons: false,
      pageDots: true,
      fade: true,
      pauseAutoPlayOnHover: true
    });

    var images = sliderEl.querySelectorAll('.image-slider-text__image');
    images.forEach(function (img) {
      if (!img.complete) {
        img.addEventListener('load', function () {
          flkty.resize();
        });
      }
    });
  });
</script>



{% schema %}
{
  "name": "Image slider with text",
  "tag": "section",
  "class": "section-image-slider-text background-image",
  "settings": [
    {
      "type": "checkbox",
      "id": "slider_autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_autoplay",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Discover more"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Image slider with text</p>"
    },
    {
      "type": "color",
      "id": "heading_highlight_color",
      "label": "Heading highlight color",
      "default": "#C89B6D",
      "info": "Add || before and after text in the heading to apply the highlight color. Example: New collection ||is here||"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },

    {
      "type": "header",
      "content": "Font family"
    },
    {
      "type": "text",
      "id": "custom_preheading_font",
      "label": "Custom preheading font",
      "info": "Enter the font file name. This overrides the preheading font selectors."
    },
    {
      "type": "font_picker",
      "id": "preheading_font",
      "label": "Preheading font",
      "default": "assistant_n4"
    },
    {
      "type": "text",
      "id": "custom_heading_font",
      "label": "Custom heading font",
      "info": "Enter the font file name. This overrides the heading font selectors."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "text",
      "id": "custom_text_font",
      "label": "Custom text font",
      "info": "Enter the font file name. This overrides the text font selectors."
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "preheading_size",
      "label": "Preheading size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Text color"
    },
    {
      "type": "color",
      "id": "preheading_color",
      "label": "Preheading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Mobile font size"
    },
    {
      "type": "range",
      "id": "mobile_preheading_size",
      "label": "Mobile preheading size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
