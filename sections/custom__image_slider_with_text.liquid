{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__grid {
    display: grid;
    grid-template-columns: 38.77fr 61.23fr;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .image-slider-text__content {
    max-width: {{ section.settings.content_width }}px;
    padding: 55px 70px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__preheading {
    margin: 0 0 {{ section.settings.preheading_margin }}px;
    font-size: {{ section.settings.preheading_size }}px;
    font-family: {{ section.settings.preheading_font.family }}, {{ section.settings.preheading_font.fallback_families }};
    font-style: {{ section.settings.preheading_font.style }};
    font-weight: {{ section.settings.preheading_font.weight }};
    line-height: 1.2;
    color: {{ section.settings.preheading_color }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__heading {
    margin: 0 0 {{ section.settings.heading_margin }}px;
    font-size: {{ section.settings.heading_size }}px;
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};
    line-height: {{ section.settings.heading_line_height }};
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__text {
    margin: 0 0 {{ section.settings.text_margin }}px;
    font-size: {{ section.settings.text_size }}px;
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-style: {{ section.settings.text_font.style }};
    font-weight: {{ section.settings.text_font.weight }};
    line-height: {{ section.settings.text_line_height }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 10px;
    font-size: {{ section.settings.button_font_size }}px;
    font-style: {{ section.settings.button_font.style }};
    font-weight: {{ section.settings.button_font.weight }};
    line-height: 1;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .image-slider-text__button--primary {
    background-color: {{ section.settings.button_1_background }};
    color: {{ section.settings.button_1_text_color }};
    border: 1px solid {{ section.settings.button_1_background }};
  }

  #shopify-section-{{ section.id }} .image-slider-text__button--secondary {
    background-color: {{ section.settings.button_2_background }};
    color: {{ section.settings.button_2_text_color }};
    border: 1px solid {{ section.settings.button_2_border_color }};
  }

  /*
    Crossfade slider — no Flickity. Slides stack via position:absolute and
    fade between each other on an "is-active" class. A small vanilla JS
    controller toggles that class (autoplay + click-to-jump on dots).
  */

  #shopify-section-{{ section.id }} .image-slider-text__slides {
    position: relative;
    overflow: hidden;
    height: 90vh;
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 0;
    transition: opacity 1.5s cubic-bezier(.4, 0, .2, 1);
  }

  #shopify-section-{{ section.id }} .image-slider-text__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .image-slider-text__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .image-slider-text__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .image-slider-text__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .image-slider-text__dot.is-active {
    background-color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .image-slider-text__content {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .image-slider-text__preheading {
      font-size: {{ section.settings.mobile_preheading_size }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .image-slider-text__text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="image-slider-text__grid">
  <div class="image-slider-text__content">
    {% if section.settings.preheading != blank %}
      <div class="image-slider-text__preheading">
        {{ section.settings.preheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="image-slider-text__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="image-slider-text__text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
      <div class="image-slider-text__buttons">
        {% if section.settings.button_1_label != blank %}
          <a
            href="{{ section.settings.button_1_link }}"
            class="image-slider-text__button image-slider-text__button--primary"
          >
            {{ section.settings.button_1_label }}
          </a>
        {% endif %}

        {% if section.settings.button_2_label != blank %}
          <a
            href="{{ section.settings.button_2_link }}"
            class="image-slider-text__button image-slider-text__button--secondary"
          >
            {{ section.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div
    class="image-slider-text__slides"
    data-autoplay-enabled="{{ section.settings.slider_autoplay_enabled }}"
    data-autoplay-speed="{{ section.settings.slider_autoplay }}"
  >
    {% for block in section.blocks %}
      <div
        class="image-slider-text__slide{% if forloop.first %} is-active{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {% liquid
            assign img_loading = 'lazy'
            assign img_fetchpriority = nil
            if forloop.first
              assign img_loading = 'eager'
              assign img_fetchpriority = 'high'
            endif
          %}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: img_loading,
              fetchpriority: img_fetchpriority,
              width: block.settings.image.width,
              height: block.settings.image.height,
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'image-slider-text__image',
              alt: block.settings.image.alt
          }}
        {% endif %}
      </div>
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <div class="image-slider-text__dots" role="tablist" aria-label="Slides">
        {% for block in section.blocks %}
          <button
            type="button"
            class="image-slider-text__dot{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sliderEl = document.querySelector(
      '#shopify-section-{{ section.id }} .image-slider-text__slides'
    );
    if (!sliderEl) return;

    var slides = sliderEl.querySelectorAll('.image-slider-text__slide');
    var dots = sliderEl.querySelectorAll('.image-slider-text__dot');

    if (slides.length <= 1) return;

    var autoplayEnabled = sliderEl.dataset.autoplayEnabled === 'true';
    var autoplaySpeed = parseInt(sliderEl.dataset.autoplaySpeed, 10) || 4000;
    var current = 0;
    var timer = null;

    function goTo(index) {
      if (index === current) return;

      slides[current].classList.remove('is-active');
      if (dots[current]) {
        dots[current].classList.remove('is-active');
        dots[current].setAttribute('aria-selected', 'false');
      }

      current = index;

      slides[current].classList.add('is-active');
      if (dots[current]) {
        dots[current].classList.add('is-active');
        dots[current].setAttribute('aria-selected', 'true');
      }
    }

    function next() {
      goTo((current + 1) % slides.length);
    }

    function startAutoplay() {
      if (!autoplayEnabled) return;
      stopAutoplay();
      timer = setInterval(next, autoplaySpeed);
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () {
        goTo(index);
        startAutoplay();
      });
    });

    sliderEl.addEventListener('mouseenter', stopAutoplay);
    sliderEl.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  });
</script>

{% schema %}
{
  "name": "Image slider with text",
  "tag": "section",
  "class": "section-image-slider-text",
  "settings": [
    {
      "type": "checkbox",
      "id": "slider_autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "slider_autoplay",
      "label": "Autoplay speed",
      "min": 1000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Discover more"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Image slider with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description here.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },

    {
      "type": "header",
      "content": "Font family"
    },
    {
      "type": "font_picker",
      "id": "preheading_font",
      "label": "Preheading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "assistant_n4"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Text font",
      "default": "assistant_n4"
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "preheading_size",
      "label": "Preheading size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height",
      "min": 0.8,
      "max": 2,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Text line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },

