    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15
    },

    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "button_1_background",
      "label": "Button 1 background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Button 1 text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_2_background",
      "label": "Button 2 background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Button 2 text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_2_border_color",
      "label": "Button 2 border color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
