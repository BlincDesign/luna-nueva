{% style %}
  .heading-with-mail {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-bottom: 40px;
    }

    .heading-with-mail .section-header {
        flex: 0 0 60%;
        margin: 0;
    }

    .heading-with-mail .email-wrapper {
        flex: 0 0 40%;
        text-align: right;
    }

    .form-vertical .input-full {
        min-height: 52px;
        padding: .92rem 1.05rem;
        border-radius: 10px;
        border-color: rgba(249,246,241,.22);
        background: rgba(249, 246, 241, .05);
    }

    .form-vertical input:active,.form-vertical input:focus,.form-vertical select:active,.form-vertical select:focus,.form-vertical textarea:active,.form-vertical textarea:focus {
        outline: 2px solid #fff !important;
        outline-offset: 3px;
        border-color: rgba(249,246,241,.22);
    }

    .form-vertical label {
        text-transform: uppercase !important;
    }

    .form-vertical {
        max-width: 760px;
    }

    .form-vertical .button-submit {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 20px;
    }

    .form-vertical .button-submit .btn {
        margin: 0 !important;
    }


{% endstyle %}

<div class="index-section color-{{ section.settings.color_scheme }}">
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    <div class="heading-with-mail">
      {%- if section.settings.title != blank
        or section.settings.text != blank
        or section.settings.pre_title != blank
      -%}
        <div class="section-header">
          {%- if section.settings.pre_title != blank -%}
            <p class="section-header__title">
              {{ section.settings.pre_title }}
            </p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="section-header__title">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="rte section-header__rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="email-wrapper">
        {% if section.settings.email_heading != blank %}
          <p>{{ section.settings.email_heading }}</p>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="mail">
            <a href="mailto:{{ section.settings.email }}">
              {{ section.settings.email }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="form-vertical">
      {%- assign form_id = 'contact-' | append: section.id -%}

      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <div class="grid grid--small">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'name' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormName-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="text"
                    id="ContactFormName-{{ section.id }}"
                    class="input-full"
                    name="contact[name]"
                    autocapitalize="words"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'text' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormText-{{ block.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="text"
                    id="ContactFormText-{{ block.id }}"
                    class="input-full"
                    name="contact[{{ block.settings.label | handleize }}]"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'email' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormEmail-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="email"
                    id="ContactFormEmail-{{ section.id }}"
                    class="input-full"
                    name="contact[email]"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'phone' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormPhone-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="tel"
                    id="ContactFormPhone-{{ section.id }}"
                    class="input-full"
                    name="contact[phone]"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'message' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormMessage-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <textarea
                    rows="{{ block.settings.rows }}"
                    id="ContactFormMessage-{{ section.id }}"
                    class="input-full"
                    name="contact[body]"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >{% if form.body %}{{ form.body }}{% endif %}</textarea>
                </div>

              {%- when 'dropdown' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormDropdown-{{ block.id }}">
                    {{ block.settings.label }}
                  </label>

                  <select
                    id="ContactFormDropdown-{{ block.id }}"
                    class="input-full"
                    name="contact[{{ block.settings.label | handleize }}]"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                    {%- if block.settings.placeholder != blank -%}
                      <option value="" disabled selected>
                        {{ block.settings.placeholder }}
                      </option>
                    {%- endif -%}

                    {%- assign dropdown_options = block.settings.options | newline_to_br | split: '<br />' -%}

                    {%- for option in dropdown_options -%}
                      {%- assign option_clean = option | strip -%}

                      {%- if option_clean != blank -%}
                        <option value="{{ option_clean | escape }}">
                          {{ option_clean }}
                        </option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>

              {%- when 'submit' -%}
                <div
                  class="grid__item one-whole button-submit"
                  {{ block.shopify_attributes }}
                >
                  <label
                    for="contact-form-submit-{{ section.id }}"
                    class="hidden-label"
                  >
                    {{ block.settings.label }}
                  </label>

                  <button
                    type="submit"
                    id="contact-form-submit-{{ section.id }}"
                    class="btn"
                  >
                    {{ block.settings.label }}
                  </button>

                  {%- if block.settings.info != blank -%}
                  <div class="button-info">
                    {{ block.settings.info }}
                  </div>
                {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {% comment %}
          Remove the following three lines of code to remove the note
          about being protected by Google's reCAPTCHA service.
          By removing it, the small reCAPTCHA widget will appear in the
          bottom right corner of the page.
        {% endcomment %}
        {% if section.settings.show_hCaptcha_text %} 
        {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
        {% endif %}

      {%- endform -%}
    </div>
  </div>
</div>

