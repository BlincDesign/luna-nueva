{% comment %} {% style %}
  #shopify-section-{{ section.id }} .age-confirmation {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    height: 100vh;
    z-index: 100;
  }

  #shopify-section-{{ section.id }} .age-confirmation .modal__inner {
    background-color: transparent;
  }

  #shopify-section-{{ section.id }} .age-confirmation.modal--square .modal__centered-content {
    background-color: transparent;
  }

  #shopify-section-{{ section.id }} .age-confirmation__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .age-confirmation__logo img {
    display: block;
    width: 100%;
    max-width: 220px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .age-confirmation__heading {
    margin: 0;
    font-family: var(--typeHeaderPrimary), var(--typeHeaderFallback);
    font-size: 34px;
    line-height: 1.2;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .age-confirmation__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .age-confirmation__button {
    display: inline-block;
    min-width: 140px;
    padding: 14px 32px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .age-confirmation__button--yes {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .age-confirmation__button--no {
    background: none;
    color: inherit;
  }

  #shopify-section-{{ section.id }} .age-confirmation__error {
    margin: 0;
    font-size: 13px;
    color: #e8635a;
  }

  #shopify-section-{{ section.id }} .age-confirmation__text {
    margin: 0;
    max-width: 420px;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.7;
  }

  @media only screen and (max-width: 589px) {
    #shopify-section-{{ section.id }} .age-confirmation__heading {
      font-size: 26px;
    }

    #shopify-section-{{ section.id }} .age-confirmation__button {
      min-width: 0;
      flex: 1 1 auto;
    }
  }
{% endstyle %} {% endcomment %}

<div
  id="AgeConfirmation-{{ section.id }}"
  class="age-confirmation modal modal--square modal--mobile-friendly background-image"
  role="dialog"
  aria-modal="true"
  {% if section.settings.heading != blank %}
    aria-labelledby="AgeConfirmationHeading-{{ section.id }}"
  {% endif %}
>
  <div class="modal__inner" data-nosnippet>
    <div class="modal__centered">
      <div class="modal__centered-content modal__centered-content--padded">
        <div class="age-confirmation__inner">
          {% if section.settings.logo != blank %}
            <div class="age-confirmation__logo">
              {{
                section.settings.logo
                | image_url: width: 400
                | image_tag: loading: 'lazy', alt: section.settings.logo.alt | default: shop.name
              }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 id="AgeConfirmationHeading-{{ section.id }}" class="age-confirmation__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

          {% if section.settings.yes_button_label != blank or section.settings.no_button_label != blank %}
            <div class="age-confirmation__actions">
              {% if section.settings.yes_button_label != blank %}
                <button
                  type="button"
                  class="age-confirmation__button age-confirmation__button--yes"
                  data-age-confirmation-yes
                >
                  {{ section.settings.yes_button_label }}
                </button>
              {% endif %}

              {% if section.settings.no_button_label != blank %}
                <button
                  type="button"
                  class="age-confirmation__button age-confirmation__button--no"
                  data-age-confirmation-no
                >
                  {{ section.settings.no_button_label }}
                </button>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.error_message != blank %}
            <p class="age-confirmation__error" data-age-confirmation-error role="alert" hidden>
              {{ section.settings.error_message }}
            </p>
          {% endif %}

          {% if section.settings.text != blank %}
            <div class="age-confirmation__text rte">
              {{ section.settings.text }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('AgeConfirmation-{{ section.id }}');
    if (!root) return;

    var cookieName = root.id;

    if (Cookies.get(cookieName)) return;

    var modal = new theme.Modals(root.id, 'age-confirmation-modal', {
      closeOffContentClick: false
    });

    modal.open();

    theme.a11y.lockMobileScrolling(`#${root.id}`, document.querySelector('#MainContent'));

    var yesButton = root.querySelector('[data-age-confirmation-yes]');
    var noButton = root.querySelector('[data-age-confirmation-no]');
    var errorMessage = root.querySelector('[data-age-confirmation-error]');

    if (yesButton) {
      yesButton.addEventListener('click', function () {
        Cookies.set(cookieName, 'entered', { expires: 365, sameSite: 'none', secure: true });
        modal.close();
        theme.a11y.unlockMobileScrolling(`#${root.id}`, document.querySelector('#MainContent'));
      });
    }

    if (noButton) {
      noButton.addEventListener('click', function () {
        if (errorMessage) {
          errorMessage.hidden = false;
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Age confirmation",
  "tag": "section",
  "class": "age-confirmation-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Are you 21 or older?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>By entering, you confirm you are of legal drinking age. Please enjoy responsibly.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "yes_button_label",
      "label": "\"Yes\" button label",
      "default": "Yes"
    },
    {
      "type": "text",
      "id": "no_button_label",
      "label": "\"No\" button label",
      "default": "No"
    },
    {
      "type": "header",
      "content": "Error message"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Message shown when a visitor selects \"No\"",
      "default": "Sorry, you must be of legal drinking age to enter this site."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1c1d1d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Age confirmation"
    }
  ]
}
{% endschema %}
