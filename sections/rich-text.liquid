{% style %}
    {% for block in section.blocks %}

      #block-{{ block.id }} .rich-text__divider {
        position: relative;
        width: {{block.settings.divider_width}}%;
        height: {{ block.settings.divider_height }}px;
        background: {{ block.settings.divider_bg }};
        margin-inline: auto;
      }

      {% if block.settings.enable_divider %}
        #block-{{ block.id }} .rich-text__divider {
          margin-block-start: {{ block.settings.margin_top }}px;
          margin-block-end: {{ block.settings.margin_bottom }}px;
        }
      {% else %}
        #block-{{ block.id }} .rich-text__divider--icon {
          margin-block-start: {{ block.settings.margin_top | divided_by: 2 }}px;
          margin-block-end: {{ block.settings.margin_bottom | divided_by: 2 }}px;
        }
      {% endif %}

      #block-{{ block.id }} .rich-text__divider--icon {
        {% if block.settings.enable_divider %}
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
        {% else %}
          position: relative;
        {%endif %}
      }

    {% endfor %}


    #rich-text-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    @media screen and (max-width: 589px) {
      #rich-text-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mb }}px;
        padding-bottom: {{ section.settings.padding_bottom_mb }}px;
      }
    }

    {% if section.settings.enable_max_width %}
      {% if block.settings.max_width_desktop != blank %}
        #rich-text-{{ section.id }} .page-width {
          max-width: {{ section.settings.max_width_desktop }}px;
        }
      {% endif %}


      {% if block.settings.max_width_mobile != blank %}
      @media screen and (max-width: 589px) {
        #rich-text-{{ section.id }} .page-width {
          max-width: {{ section.settings.max_width_mobile }}px;
        }
      }
    {% endif %}
  {% endif %}
{% endstyle %}

<div
  id="rich-text-{{ section.id }}"
  class="text-{{ section.settings.align_text }} gradient color-{{ section.settings.color_scheme }}{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  {%- for block in section.blocks -%}
    <div id="block-{{ block.id }}" class="theme-block" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {% when 'divider' %}
          {% style %}
            #shopify-section-{{ section.id }} .rich-text__divider--icon {
              display: block;
              width: {{ block.settings.icon_size }}px;
              height: {{ block.settings.icon_size }}px;
              margin: 0 auto;
              border-radius: 50%;
              background-color: {{ block.settings.icon_color }};

              {% if block.settings.icon_box_shadow != blank %}
                box-shadow: {{ block.settings.icon_box_shadow }};
              {% endif %}
            }
          {% endstyle %}
          {% if block.settings.enable_divider %}
            <div class="rich-text__divider-wrapper">
              <div class="rich-text__divider">
          {% endif %}
          {% if block.settings.enable_icon %}
            <div class="rich-text__divider--icon"></div>
          {% endif %}
          {% if block.settings.enable_divider %}
            </div>
            </div>
          {% endif %}
        {%- when 'heading' -%}
          {% style %}
            #block-{{ block.id }} h2 {
              font-size: {{ block.settings.font_size }}px;
            }

            @media screen and (max-width: 589px) {
             #block-{{ block.id }} h2 {
                font-size: {{ block.settings.font_size_mb }}px;
                line-height: 1.14;
              }
            }
          {% endstyle %}

          <h2 class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {{ block.settings.title }}
          </h2>

        {%- when 'page' -%}
          <div class="rte page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {%- if block.settings.page_text != blank -%}
              {{ pages[block.settings.page_text].content }}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'text' -%}
          <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {%- if block.settings.text != blank -%}
              {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
              {{ block.settings.text }}
              {%- if block.settings.enlarge_text %}</div>{% endif -%}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'button' -%}
          <div class="button-block page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {% if block.settings.link_text != blank %}
              <div class="button-1">
                {% render 'button',
                  label: block.settings.link_text,
                  url: block.settings.link,
                  type: block.settings.button_type,
                  arrow: true
                %}
              </div>
            {% endif %}
            {% if block.settings.link_text_2 != blank %}
              <div class="button-2">
                {% render 'button',
                  label: block.settings.link_text_2,
                  url: block.settings.link_2,
                  type: block.settings.button_type_2,
                  arrow: true
                %}
              </div>
            {% endif %}
          </div>
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "class": "rich-text",
  "settings": [
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Chnges header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "t:sections.rich-text.settings.align_text.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.align_text.options.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.align_text.options.center.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.align_text.options.right.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "narrow_column",
      "label": "t:sections.rich-text.settings.narrow_column.label",
      "default": true
    },
    {
      "type": "header",
      "content": "Max-width"
    },
    {
      "type": "checkbox",
      "id": "enable_max_width",
      "label": "Enable max-width",
      "default": false
    },
    {
      "type": "number",
      "id": "max_width_desktop",
      "label": "Desktop max-width (px)",
      "default": 1000,
      "visible_if": "{{ section.settings.enable_max_width }}"
    },
    {
      "type": "number",
      "id": "max_width_mobile",
      "label": "Mobile max-width (px)",
      "default": 400,
      "visible_if": "{{ section.settings.enable_max_width }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 120
    },

    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "divider",
      "name": "Divider / Icon",
      "settings": [
        {
          "type": "header",
          "content": "Divider"
        },
        {
          "type": "checkbox",
          "id": "enable_divider",
          "label": "Enable divider",
          "default": true
        },
        {
          "type": "color",
          "id": "divider_bg",
          "label": "Background",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "divider_width",
          "min": 30,
          "max": 100,
          "label": "Width",
          "unit": "%",
          "step": 5,
          "default": 50
        },
        {
          "type": "range",
          "id": "divider_height",
          "min": 1,
          "max": 10,
          "label": "Height",
          "unit": "px",
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "checkbox",
          "id": "enable_icon",
          "label": "Enable icon",
          "default": true
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#D39655"
        },
        {
          "type": "text",
          "id": "icon_box_shadow",
          "label": "Box shadow",
          "default": "inset -8px -2px 0 0 #2D3135"
        },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 26
        },
        {
          "type": "header",
          "content": "Divider & Icon Spacing"
        },
        {
          "type": "paragraph",
          "content": "Adjusts the spacing above and below the divider and icon."
        },
        {
          "type": "range",
          "id": "margin_top",
          "label": "Spacing top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 30
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "label": "Spacing bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 30
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:sections.rich-text.blocks.heading.settings.title.label",
          "default": "Rich text"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Font size",
          "min": 18,
          "max": 120,
          "step": 2,
          "unit": "px",
          "default": 84
        },
        {
          "type": "range",
          "id": "font_size_mb",
          "label": "Font size (Mobile)",
          "min": 10,
          "max": 80,
          "step": 2,
          "unit": "px",
          "default": 32
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "enlarge_text",
          "label": "t:sections.rich-text.blocks.text.settings.enlarge_text.label",
          "default": true
        },
        {
          "id": "text",
          "type": "richtext",
          "label": "t:sections.rich-text.blocks.text.settings.text.label",
          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "settings": [
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.rich-text.blocks.button.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.rich-text.blocks.button.settings.link_text.label",
          "default": "Button"
        },
        {
          "type": "select",
          "id": "button_type",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ]
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "t:sections.rich-text.blocks.button.settings.link.label"
        },
        {
          "type": "text",
          "id": "link_text_2",
          "label": "t:sections.rich-text.blocks.button.settings.link_text.label",
          "default": "Button"
        },
        {
          "type": "select",
          "id": "button_type_2",
          "label": "Button style",
          "default": "secondary",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "link",
              "label": "Link"
            }
          ]
        }
      ]
    },
    {
      "type": "page",
      "name": "t:sections.rich-text.blocks.page.name",
      "settings": [
        {
          "id": "page_text",
          "type": "page",
          "label": "t:sections.rich-text.blocks.page.settings.page_text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.rich_text.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["custom.popups"]
  }
}
{% endschema %}
