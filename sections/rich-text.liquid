{% style %}
  {% for block in section.blocks %}
    .theme-block__button--{{ block.id }} .button.button--primary {
     --btn-primary-bg: {{ block.settings.button_primary_bg | default: "#1c1d1d" }};
      --btn-primary-border: {{ block.settings.button_primary_border | default: "#1c1d1d" }};
      --btn-primary-color: {{ block.settings.button_primary_text | default: "#ffffff" }};
      --btn-primary-bg-hover: {{ block.settings.button_primary_bg_hover | default: "#3a3a3a" }};
      --btn-primary-border-hover: {{ block.settings.button_primary_border_hover | default: "#3a3a3a" }};
      --btn-primary-color-hover: {{ block.settings.button_primary_text_hover | default: "#ffffff" }};
    }

    .theme-block__button--{{ block.id }} .button.button--secondary {
      --btn-secondary-bg: {{ block.settings.button_secondary_bg | default: "#ffffff" }};
      --btn-secondary-border: {{ block.settings.button_secondary_border | default: "#1c1d1d" }};
      --btn-secondary-color: {{ block.settings.button_secondary_text | default: "#1c1d1d" }};
      --btn-secondary-bg-hover: {{ block.settings.button_secondary_bg_hover | default: "#1c1d1d" }};
      --btn-secondary-border-hover: {{ block.settings.button_secondary_border_hover | default: "#1c1d1d" }};
      --btn-secondary-color-hover: {{ block.settings.button_secondary_text_hover | default: "#ffffff" }};
    }

    .theme-block__button--{{ block.id }} .button.button--link {
      --btn-link-color: {{ settings.button_link_text | default: "#1c1d1d" }};
      --btn-link-color-hover: {{ settings.button_link_text_hover | default: "#7a7a7a" }};
    }

    #block-{{ block.id }} .rich-text__divider {
      position: relative;
      width: {{block.settings.divider_width}}%;
      height: {{ block.settings.divider_height }}px;
      background: {{ block.settings.divider_bg }};
      margin-inline: auto;
    }

    {% if block.settings.enable_divider %}
      #block-{{ block.id }} .rich-text__divider {
        margin-block-start: {{ block.settings.margin_top }}px;
        margin-block-end: {{ block.settings.margin_bottom }}px;
      }
    {% else %}
      #block-{{ block.id }} .rich-text__divider--icon {
        margin-block-start: {{ block.settings.margin_top | divided_by: 2 }}px;
        margin-block-end: {{ block.settings.margin_bottom | divided_by: 2 }}px;
      }
    {% endif %}

    #block-{{ block.id }} .rich-text__divider--icon {
      {% if block.settings.enable_divider %}
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% else %}
        position: relative;
      {%endif %}
    }

    #block-{{ block.id }} .rich-text__divider--icon .icon,
    #block-{{ block.id }} .rich-text__divider--icon img {
      display: block;
      margin-inline: auto;
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      color: {{ block.settings.icon_color }};
      background: {{ section.settings.background_color | color_modify: 'alpha', 0.5  }};
    }
  {% endfor %}

  
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }}::before {
    display: {% if section.settings.stylized_bg %}block{% else %}none{% endif %};
  }

  @media screen and (max-width: 589px) {
    #shopify-section-{{ section.id }}.background-image {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="text-{{ section.settings.align_text }}">
  {%- for block in section.blocks -%}
    <div id="block-{{ block.id }}" class="theme-block" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {% when 'divider' %}
          {% if block.settings.enable_divider %}
            <div class="rich-text__divider-wrapper">
              <div class="rich-text__divider">
          {% endif %}
          {% if block.settings.enable_icon %}
            <div class="rich-text__divider--icon">
              {% if block.settings.custom_icon != blank %}
                {{
                  block.settings.custom_icon
                  | image_url: width: 80
                  | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                }}
              {% elsif block.settings.icon != blank %}
                {% render 'icon', name: block.settings.icon %}
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.enable_divider %}
            </div>
            </div>
          {% endif %}
        {%- when 'heading' -%}
          <h2 class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">{{ block.settings.title }}</h2>
        {%- when 'page' -%}
          <div class="rte page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {%- if block.settings.page_text != blank -%}
              {{ pages[block.settings.page_text].content }}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'text' -%}
          <div class="rte page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {%- if block.settings.text != blank -%}
              {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
              {{ block.settings.text }}
              {%- if block.settings.enlarge_text %}</div>{% endif -%}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'button' -%}
          <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
            {% render 'button',
              label: block.settings.link_text,
              url: block.settings.link,
              type: block.settings.button_type,
              arrow: true
            %}
          </div>
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

