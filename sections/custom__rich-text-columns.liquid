{% style %}
  {% for block in section.blocks %}
    #block-{{ block.id }} .rich-text__divider-wrapper, 
    #block-{{ block.id }} .rich-text__divider--icon {
      display: flex;
      {%- if block.settings.position == 'left' -%}
        justify-content: {{ section.settings.left_text_align }}
      {%endif %}
      {%- if block.settings.position == 'right' -%}
        justify-content: {{ section.settings.right_text_align }}
      {%endif %}
    }

    #block-{{ block.id }} .rich-text__divider {
      position: relative;
      width: {{block.settings.divider_width}}%;
      height: {{ block.settings.divider_height }}px;
      background: {{ block.settings.divider_bg }};
    }

    {% if block.settings.enable_divider %}
      #block-{{ block.id }} .rich-text__divider {
        margin-block-start: {{ block.settings.margin_top }}px;
        margin-block-end: {{ block.settings.margin_bottom }}px;
      }
    {% else %}
      #block-{{ block.id }} .rich-text__divider--icon {
        margin-block-start: {{ block.settings.margin_top | divided_by: 2 }}px;
        margin-block-end: {{ block.settings.margin_bottom | divided_by: 2 }}px;
      }
    {% endif %}

    #block-{{ block.id }} .rich-text__divider--icon {
      {% if block.settings.enable_divider %}
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% else %}
        position: relative;
      {%endif %}
    }

    #block-{{ block.id }} .rich-text__divider--icon .icon,
    #block-{{ block.id }} .rich-text__divider--icon img {
      display: block;
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      color: {{ block.settings.icon_color }};
      background: {{ section.settings.icon_backdrop_color }};
    }

    
    #block-{{ block.id }} .rich-text__detail-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: {{ section.settings.detail_accent_color }};
    }

    #block-{{ block.id }} .rich-text__detail-icon .icon, 
    #block-{{ block.id }} .rich-text__detail-icon img {
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
    }

    @media screen and (max-width: 589px) {
      #block-{{ block.id }} .rich-text__divider {
        width: 100%;
      }
    }
  {% endfor %}

  #custom__rich-text-columns-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__main {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 20px;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__column {
    display: flex;
    flex-direction: column;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__column--left {
    flex: 0 1 calc({{ section.settings.left_column_width }}% - 10px);
    justify-content: {{ section.settings.left_vertical_align }};
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__column--right {
    flex: 0 1 calc({{ section.settings.right_column_width }}% - 10px);
    justify-content: {{ section.settings.right_vertical_align }};
  }

  .rich-text__content ul li {
    position: relative;
    padding-left: 25px;
  }

  .rich-text__column ul {
    list-style: none;
  }

  .rich-text__content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #C64D27;
  }

  /* Detail row block (icon + label + description, tasting-note style) */
  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .rich-text__detail-description * {
    margin: 0;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 40px;
    padding: 28px 0;
    border-top: 1px solid color-mix(in srgb, {{ section.settings.detail_divider_color }} 15%, transparent);
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 220px;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label-text {
    font-size: var(--type-caption-size);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ section.settings.detail_accent_color }};
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-description {
    flex: 1;
  }

  #custom__rich-text-columns-{{ section.id }} .rich-text__detail-description p {
    margin: 0;
  }

  @media screen and (max-width: 589px) {
    #custom__rich-text-columns-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }

    #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
      align-items: flex-start;
    }

    #custom__rich-text-columns-{{ section.id }} .rich-text__main {
      flex-direction: column;
      align-items: flex-start; 
      gap: 16px;
    }
    

    #custom__rich-text-columns-{{ section.id }} .rich-text__column--left,
    #custom__rich-text-columns-{{ section.id }} .rich-text__column--right {
      width: 100%;
      flex: unset;
      display: block;
    }

    #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
      flex-direction: column;
      gap: 12px;
      padding: 20px 0;
    }

    #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label {
      flex: 0 0 auto;
    }
  }
{% endstyle %}

<div
  id="custom__rich-text-columns-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} rich-text__content{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  <div class="rich-text__main page-width">
    {%- comment -%}
      LEFT COLUMN
    {%- endcomment -%}

    <div class="rich-text__column rich-text__column--left text-{{ section.settings.left_text_align }}">
      {%- assign left_previous_type = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'left' -%}
          {%- assign left_next_block = section.blocks[forloop.index] -%}
          {%- assign left_groups_with_next = false -%}
          {%- if left_next_block and block.type == 'detail_row' and left_next_block.type == 'detail_row' and left_next_block.settings.position == 'left' -%}
            {%- assign left_groups_with_next = true -%}
          {%- endif -%}

          {%- if block.type == 'detail_row' -%}
            {%- if left_previous_type != 'detail_row' -%}
              <div class="rich-text__detail-list">
            {%- endif -%}

            <div class="rich-text__detail-row" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="rich-text__detail-label">
                <span class="rich-text__detail-icon">
                  {% if block.settings.custom_icon != blank %}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 60
                      | image_tag: loading: 'lazy', widths: '30, 60', sizes: '30px'
                    }}
                  {% elsif block.settings.icon != blank %}
                    {% render 'icon', name: block.settings.icon %}
                  {% endif %}
                </span>
                <span class="rich-text__detail-label-text">{{ block.settings.label }}</span>
              </div>
              <div class="rich-text__detail-description">
                {{ block.settings.description }}
              </div>
            </div>

            {%- unless left_groups_with_next -%}
              </div>
            {%- endunless -%}
          {%- else -%}
            <div id="block-{{ block.id }}">
              {%- case block.type -%}
                {% when 'divider' %}
                  {% if block.settings.enable_divider %}
                    <div class="rich-text__divider-wrapper">
                      <div class="rich-text__divider">
                  {% endif %}
                  {% if block.settings.enable_icon %}
                    <div class="rich-text__divider--icon">
                      {% if block.settings.custom_icon != blank %}
                        {{
                          block.settings.custom_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                        }}
                      {% elsif block.settings.icon != blank %}
                        {% render 'icon', name: block.settings.icon %}
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.enable_divider %}
                    </div>
                    </div>
                  {% endif %}
                {%- when 'preheading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </div>

                {%- when 'heading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <h2>
                      {{ block.settings.title }}
                    </h2>
                  </div>

                {%- when 'text' -%}
                  <div class="theme-block" {{ block.shopify_attributes }}>
                    <div
                      class="appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                    >
                      {%- if block.settings.text != blank -%}
                        {%- if block.settings.enlarge_text -%}
                          <div class="enlarge-text">
                        {%- endif -%}

                        {{ block.settings.text }}

                        {%- if block.settings.enlarge_text -%}
                          </div>
                        {%- endif -%}

                      {%- else -%}
                        {{ 'home_page.onboarding.no_content' | t }}
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'button' -%}
                  <div
                    class="theme-block theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'button',
                      label: block.settings.link_text,
                      url: block.settings.link,
                      type: block.settings.button_type,
                      arrow: true
                    %}
                  </div>

                {%- when 'page' -%}
                  {%- if block.settings.page_text != blank -%}
                    <div
                      class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="rte">
                        {{ block.settings.page_text.content }}
                      </div>
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endif -%}

          {%- assign left_previous_type = block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%}
      RIGHT COLUMN
    {%- endcomment -%}

    <div class="rich-text__column rich-text__column--right text-{{ section.settings.right_text_align }}">
      {%- assign right_previous_type = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.position == 'right' -%}
          {%- assign right_next_block = section.blocks[forloop.index] -%}
          {%- assign right_groups_with_next = false -%}
          {%- if right_next_block and block.type == 'detail_row' and right_next_block.type == 'detail_row' and right_next_block.settings.position == 'right' -%}
            {%- assign right_groups_with_next = true -%}
          {%- endif -%}

          {%- if block.type == 'detail_row' -%}
            {%- if right_previous_type != 'detail_row' -%}
              <div class="rich-text__detail-list">
            {%- endif -%}

            <div class="rich-text__detail-row" id="block-{{ block.id }}" {{ block.shopify_attributes }}>
              <div class="rich-text__detail-label">
                <span class="rich-text__detail-icon">
                  {% if block.settings.custom_icon != blank %}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 60
                      | image_tag: loading: 'lazy', widths: '30, 60', sizes: '30px'
                    }}
                  {% elsif block.settings.icon != blank %}
                    {% render 'icon', name: block.settings.icon %}
                  {% endif %}
                </span>
                <span class="rich-text__detail-label-text">{{ block.settings.label }}</span>
              </div>
              <div class="rich-text__detail-description">
                {{ block.settings.description }}
              </div>
            </div>

            {%- unless right_groups_with_next -%}
              </div>
            {%- endunless -%}
          {%- else -%}
            <div id="block-{{ block.id }}">
              {%- case block.type -%}
                {% when 'divider' %}
                  {% if block.settings.enable_divider %}
                    <div class="rich-text__divider-wrapper">
                      <div class="rich-text__divider">
                  {% endif %}
                  {% if block.settings.enable_icon %}
                    <div class="rich-text__divider--icon">
                      {% if block.settings.custom_icon != blank %}
                        {{
                          block.settings.custom_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                        }}
                      {% elsif block.settings.icon != blank %}
                        {% render 'icon', name: block.settings.icon %}
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.enable_divider %}
                    </div>
                    </div>
                  {% endif %}
                {%- when 'preheading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </div>

                {%- when 'heading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <h2>
                      {{ block.settings.title }}
                    </h2>
                  </div>

                {%- when 'text' -%}
                  <div class="theme-block" {{ block.shopify_attributes }}>
                    <div
                      class="rte appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                    >
                      {%- if block.settings.text != blank -%}
                        {%- if block.settings.enlarge_text -%}
                          <div class="enlarge-text">
                        {%- endif -%}

                        {{ block.settings.text }}

                        {%- if block.settings.enlarge_text -%}
                          </div>
                        {%- endif -%}

                      {%- else -%}
                        {{ 'home_page.onboarding.no_content' | t }}
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'button' -%}
                  <div
                    class="theme-block theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'button',
                      label: block.settings.link_text,
                      url: block.settings.link,
                      type: block.settings.button_type,
                      arrow: true
                    %}
                  </div>

                {%- when 'page' -%}
                  {%- if block.settings.page_text != blank -%}
                    <div
                      class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="rte">
                        {{ block.settings.page_text.content }}
                      </div>
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endif -%}

          {%- assign right_previous_type = block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text columns",
  "class": "rich-text-columns-section",

  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "left_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "left_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "range",
      "id": "right_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "right_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "right_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Detail rows"
    },
    {
      "type": "color",
      "id": "detail_accent_color",
      "label": "Accent color",
      "info": "Used for the icon outline and label color on Detail row blocks.",
      "default": "#c9a063"
    },
    {
      "type": "color",
      "id": "icon_backdrop_color",
      "label": "Divider icon backdrop",
      "info": "Background behind the divider icon.",
      "default": "#2d3135"
    },
    {
      "type": "color",
      "id": "detail_divider_color",
      "label": "Detail row divider color",
      "info": "Color used for the line between Detail row blocks.",
      "default": "#f9f6f1"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],

  "blocks": [
    {
      "type": "divider",
      "name": "Divider / Icon",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "header",
          "content": "Divider"
        },
        {
          "type": "checkbox",
          "id": "enable_divider",
          "label": "Enable divider",
          "default": true
        },
        {
          "type": "color",
          "id": "divider_bg",
          "label": "Background",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "divider_width",
          "min": 30,
          "max": 100,
          "label": "Width",
          "unit": "%",
          "step": 5,
          "default": 50
        },
        {
          "type": "range",
          "id": "divider_height",
          "min": 1,
          "max": 10,
          "label": "Height",
          "unit": "px",
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "checkbox",
          "id": "enable_icon",
          "label": "Enable icon",
          "default": true
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color",
          "default": "#f9f6f1"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Image takes priority over icon selector"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:common.text_with_icons.blocks.column.settings.icon.label",
          "default": "chat",
          "options": [
            {
              "value": "texture",
              "label": "Texture"
            },
            {
              "value": "aroma",
              "label": "Aroma"
            },
            {
              "value": "palate",
              "label": "Palate"
            },
            {
              "value": "crescent-moon",
              "label": "Crescent moon"
            },
            {
              "value": "table",
              "label": "Table"
            },
            {
              "value": "certification",
              "label": "Certification"
            },
            {
              "value": "agave",
              "label": "Agave"
            },
            {
              "value": "bills",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.bills.label"
            },
            {
              "value": "calendar",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.calendar.label"
            },
            {
              "value": "cart",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.cart.label"
            },
            {
              "value": "charity",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.charity.label"
            },
            {
              "value": "chat",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.chat.label"
            },
            {
              "value": "envelope",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.envelope.label"
            },
            {
              "value": "gears",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.gears.label"
            },
            {
              "value": "gift",
              "label": "t:common.text_with_icons.blocks.column.settings.icon.options.gift.label"
            },
            {
              "value": "globe",
