        },
        {
          "type": "header",
          "content": "Divider"
        },
        {
          "type": "checkbox",
          "id": "enable_divider",
          "label": "Enable divider",
          "default": true
        },
        {
          "type": "color",
          "id": "divider_bg",
          "label": "Background",
          "default": "#000"
        },
        {
          "type": "range",
          "id": "divider_width",
          "min": 30,
          "max": 100,
          "label": "Width",
          "unit": "%",
          "step": 5,
          "default": 50
        },
        {
          "type": "range",
          "id": "divider_height",
          "min": 1,
          "max": 10,
          "label": "Height",
          "unit": "px",
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
