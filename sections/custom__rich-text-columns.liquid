{% style %}
  {% for block in section.blocks %}
    .theme-block__button--{{ block.id }} .button.button--primary {
     --btn-primary-bg: {{ block.settings.button_primary_bg | default: "#1c1d1d" }};
      --btn-primary-border: {{ block.settings.button_primary_border | default: "#1c1d1d" }};
      --btn-primary-color: {{ block.settings.button_primary_text | default: "#ffffff" }};
      --btn-primary-bg-hover: {{ block.settings.button_primary_bg_hover | default: "#3a3a3a" }};
      --btn-primary-border-hover: {{ block.settings.button_primary_border_hover | default: "#3a3a3a" }};
      --btn-primary-color-hover: {{ block.settings.button_primary_text_hover | default: "#ffffff" }};
    }

    .theme-block__button--{{ block.id }} .button.button--secondary {
      --btn-secondary-bg: {{ block.settings.button_secondary_bg | default: "#ffffff" }};
      --btn-secondary-border: {{ block.settings.button_secondary_border | default: "#1c1d1d" }};
      --btn-secondary-color: {{ block.settings.button_secondary_text | default: "#1c1d1d" }};
      --btn-secondary-bg-hover: {{ block.settings.button_secondary_bg_hover | default: "#1c1d1d" }};
      --btn-secondary-border-hover: {{ block.settings.button_secondary_border_hover | default: "#1c1d1d" }};
      --btn-secondary-color-hover: {{ block.settings.button_secondary_text_hover | default: "#ffffff" }};
    }

    .theme-block__button--{{ block.id }} .button.button--link {
      --btn-link-color: {{ block.settings.button_link_text | default: "#1c1d1d" }};
      --btn-link-color-hover: {{ block.settings.button_link_text_hover | default: "#7a7a7a" }};
    }

    #block-{{ block.id }} .rich-text__divider-wrapper {
      display: flex;
      {%- if block.settings.position == 'left' -%}
        justify-content: {{ section.settings.left_text_align }}
      {%endif %}
      {%- if block.settings.position == 'right' -%}
        justify-content: {{ section.settings.right_text_align }}
      {%endif %}
    }

    #block-{{ block.id }} .rich-text__divider {
      position: relative;
      width: {{block.settings.divider_width}}%;
      height: {{ block.settings.divider_height }}px;
      background: {{ block.settings.divider_bg }};
    }

    {% if block.settings.enable_divider %}
      #block-{{ block.id }} .rich-text__divider {
        margin-block-start: {{ block.settings.margin_top }}px;
        margin-block-end: {{ block.settings.margin_bottom }}px;
      }
    {% else %}
      #block-{{ block.id }} .rich-text__divider--icon {
        margin-block-start: {{ block.settings.margin_top | divided_by: 2 }}px;
        margin-block-end: {{ block.settings.margin_bottom | divided_by: 2 }}px;
      }
    {% endif %}

    #block-{{ block.id }} .rich-text__divider--icon {
      {% if block.settings.enable_divider %}
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      {% else %}
        position: relative;
      {%endif %}
    }

    #block-{{ block.id }} .rich-text__divider--icon .icon,
    #block-{{ block.id }} .rich-text__divider--icon img {
      display: block;
      margin-inline: auto;
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
      color: {{ block.settings.icon_color }};
      background: {{ section.settings.section_background }};
    }
  {% endfor %}

  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .rich-text__main {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 20px;
  }

  #shopify-section-{{ section.id }} .rich-text__column {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .rich-text__column--left {
    flex: 0 1 calc({{ section.settings.left_column_width }}% - 10px);
    justify-content: {{ section.settings.left_vertical_align }};
  }

  #shopify-section-{{ section.id }} .rich-text__column--right {
    flex: 0 1 calc({{ section.settings.right_column_width }}% - 10px);
    justify-content: {{ section.settings.right_vertical_align }};
  }

  .rich-text__content ul li {
    position: relative;
    padding-left: 25px;
  }

  .rich-text__content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #C64D27;
  }

  @media screen and (max-width: 589px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .rich-text__main {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .rich-text__column--left,
    #shopify-section-{{ section.id }} .rich-text__column--right {
      flex: 1 1 100%;
    }
  }
{% endstyle %}

<div class="rich-text__content page-width">
  <div class="rich-text__main">
    {%- comment -%}
      LEFT COLUMN
    {%- endcomment -%}

    <div class="rich-text__column rich-text__column--left text-{{ section.settings.left_text_align }}">
      {%- for block in section.blocks -%}
        <div id="block-{{ block.id }}">
          {%- if block.settings.position == 'left' -%}
            {%- case block.type -%}
              {% when 'divider' %}
                {% if block.settings.enable_divider %}
                  <div class="rich-text__divider-wrapper">
                    <div class="rich-text__divider">
                {% endif %}
                {% if block.settings.enable_icon %}
                  <div class="rich-text__divider--icon">
                    {% if block.settings.custom_icon != blank %}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                      }}
                    {% elsif block.settings.icon != blank %}
                      {% render 'icon', name: block.settings.icon %}
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.enable_divider %}
                  </div>
                  </div>
                {% endif %}
              {%- when 'preheading' -%}
                <div
                  class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.title }}
                </div>

              {%- when 'heading' -%}
                <div
                  class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <h2>
                    {{ block.settings.title }}
                  </h2>
                </div>

              {%- when 'text' -%}
                <div class="theme-block" {{ block.shopify_attributes }}>
                  <div
                    class="appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                  >
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.enlarge_text -%}
                        <div class="enlarge-text">
                      {%- endif -%}

                      {{ block.settings.text }}

                      {%- if block.settings.enlarge_text -%}
                        </div>
                      {%- endif -%}

                    {%- else -%}
                      {{ 'home_page.onboarding.no_content' | t }}
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'button' -%}
                <div
                  class="theme-block theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {% render 'button',
                    label: block.settings.link_text,
                    url: block.settings.link,
                    type: block.settings.button_type,
                    arrow: true
                  %}
                </div>

              {%- when 'page' -%}
                {%- if block.settings.page_text != blank -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="rte">
                      {{ block.settings.page_text.content }}
                    </div>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%}
      RIGHT COLUMN
    {%- endcomment -%}

    <div class="rich-text__column rich-text__column--right text-{{ section.settings.right_text_align }}">
      {%- for block in section.blocks -%}
        <div id="block-{{ block.id }}">
          {%- if block.settings.position == 'right' -%}
            {%- case block.type -%}
              {% when 'divider' %}
                {% if block.settings.enable_divider %}
                  <div class="rich-text__divider-wrapper">
                    <div class="rich-text__divider">
                {% endif %}
                {% if block.settings.enable_icon %}
                  <div class="rich-text__divider--icon">
                    {% if block.settings.custom_icon != blank %}
                      {{
                        block.settings.custom_icon
                        | image_url: width: 80
                        | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                      }}
                    {% elsif block.settings.icon != blank %}
                      {% render 'icon', name: block.settings.icon %}
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.enable_divider %}
                  </div>
                  </div>
                {% endif %}
              {%- when 'preheading' -%}
                <div
                  class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.title }}
                </div>

              {%- when 'heading' -%}
                <div
                  class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <h2>
                    {{ block.settings.title }}
                  </h2>
                </div>

              {%- when 'text' -%}
                <div class="theme-block" {{ block.shopify_attributes }}>
                  <div
                    class="rte appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                  >
                    {%- if block.settings.text != blank -%}
                      {%- if block.settings.enlarge_text -%}
                        <div class="enlarge-text">
                      {%- endif -%}

                      {{ block.settings.text }}

                      {%- if block.settings.enlarge_text -%}
                        </div>
                      {%- endif -%}

                    {%- else -%}
                      {{ 'home_page.onboarding.no_content' | t }}
                    {%- endif -%}
                  </div>
                </div>

              {%- when 'button' -%}
                <div
                  class="theme-block theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                  data-block-id="{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  {% render 'button',
                    label: block.settings.link_text,
                    url: block.settings.link,
                    type: block.settings.button_type,
                    arrow: true
                  %}
                </div>

              {%- when 'page' -%}
                {%- if block.settings.page_text != blank -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="rte">
                      {{ block.settings.page_text.content }}
                    </div>
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text columns",
  "class": "background-image",

  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#2d3135"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f9f6f1"
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "left_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "left_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "range",
      "id": "right_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "right_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "right_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },

    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],

  "blocks": [
    {
      "type": "divider",
      "name": "Divider",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
