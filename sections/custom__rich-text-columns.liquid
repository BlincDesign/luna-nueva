{% style %}
      .rich-text__column .h4,.rich-text__column h4,.rich-text__column .h5,.rich-text__column h5,.rich-text__column .h6,.rich-text__column h6, .rich-text__column p {
        margin-bottom: 0;
      }


      {% for block in section.blocks %}
        #block-{{ block.id }} .rich-text__divider-wrapper,
        #block-{{ block.id }} .rich-text__divider--icon {
          display: flex;
          {%- if block.settings.position == 'left' -%}
            justify-content: {{ section.settings.left_text_align }}
          {%endif %}
          {%- if block.settings.position == 'right' -%}
            justify-content: {{ section.settings.right_text_align }}
          {%endif %}
        }

        #block-{{ block.id }} .rich-text__divider {
          position: relative;
          width: {{block.settings.divider_width}}%;
          height: {{ block.settings.divider_height }}px;
          background: {{ block.settings.divider_bg }};
        }

        {% if block.settings.enable_divider %}
          #block-{{ block.id }} .rich-text__divider {
            margin-block-start: {{ block.settings.margin_top }}px;
            margin-block-end: {{ block.settings.margin_bottom }}px;
          }
        {% else %}
          #block-{{ block.id }} .rich-text__divider--icon {
            margin-block-start: {{ block.settings.margin_top | divided_by: 2 }}px;
            margin-block-end: {{ block.settings.margin_bottom | divided_by: 2 }}px;
          }
        {% endif %}

        #block-{{ block.id }} .rich-text__divider--icon {
          {% if block.settings.enable_divider %}
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
          {% else %}
            position: relative;
          {%endif %}
        }

        #block-{{ block.id }} .rich-text__divider--icon .icon,
        #block-{{ block.id }} .rich-text__divider--icon img {
          display: block;
          width: {{ block.settings.icon_size }}px;
          height: {{ block.settings.icon_size }}px;
          color: {{ block.settings.icon_color }};
          background: {{ section.settings.icon_backdrop_color }};
        }


        #block-{{ block.id }} .rich-text__detail-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          color: {{ section.settings.detail_accent_color }};
        }

        #block-{{ block.id }} .rich-text__detail-icon .icon,
        #block-{{ block.id }} .rich-text__detail-icon img {
          width: {{ block.settings.icon_size }}px;
          height: {{ block.settings.icon_size }}px;
        }

        {% if block.settings.enable_italic %}
        #block-{{ block.id }} .theme-block__text em:has(strong) strong {
          font-style: italic;
        }
        {%endif %}

        @media screen and (max-width: 589px) {
          #block-{{ block.id }} .rich-text__divider {
            width: 100%;
          }
        }
      {% endfor %}

      .rich-text__content h2 {
        margin: 0;
      }

      #custom__rich-text-columns-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }

      #custom__rich-text-columns-{{ section.id }} {
        position: relative;
        overflow: clip; /* prevents the bleed from creating horizontal scroll */
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__main {
        position: relative;
        z-index: 1;
      }

      /* Desktop: overlay layer, split matches the real columns exactly */
      #custom__rich-text-columns-{{ section.id }} .rich-text__bg {
        position: absolute;
        inset: 0;
        display: flex;
        z-index: 0;
        pointer-events: none;
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__bg-panel--left {
        width: {{ section.settings.left_column_width }}%;
        margin-left: calc(-1 * (100vw - 100%) / 2);
        padding-left: calc((100vw - 100%) / 2);
        box-sizing: content-box;
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__bg-panel--right {
        width: {{ section.settings.right_column_width }}%;
        margin-right: calc(-1 * (100vw - 100%) / 2);
        padding-right: calc((100vw - 100%) / 2);
        box-sizing: content-box;
      }

      @media screen and (max-width: 589px) {
        /* Mobile: columns stack, so the overlay approach can't track height — kill it, color the column itself */
        #custom__rich-text-columns-{{ section.id }} .rich-text__bg {
          display: none;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__column--left,
        #custom__rich-text-columns-{{ section.id }} .rich-text__column--right {
          position: relative;
          margin-inline: calc(-1 * (100vw - 100%) / 2);
          padding-inline: calc((100vw - 100%) / 2 + 20px);
          padding-block: 24px;
        }
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__main {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        justify-content: space-between;
        gap: 20px;
        position: relative;
      }

      {% if section.settings.enable_vertical_divider %}
        #custom__rich-text-columns-{{ section.id }} .rich-text__main::before {
          content: '';
          position: absolute;
          top: 0;
          bottom: 0;
          left: 50%;
          width: 1px;
          background: rgb(var(--color-border));
          transform: translateX(-50%);
        }
      {% endif %}

      #custom__rich-text-columns-{{ section.id }} .rich-text__column {
        display: flex;
        flex-direction: column;
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__column--left {
        flex: 0 1 calc({{ section.settings.left_column_width }}% - 10px);
        justify-content: {{ section.settings.left_vertical_align }};
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__column--right {
        flex: 0 1 calc({{ section.settings.right_column_width }}% - 10px);
        justify-content: {{ section.settings.right_vertical_align }};
      }

      .rich-text__content ul li {
        position: relative;
        padding-left: 25px;
        margin-bottom: 1.15rem;
      }

      .rich-text__content ul li:last-child {
          margin-bottom: 0;
      }

      .rich-text__column ul {
        list-style: none;
      }

      .rich-text__content ul li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 5px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #C64D27;
      }

      /* Detail row block (icon + label + description, tasting-note style) */
      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-list {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      .rich-text__detail-description * {
        margin: 0;
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px 40px;
        padding: 28px 0;
        border-top: 1px solid color-mix(in srgb, {{ section.settings.detail_divider_color }} 15%, transparent);
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 0 0 220px;
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label-text {
        font-size: var(--type-caption-size);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: {{ section.settings.detail_accent_color }};
      }

      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-description {
        flex: 1;
      }
    /*
      #custom__rich-text-columns-{{ section.id }} .rich-text__detail-description p {
        margin: 0;
      } */

      @media screen and (max-width: 589px) {
        #custom__rich-text-columns-{{ section.id }} {
          padding-top: {{ section.settings.padding_top_mb }}px;
          padding-bottom: {{ section.settings.padding_bottom_mb }}px;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
          align-items: flex-start;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__main {
          flex-direction: column;
          align-items: flex-start;
          gap: 16px;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__main.mobile-style {
            gap: 26px;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__main.mobile-style-gap {
            gap: 44px;
        }

        .rich-text__content ul li {
            font-size: 14px;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__main::before {
          display: none;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__column--left,
        #custom__rich-text-columns-{{ section.id }} .rich-text__column--right {
          width: 100%;
          flex: unset;
          display: block;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__detail-row {
          flex-direction: column;
          gap: 12px;
          padding: 20px 0;
        }

        #custom__rich-text-columns-{{ section.id }} .rich-text__detail-label {
          flex: 0 0 auto;
        }

        .theme-block__buttons {
          text-align: left !important;
        }

        .stats-item .stats-heading {
            font-size: 30px;
        }

        .rich-text__column ul {
            margin-left: 0;
        }
      }

    .theme-block--video .element-video video-media {
      position: unset;
    }

    .theme-block--video video {
        display: block;
        width: 100%;
        height: 100%;
    }

    .theme-block--video, .theme-block--image {
      margin-block: 1.5rem;
    }

    .theme-block--link_text:before {
      display: none;
    }

    .theme-block--two-column-media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: end;
  }

  .theme-block--two-column-media__media {
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 0.9;
  }

  .theme-block--two-column-media__item--portrait .theme-block--two-column-media__media {
    aspect-ratio: 3 / 4;
  }

  .theme-block--two-column-media__media img,
  .theme-block--two-column-media__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .theme-block--two-column-media__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-block--two-column-media__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  .theme-block--two-column-media__caption {
    display: block;
    margin-top: 8px;
  }

  .theme-block--two-column-media__caption {
    position: absolute;
  }

  .theme-block--two-column-media__item--none .theme-block--two-column-media__media {
    aspect-ratio: auto;
  }

  .theme-block--two-column-media__item--none .theme-block--two-column-media__media img,
  .theme-block--two-column-media__item--none .theme-block--two-column-media__media video {
    height: auto;
    object-fit: contain;
  }
{% endstyle %}

<div
  id="custom__rich-text-columns-{{ section.id }}"
  class="rich-text__content{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  <div class="rich-text__bg" aria-hidden="true">
    <div class="rich-text__bg-panel rich-text__bg-panel--left color-{{ section.settings.left_color_scheme }}"></div>
    <div class="rich-text__bg-panel rich-text__bg-panel--right color-{{ section.settings.right_color_scheme }}"></div>
  </div>
  <div class="rich-text__main page-width {{ section.settings.custom_class }}">
    {%- comment -%}
      LEFT COLUMN
    {%- endcomment -%}

    <div
      class="rich-text__column rich-text__column--left color-{{ section.settings.left_color_scheme }} text-{{ section.settings.left_text_align }} mb-text-{{ section.settings.left_text-align_mb }}"
      data-aos
    >
      {%- assign left_previous_type = '' -%}
      {%- for block in section.blocks -%}
        {% liquid
          capture margin_bottom
            echo 'margin-bottom: ' | append: block.settings.margin_bottom | append: 'px'
          endcapture
        %}
        {%- if block.settings.position == 'left' -%}
          {%- assign left_next_block = section.blocks[forloop.index] -%}
          {%- assign left_groups_with_next = false -%}
          {%- if left_next_block
            and block.type == 'detail_row'
            and left_next_block.type == 'detail_row'
            and left_next_block.settings.position == 'left'
          -%}
            {%- assign left_groups_with_next = true -%}
          {%- endif -%}

          {%- if block.type == 'detail_row' -%}
            {%- if left_previous_type != 'detail_row' -%}
              <div class="rich-text__detail-list">
            {%- endif -%}

            <div
              class="rich-text__detail-row"
              id="block-{{ block.id }}"
              {{ block.shopify_attributes }}
              style="{{ margin_bottom }}"
            >
              <div class="rich-text__detail-label">
                <span class="rich-text__detail-icon">
                  {% if block.settings.custom_icon != blank %}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 60
                      | image_tag: loading: 'lazy', widths: '30, 60', sizes: '30px'
                    }}
                  {% elsif block.settings.icon != blank %}
                    {% render 'icon', name: block.settings.icon %}
                  {% endif %}
                </span>
                <span class="rich-text__detail-label-text">{{ block.settings.label }}</span>
              </div>
              <div class="rich-text__detail-description">
                {{ block.settings.description }}
              </div>
            </div>

            {%- unless left_groups_with_next -%}
              </div>
            {%- endunless -%}
          {%- else -%}
            <div id="block-{{ block.id }}" class="block-{{ block.type }}">
              {%- case block.type -%}
                {% when 'divider' %}
                  {% if block.settings.enable_divider %}
                    <div class="rich-text__divider-wrapper">
                      <div class="rich-text__divider">
                  {% endif %}
                  {% if block.settings.enable_icon %}
                    <div class="rich-text__divider--icon">
                      {% if block.settings.custom_icon != blank %}
                        {{
                          block.settings.custom_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                        }}
                      {% elsif block.settings.icon != blank %}
                        {% render 'icon', name: block.settings.icon %}
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.enable_divider %}
                    </div>
                    </div>
                  {% endif %}
                {%- when 'preheading' -%}
                  <div
                    class="theme-block subheading {% if block.settings.enable_fade %}text--faded{% endif %} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </div>

                {%- when 'heading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"

                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    <h2>
                      {{ block.settings.title }}
                    </h2>
                  </div>

                {%- when 'text' -%}
                  <div
                    class="theme-block theme-block__text {% if block.settings.enable_fade %}text--faded{% endif %}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    <div
                      class="appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                    >
                      {%- if block.settings.text != blank -%}
                        {%- if block.settings.enlarge_text -%}
                          <div class="enlarge-text">
                        {%- endif -%}

                        {{ block.settings.text }}

                        {%- if block.settings.enlarge_text -%}
                          </div>
                        {%- endif -%}

                      {%- else -%}
                        {{ 'home_page.onboarding.no_content' | t }}
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'button' -%}
                  <div
                    class="theme-block theme-block__buttons theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'button',
                      label: block.settings.link_text,
                      url: block.settings.link,
                      type: block.settings.button_type,
                      arrow: true
                    %}
                  </div>

                {%- when 'page' -%}
                  {%- if block.settings.page_text != blank -%}
                    <div
                      class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                      style="{{ margin_bottom }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="rte">
                        {{ block.settings.page_text.content }}
                      </div>
                    </div>
                  {%- endif -%}

                {% when 'media' %}
                  <div
                    {{ block.shopify_attributes }}
                    style="{{ margin_bottom }}"
                  >
                    {%- if block.settings.video_one != blank -%}
                      <div class="theme-block--video">
                        {%- render 'element.video',
                          video: block.settings.video_one,
                          autoplay: true,
                          loop: true,
                          muted: true,
                          background: true
                        -%}

                        {%- if block.settings.image_one_caption != blank -%}
                          <span class="media-gallery__caption">
                            {{- block.settings.image_one_caption -}}
                          </span>
                        {%- endif -%}
                      </div>

                    {%- elsif block.settings.image_one != blank -%}
                      <div class="theme-block--image {% if block.settings.image_mask != 'none' %}svg-mask svg-mask--{{ block.settings.image_mask }}{% endif %}">
                        {%- render 'image-element',
                          img: block.settings.image_one,
                          widths: '300, 400, 600, 800, 1000, 1200, 1600',
                          classes: '-img'
                        -%}

                        {%- if block.settings.image_one_caption != blank -%}
                          <span class="media-gallery__caption">
                            {{- block.settings.image_one_caption -}}
                          </span>
                        {%- endif -%}
                      </div>

                    {%- else -%}
                      <div class="theme-block--image--placeholder">
                        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                      </div>
                    {%- endif -%}
                  </div>

                {% when 'link_text' %}
                  <li
                    class="theme-block--link_text"
                    {{ block.shopify_attributes }}
                    style="{{ margin_bottom }}"
                  >
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link | default: '#' }}">
                    {% else %}
                      <div>
                    {% endif %}
                    <span class="theme-block--link_text--title">{{ block.settings.title }}</span>
                    {% if block.settings.subtext != blank %}
                      <span class="theme-block--link_text--subtext">{{ block.settings.subtext }}</span>
                    {% endif %}
                    {% if block.settings.link != blank %}
                      </a>
                    {% else %}
                      </div>
                    {% endif %}
                  </li>

                {%- when 'two_column_media' -%}
                  <div
                    class="theme-block--two-column-media"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="theme-block--two-column-media__item theme-block--two-column-media__item--{{ block.settings.orientation_one }}">
                      {%- if block.settings.video_one != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'element.video',
                            video: block.settings.video_one,
                            autoplay: true,
                            loop: true,
                            muted: true,
                            background: true
                          -%}
                        </div>

                      {%- elsif block.settings.image_one != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'image-element',
                            img: block.settings.image_one,
                            widths: '300, 400, 600, 800, 1000, 1200, 1600',
                            classes: 'theme-block--two-column-media__image'
                          -%}
                        </div>

                      {%- else -%}
                        <div class="theme-block--two-column-media__media theme-block--two-column-media__placeholder">
                          {{- 'collection-2' | placeholder_svg_tag: 'placeholder-svg' -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.caption_one != blank -%}
                        <span class="theme-block--two-column-media__caption">
                          {{- block.settings.caption_one -}}
                        </span>
                      {%- endif -%}
                    </div>

                    <div class="theme-block--two-column-media__item theme-block--two-column-media__item--{{ block.settings.orientation_two }}">
                      {%- if block.settings.video_two != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'element.video',
                            video: block.settings.video_two,
                            autoplay: true,
                            loop: true,
                            muted: true,
                            background: true
                          -%}
                        </div>

                      {%- elsif block.settings.image_two != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'image-element',
                            img: block.settings.image_two,
                            widths: '300, 400, 600, 800, 1000, 1200, 1600',
                            classes: 'theme-block--two-column-media__image'
                          -%}
                        </div>

                      {%- else -%}
                        <div class="theme-block--two-column-media__media theme-block--two-column-media__placeholder">
                          {{- 'collection-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.caption_two != blank -%}
                        <span class="theme-block--two-column-media__caption">
                          {{- block.settings.caption_two -}}
                        </span>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            </div>
          {%- endif -%}

          {%- assign left_previous_type = block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%}
      RIGHT COLUMN
    {%- endcomment -%}

    <div
      class="rich-text__column rich-text__column--right color-{{ section.settings.right_color_scheme }} text-{{ section.settings.right_text_align }} mb-text-{{ section.settings.right_text-align_mb }}"
      data-aos
    >
      {%- assign right_previous_type = '' -%}
      {%- for block in section.blocks -%}
        {% liquid
          capture margin_bottom
            echo 'margin-bottom: ' | append: block.settings.margin_bottom | append: 'px'
          endcapture
        %}
        {%- if block.settings.position == 'right' -%}
          {%- assign right_next_block = section.blocks[forloop.index] -%}
          {%- assign right_groups_with_next = false -%}
          {%- if right_next_block
            and block.type == 'detail_row'
            and right_next_block.type == 'detail_row'
            and right_next_block.settings.position == 'right'
          -%}
            {%- assign right_groups_with_next = true -%}
          {%- endif -%}

          {%- if block.type == 'detail_row' -%}
            {%- if right_previous_type != 'detail_row' -%}
              <div class="rich-text__detail-list">
            {%- endif -%}

            <div
              class="rich-text__detail-row"
              id="block-{{ block.id }}"
              {{ block.shopify_attributes }}
              style="{{ margin_bottom }}"
            >
              <div class="rich-text__detail-label">
                <span class="rich-text__detail-icon">
                  {% if block.settings.custom_icon != blank %}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 60
                      | image_tag: loading: 'lazy', widths: '30, 60', sizes: '30px'
                    }}
                  {% elsif block.settings.icon != blank %}
                    {% render 'icon', name: block.settings.icon %}
                  {% endif %}
                </span>
                <span class="rich-text__detail-label-text">{{ block.settings.label }}</span>
              </div>
              <div class="rich-text__detail-description">
                {{ block.settings.description }}
              </div>
            </div>

            {%- unless right_groups_with_next -%}
              </div>
            {%- endunless -%}
          {%- else -%}
            <div id="block-{{ block.id }}" class="block-{{ block.type }}">
              {%- case block.type -%}
                {% when 'divider' %}
                  {% if block.settings.enable_divider %}
                    <div class="rich-text__divider-wrapper">
                      <div class="rich-text__divider">
                  {% endif %}
                  {% if block.settings.enable_icon %}
                    <div class="rich-text__divider--icon">
                      {% if block.settings.custom_icon != blank %}
                        {{
                          block.settings.custom_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                        }}
                      {% elsif block.settings.icon != blank %}
                        {% render 'icon', name: block.settings.icon %}
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.enable_divider %}
                    </div>
                    </div>
                  {% endif %}
                {%- when 'preheading' -%}
                  <div
                    class="theme-block {% if block.settings.enable_fade %}text--faded{% endif %} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.title }}
                  </div>

                {%- when 'heading' -%}
                  <div
                    class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    <h2>
                      {{ block.settings.title }}
                    </h2>
                  </div>

                {%- when 'text' -%}
                  <div
                    class="theme-block {% if block.settings.enable_fade %}text--faded{% endif %} theme-block__text"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    <div
                      class="appear-delay{% cycle '', '-1', '-2', '-3', '-4' %} {%- if block.settings.subheading != blank -%} subheading{% endif %}"
                      data-block-id="{{ block.id }}"
                    >
                      {%- if block.settings.text != blank -%}
                        {%- if block.settings.enlarge_text -%}
                          <div class="enlarge-text">
                        {%- endif -%}

                        {{ block.settings.text }}

                        {%- if block.settings.enlarge_text -%}
                          </div>
                        {%- endif -%}

                      {%- else -%}
                        {{ 'home_page.onboarding.no_content' | t }}
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'button' -%}
                  <div
                    class="theme-block theme-block__buttons theme-block__button--{{ block.id }} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                    data-block-id="{{ block.id }}"
                    style="{{ margin_bottom }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'button',
                      label: block.settings.link_text,
                      url: block.settings.link,
                      type: block.settings.button_type,
                      arrow: true
                    %}
                  </div>

                {%- when 'page' -%}
                  {%- if block.settings.page_text != blank -%}
                    <div
                      class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
                      data-block-id="{{ block.id }}"
                      style="{{ margin_bottom }}"
                      {{ block.shopify_attributes }}
                    >
                      <div class="rte">
                        {{ block.settings.page_text.content }}
                      </div>
                    </div>
                  {%- endif -%}

                {% when 'media' %}
                  <div
                    style="{{ margin_bottom }}"
                  >
                    {%- if block.settings.video_one != blank -%}
                      <div class=" theme-block--video">
                        {%- render 'element.video',
                          video: block.settings.video_one,
                          autoplay: true,
                          loop: true,
                          muted: true,
                          background: true
                        -%}

                        {%- if block.settings.image_one_caption != blank -%}
                          <span class="media-gallery__caption">
                            {{- block.settings.image_one_caption -}}
                          </span>
                        {%- endif -%}
                      </div>

                    {%- elsif block.settings.image_one != blank -%}
                      <div class="theme-block--image {% if block.settings.image_mask != 'none' %}svg-mask svg-mask--{{ block.settings.image_mask }}{% endif %}">
                        {%- render 'image-element',
                          img: block.settings.image_one,
                          widths: '300, 400, 600, 800, 1000, 1200, 1600',
                          classes: '-img'
                        -%}

                        {%- if block.settings.image_one_caption != blank -%}
                          <span class="media-gallery__caption">
                            {{- block.settings.image_one_caption -}}
                          </span>
                        {%- endif -%}
                      </div>

                    {%- else -%}
                      <div class=" theme-block--image--placeholder">
                        {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                      </div>
                    {%- endif -%}
                  </div>

                {% when 'link_text' %}
                  <li
                    class="theme-block--link_text"
                    {{ block.shopify_attributes }}
                    style="{{ margin_bottom }}"
                  >
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link | default: '#' }}">
                    {% else %}
                      <div>
                    {% endif %}
                    <span class="theme-block--link_text--title">{{ block.settings.title }}</span>
                    {% if block.settings.subtext != blank %}
                      <span class="theme-block--link_text--subtext">{{ block.settings.subtext }}</span>
                    {% endif %}
                    {% if block.settings.link != blank %}
                      </a>
                    {% else %}
                      </div>
                    {% endif %}
                  </li>

                {%- when 'two_column_media' -%}
                  <div
                    class="theme-block--two-column-media"
                    {{ block.shopify_attributes }}
                    style="{{ margin_bottom }}"
                  >
                    <div class="theme-block--two-column-media__item theme-block--two-column-media__item--{{ block.settings.orientation_one }}">
                      {%- if block.settings.video_one != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'element.video',
                            video: block.settings.video_one,
                            autoplay: true,
                            loop: true,
                            muted: true,
                            background: true
                          -%}
                        </div>

                      {%- elsif block.settings.image_one != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'image-element',
                            img: block.settings.image_one,
                            widths: '300, 400, 600, 800, 1000, 1200, 1600',
                            classes: 'theme-block--two-column-media__image'
                          -%}
                        </div>

                      {%- else -%}
                        <div class="theme-block--two-column-media__media theme-block--two-column-media__placeholder">
                          {{- 'collection-2' | placeholder_svg_tag: 'placeholder-svg' -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.caption_one != blank -%}
                        <span class="theme-block--two-column-media__caption">
                          {{- block.settings.caption_one -}}
                        </span>
                      {%- endif -%}
                    </div>

                    <div class="theme-block--two-column-media__item theme-block--two-column-media__item--{{ block.settings.orientation_two }}">
                      {%- if block.settings.video_two != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'element.video',
                            video: block.settings.video_two,
                            autoplay: true,
                            loop: true,
                            muted: true,
                            background: true
                          -%}
                        </div>

                      {%- elsif block.settings.image_two != blank -%}
                        <div class="theme-block--two-column-media__media">
                          {%- render 'image-element',
                            img: block.settings.image_two,
                            widths: '300, 400, 600, 800, 1000, 1200, 1600',
                            classes: 'theme-block--two-column-media__image'
                          -%}
                        </div>

                      {%- else -%}
                        <div class="theme-block--two-column-media__media theme-block--two-column-media__placeholder">
                          {{- 'collection-1' | placeholder_svg_tag: 'placeholder-svg' -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.caption_two != blank -%}
                        <span class="theme-block--two-column-media__caption">
                          {{- block.settings.caption_two -}}
                        </span>
                      {%- endif -%}
                    </div>
                  </div>
              {%- endcase -%}
            </div>
          {%- endif -%}

          {%- assign right_previous_type = block.type -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text columns",
  "class": "rich-text-columns-section",

  "settings": [
    {
