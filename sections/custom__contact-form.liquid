<div class="index-section">
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    <div class="">
      {%- if section.settings.title != blank
        or section.settings.text != blank
        or section.settings.pre_title != blank
      -%}
        <div class="section-header">
          {%- if section.settings.pre_title != blank -%}
            <p class="section-header__title">
              {{ section.settings.pre_title }}
            </p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="section-header__title">
              {{ section.settings.title }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="rte section-header__rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="email-wrapper">
        {% if section.settings.email_heading != blank %}
          <p>{{ section.settings.email_heading }}</p>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="mail">
            <a href="mailto:{{ section.settings.email }}">
              {{ section.settings.email }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="form-vertical">
      {%- assign form_id = 'contact-' | append: section.id -%}

      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <div class="grid grid--small">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'name' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormName-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="text"
                    id="ContactFormName-{{ section.id }}"
                    class="input-full"
                    name="contact[name]"
                    autocapitalize="words"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'text' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormText-{{ block.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="text"
                    id="ContactFormText-{{ block.id }}"
                    class="input-full"
                    name="contact[{{ block.settings.label | handleize }}]"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'email' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormEmail-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="email"
                    id="ContactFormEmail-{{ section.id }}"
                    class="input-full"
                    name="contact[email]"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'phone' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormPhone-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <input
                    type="tel"
                    id="ContactFormPhone-{{ section.id }}"
                    class="input-full"
                    name="contact[phone]"
                    autocorrect="off"
                    autocapitalize="off"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                </div>

              {%- when 'message' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormMessage-{{ section.id }}">
                    {{ block.settings.label }}
                  </label>

                  <textarea
                    rows="{{ block.settings.rows }}"
                    id="ContactFormMessage-{{ section.id }}"
                    class="input-full"
                    name="contact[body]"
                    placeholder="{{ block.settings.placeholder | escape }}"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >{% if form.body %}{{ form.body }}{% endif %}</textarea>
                </div>

              {%- when 'dropdown' -%}
                <div
                  class="grid__item {% if block.settings.width == 'half' %}medium-up--one-half{% else %}one-whole{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label for="ContactFormDropdown-{{ block.id }}">
                    {{ block.settings.label }}
                  </label>

                  <select
                    id="ContactFormDropdown-{{ block.id }}"
                    class="input-full"
                    name="contact[{{ block.settings.label | handleize }}]"
                    {% if block.settings.required %}
                      required
                    {% endif %}
                  >
                    {%- if block.settings.placeholder != blank -%}
                      <option value="" disabled selected>
                        {{ block.settings.placeholder }}
                      </option>
                    {%- endif -%}

                    {%- assign dropdown_options = block.settings.options | newline_to_br | split: '<br />' -%}

                    {%- for option in dropdown_options -%}
                      {%- assign option_clean = option | strip -%}

                      {%- if option_clean != blank -%}
                        <option value="{{ option_clean | escape }}">
                          {{ option_clean }}
                        </option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </div>

              {%- when 'submit' -%}
                <div
                  class="grid__item one-whole"
                  {{ block.shopify_attributes }}
                >
                  <label
                    for="contact-form-submit-{{ section.id }}"
                    class="hidden-label"
                  >
                    {{ block.settings.label }}
                  </label>

                  <button
                    type="submit"
                    id="contact-form-submit-{{ section.id }}"
                    class="btn"
                  >
                    {{ block.settings.label }}
                  </button>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "class": "index-section",

  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.contact-form.settings.content"
    },
    {
      "type": "text",
      "id": "pre_title",
      "label": "Pre peading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "email_heading",
      "label": "Email heading",
      "default": "Email us"
    },
    {
      "type": "header",
      "content": "E mail"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "hello@lunanuevatequila.com"
    },
    {
      "type": "checkbox",
      "id": "narrow_column",
      "label": "Narrow column",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "name",
      "name": "Name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your name"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Text"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your text"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    },

    {
      "type": "email",
      "name": "Email",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your email"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    },

    {
      "type": "phone",
      "name": "Phone",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Phone"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your phone number"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    },

    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Message"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Enter your message"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "full",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "range",
          "id": "rows",
          "label": "Rows",
          "min": 3,
          "max": 10,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        }
      ]
    },

    {
      "type": "dropdown",
      "name": "Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Subject"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Select an option"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options",
          "default": "General Inquiry\nProduct Question\nOrder Question\nWholesale\nOther",
          "info": "Add one option per line."
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "default": "half",
          "options": [
            {
              "value": "half",
              "label": "Half width"
            },
            {
              "value": "full",
              "label": "Full width"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    },

    {
      "type": "submit",
      "name": "Submit button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Send"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        {
          "type": "name"
        },
        {
          "type": "text"
        },
        {
          "type": "email"
        },
        {
          "type": "message"
        },
        {
          "type": "submit"
        }
      ]
    }
  ],

  "disabled_on": {
    "groups": ["footer", "header", "custom.popups"]
  }
}
{% endschema %}
