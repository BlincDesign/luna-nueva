{%- style -%}
  .newsletter-{{ section.id }} {
    background-color: {{ section.settings.color_background }};
    color: {{ section.settings.color_text }};
    padding-top: {{ section.settings.padding_top }}px !important;
    padding-bottom: {{ section.settings.padding_bottom }}px !important;
  }

  .newsletter-{{ section.id }} .input-group-btn {
    background-color: {{ section.settings.color_background }};
  }

  .newsletter-{{ section.id }} .newsletter-section {
    padding: 0;
}

    @media only screen and (max-width:589px){
      .newsletter-{{ section.id }}{
          padding-top: {{ section.settings.padding_top_mb }}px !important;
          padding-bottom: {{ section.settings.padding_bottom_mb }}px !important;
      }
    }


  .newsletter-section__content .newsletter__input-group {
      width: 100%;
      max-width: 520px;
      gap: 10px;
      background-color: transparent;
  }

  .newsletter-section__content .newsletter__input-group .newsletter__input {
      border-color: rgba(249,246,241,.22);
      border-radius: 50px;
      padding: 15px 20px;
  }

  .newsletter-section__content .newsletter__input-group .newsletter__input::placeholder {
      color: rgba(249,246,241,.66);
  }

  .newsletter-section__content .newsletter__input-group .input-group-btn {
      flex: 0 0 100px;
  }

  .newsletter-section__content .newsletter__input-group .input-group-btn button {
      width: 100%;
      border-radius: 50px !important;
  }

  .newsletter-section .rte p {
      margin-bottom: 0;
  }


{%- endstyle -%}

{% render 'newsletter-section', section: section %}

