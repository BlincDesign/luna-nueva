{% style %}
  #shopify-section-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.section_background }};
  }

  @media only screen and (max-width:589px){
    #shopify-section-{{ section.id }}{
        padding-top: {{ section.settings.padding_top_mb }}px;
        padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }
  }


    .pdl__header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 38px;
    }

    .pdl__right {
      font-weight: 700;
      border-bottom: 1px solid #1a1a1a;
      padding-bottom: 2px;
    }

    .pdl__grid {
      display: flex;
      flex-wrap: wrap;
      gap: 32px;
    }

    .pdl__grid .pdc {
      flex: 1;
    }

    .pdc__arch {
      background: var(--pdc-bg);
      border-radius: 300px 300px 0 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 70px 24px 0px;
      margin-bottom: 24px;
      transition: transform .5s cubic-bezier(.2,.7,.3,1);
    }

    .pdc:hover .pdc__arch {
  transform: translateY(-8px);
}

    .pdc:hover .pdc__bottle {
  transform: translateY(-10px) scale(1.03);
}


    .pdc__bottle {
      max-height: 530px;
      width: auto;
      transition: transform .5s cubic-bezier(.2,.7,.3,1);
    }



    .pdc__title {
      font-size: 48px;
      margin-bottom: 10px;
    }

    .pdc__desc {
      margin-bottom: 14px;
      max-width: 250px;
    }

    .pdc__table {
      border-top: 1px solid rgba(0, 0, 0, 0.12);
    }

    .pdc__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 9px 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.12);
      font-size: 11px;
      text-transform: uppercase;
    }

    .pdc__row--lead {
      padding: 11px 0;
    }

    .pdc__value {
      font-weight: 700;
    }

    .pdc__explore {
      display: inline-block;
      margin-top: 18px;
      font-weight: 700;
      border-bottom: 1px solid #1a1a1a;
      padding-bottom: 2px;
    }

    .pdc__explore:hover {
      opacity: 0.7;
    }

    .pdl__empty {
      color: #7a7a7a;
      font-size: 14px;
    }
{% endstyle %}

<div
  class="page-width"
>
  <div class="pdl__header">
    <div class="pdl__heading-group">
      {%- if section.settings.preheading != blank -%}
        <p class="subheading ">{{ section.settings.preheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heading rte">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.settings.right_text != blank -%}
      <a href="{{ section.settings.right_link | default: '#' }}" class="pdl__right">
        {{ section.settings.right_text }}
        <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>

  <div class="product-details__list pdl__grid">
    {%- for product in section.settings.products -%}
      {%- liquid
        assign details = product.metafields.custom.product_details.value
        assign bg_color = details.background.value | default: '#D9C7A6'

        assign category_label = product.metafields.custom.category.value | default: product.type
        assign origin = product.metafields.custom.origin.value
        assign agave = product.metafields.custom.agave.value
        assign additives = product.metafields.custom.additives.value
        assign rested = product.metafields.custom.rested.value
        assign body_field = product.metafields.custom.body.value
        assign nom = product.metafields.custom.nom.value

        assign abv = product.metafields.custom.abv.value
        assign proof = product.metafields.custom.proof.value
        assign net_content = product.metafields.custom.net_content.value
      -%}

      <div class="pdc" style="--pdc-bg: {{ bg_color }};">
        <div class="pdc__arch">
          {%- if details.image != blank -%}
            {{
              details.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'pdc__bottle', alt: details.title
            }}
          {%- elsif product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', class: 'pdc__bottle', alt: product.title
            }}
          {%- endif -%}
        </div>

        <div class="pdc__body">
          <h3 class="pdc__title">{{ details.title | default: product.title }}</h3>

          {%- if details.description != blank -%}
            <p class="pdc__desc">{{ details.description }}</p>
          {%- endif -%}

          <div class="pdc__table">
            {%- if category_label != blank or origin != blank -%}
              <div class="pdc__row pdc__row--lead">
                <span class="pdc__label">{{ category_label }}</span>
                {%- if origin != blank -%}
                  <span class="pdc__value">ORIGIN · {{ origin }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if agave != blank -%}
              <div class="pdc__row">
                <span class="pdc__label">Agave</span>
                <span class="pdc__value">{{ agave }}</span>
              </div>
            {%- endif -%}

            {%- if additives != blank -%}
              <div class="pdc__row">
                <span class="pdc__label">Additives</span>
                <span class="pdc__value">{{ additives }}</span>
              </div>
            {%- endif -%}

            {%- if rested != blank -%}
              <div class="pdc__row">
                <span class="pdc__label">Rested</span>
                <span class="pdc__value">{{ rested }}</span>
              </div>
            {%- endif -%}

            {%- if body_field != blank -%}
              <div class="pdc__row">
                <span class="pdc__label">Body</span>
                <span class="pdc__value">{{ body_field }}</span>
              </div>
            {%- endif -%}

            {%- if nom != blank -%}
              <div class="pdc__row">
                <span class="pdc__label">NOM</span>
                <span class="pdc__value">{{ nom }}</span>
              </div>
            {%- endif -%}

            {%- if abv != blank or proof != blank or net_content != blank -%}
              <div class="pdc__row pdc__row--foot">
                <span class="pdc__foot">
                  {%- if abv != blank -%}{{ abv }}% ALC/VOL{%- endif -%}
                  {%- if abv != blank and proof != blank -%}·{%- endif -%}
                  {%- if proof != blank -%}{{ proof }} PROOF{%- endif -%}
                </span>
                {%- if net_content != blank -%}
                  <span class="pdc__foot">CONT NET {{ net_content }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <a href="{{ product.url }}" class="pdc__explore">Explore <span aria-hidden="true">→</span></a>
        </div>
      </div>
    {%- else -%}
      <p class="pdl__empty">Select products in the section settings to display them here.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Detail List",
  "class": "section--scheme-secondary",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Selection"
    },
    {
      "type": "textarea",
      "id": "preheading",
      "label": "Pre-heading"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right-side link text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Right-side link URL"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Product Detail List"
    }
  ]
}
{% endschema %}
