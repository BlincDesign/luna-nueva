{% style %}
  #custom__product-details-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media only screen and (max-width:589px){
    #custom__product-details-{{ section.id }}{
        padding-top: {{ section.settings.padding_top_mb }}px;
        padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }
  }

  {%- if section.settings.full_width_desktop -%}
    @media only screen and (min-width:590px){
      #custom__product-details-{{ section.id }} .page-width{
          max-width: none;
          padding-left: 0;
          padding-right: 0;
      }
    }
  {%- endif -%}

  {%- if section.settings.full_width_mobile -%}
    @media only screen and (max-width:589px){
      #custom__product-details-{{ section.id }} .page-width{
          max-width: none;
          padding-left: 0;
          padding-right: 0;
      }
    }
  {%- endif -%}
{% endstyle %}

<div id="custom__product-details-{{ section.id }}" class="color-{{ section.settings.color_scheme }} {% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}">
  <div class="page-width">
    <div class="pdl__header">
      <div class="pdl__heading-group">
        {%- if section.settings.preheading != blank -%}
          <p class="subheading ">{{ section.settings.preheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="heading rte">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.right_text != blank and section.settings.right_link != blank -%}
        <a href="{{ section.settings.right_link }}" class="pdl__right subheading">
          {{ section.settings.right_text }}
          <span aria-hidden="true">→</span>
        </a>
      {% else %}
        <span class="pdl__right subheading">{{ section.settings.right_text }}</span>
      {%- endif -%}
    </div>

    <div class="product-details__list pdl__grid"  data-aos="fade-up">
      {%- for product in section.settings.products -%}
        {%- liquid
          assign bg_color = product.metafields.custom.grid_background.value
          assign image = product.metafields.custom.grid_image

          assign character_texture = product.metafields.custom.character_texture
        -%}

        <div class="pdc" style="--pdc-bg: {{ bg_color }};">
          <div class="pdc__arch">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'pdc__bottle', alt: details.title
              }}
            {%- elsif product.featured_image != blank -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag: loading: 'lazy', class: 'pdc__bottle', alt: product.title
              }}
            {%- endif -%}
          </div>

          <div class="pdc__body mb-text-center">
            <h3 class="pdc__title">{{ product.title | default: product.title }}</h3>

            {%- if character_texture != blank -%}
              <p class="pdc__desc has-primary--font">{{ character_texture }}</p>
            {%- endif -%}

            {% render 'product-details-table', product: product %}

            <div class="pdc__explore--wrapper">
              <a href="{{ product.url }}" class="pdc__explore"
                >Explore <span class="pdc__arrow" aria-hidden="true">→</span></a
              >
            </div>
          </div>
        </div>
      {%- else -%}
        <p class="pdl__empty">No products selected.</p>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Detail List",
  "class": "product-details__list",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Selection"
    },
    {
      "type": "inline_richtext",
      "id": "preheading",
      "label": "Pre-heading"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right-side link text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "right_link",
      "label": "Right-side link URL"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "checkbox",
      "id": "full_width_desktop",
      "label": "Full width (Desktop)",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "checkbox",
      "id": "full_width_mobile",
      "label": "Full width (Mobile)",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Product Detail List"
    }
  ]
}
{% endschema %}
