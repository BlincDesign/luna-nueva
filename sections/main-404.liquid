<div class="page-width page-content text-center">
  <header class="section-header section-header--404">
    <h1 class="section-header__title">{{ 'general.404.title' | t }}</h1>
    <div class="rte text-spacing">
      {{ 'general.404.subtext_html' | t: url: routes.root_url }}
    </div>
  </header>
  {% if section.blocks.size > 0 %}
    <div class="404__blocks">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu-list' %}
            <ul class="404__block-linklist">
              {% for link in block.settings.link_list.links %}
                <li>
                  <a href="{{ link.url }}">
                    <h2>{{ link.title }}</h2>
                  </a>
                </li>
              {% endfor %}
            </ul>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "blocks": [
    {
      "type": "menu-list",
      "name": "Menu list",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "linklist",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
