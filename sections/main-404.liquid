{% style %}
  #section-404-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .wrapper__404 {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
  }

  .block__404--linklist {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  #section-404-{{ section.id }} .section-header--404 {
    flex: 0 1 calc({{ section.settings.left_column_width }}% - 15px);
    justify-content: {{ section.settings.left_vertical_align }};
    display: flex;
    flex-direction: column;
  }

  #section-404-{{ section.id }} .blocks__404 {
    flex: 0 1 calc({{ section.settings.right_column_width }}% - 15px);
    justify-content: {{ section.settings.right_vertical_align }};
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 589px) {
    #section-404-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}

<div id="section-404-{{ section.id }}" class="page-width page-content">
  {% if section.blocks.size > 0 %}<div class="wrapper__404">{% endif %}
  <header class="section-header section-header--404 text-{{ section.settings.left_text_align }}">
    <h1 class="section-header__title">{{ 'general.404.title' | t }}</h1>
    <div class="rte text-spacing">
      {{ 'general.404.subtext_html' | t: url: routes.root_url }}
    </div>
  </header>
  {% if section.blocks.size > 0 %}
    <div class="blocks__404 text-{{ section.settings.right_text_align }}">
      {% for block in section.blocks %}
        {% liquid
          assign menu = linklists[block.settings.linklist]
        %}
        {% case block.type %}
          {% when 'menu-list' %}
            <ul class="block__404--linklist">
              {% for link in menu.links %}
                <li class="site-nav__item linklist__404--item">
                  <a href="{{ link.url }}">
                    <h2>{{ link.title }}</h2>
                  </a>
                </li>
              {% endfor %}
            </ul>
        {% endcase %}
      {% endfor %}
    </div>
  {% endif %}
  {% if section.blocks.size > 0 %}</div>{% endif %}
</div>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "settings": [
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "left_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "left_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "range",
      "id": "right_column_width",
      "label": "Width",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text_alignment",
      "id": "right_text_align",
      "label": "Horizontal alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "right_vertical_align",
      "label": "Vertical alignment",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },

    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "menu-list",
      "name": "Menu list",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "linklist",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
