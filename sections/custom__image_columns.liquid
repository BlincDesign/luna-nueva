{%- liquid
  assign layout_type = section.settings.layout_type | default: 'grid'
  assign columns = section.settings.columns | default: 3
  assign tablet_columns = columns

  if tablet_columns > 2
    assign tablet_columns = 2
  endif

  assign image_size_vw = 100 | divided_by: columns

  assign has_tabs = false
  if section.settings.tags != blank
    assign has_tabs = true
    assign tag_list = section.settings.tags | split: ','
    assign default_tag = tag_list | first | strip | downcase | remove: ' '
  endif
-%}

{%- style -%}
  #custom__image_columns-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media only screen and (max-width: 589px) {
    #custom__image_columns-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mb }}px;
      padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }
  }

  #custom__image_columns-{{ section.id }}.image-columns {
    --image-columns-gap-grid: {{ section.settings.gap }}px;
    --image-columns-gap-rail: {{ section.settings.gap }}px;
  }

  @media only screen and (max-width: 589px) {
    #custom__image_columns-{{ section.id }}.image-columns {
      --image-columns-gap-grid: {{ section.settings.gap_mb }}px;
      --image-columns-gap-rail: {{ section.settings.gap_mb }}px;
    }
  }

  #custom__image_columns-{{ section.id }} .image-columns__grid {
    grid-template-columns: repeat({{ columns }}, minmax(0, 1fr));
  }

  #custom__image_columns-{{ section.id }} .image-columns__rail .image-columns__item {
    flex-basis: calc(
      (100% - {{ columns | minus: 1 }} * var(--image-columns-gap-rail)) / {{ columns }}
    );
  }

  #custom__image_columns-{{ section.id }} .image-columns__step-number {
    color: {{ section.settings.number_color }};
  }

  #custom__image_columns-{{ section.id }} .image-columns__menu {
    background-color: {{ section.settings.card_background }};
    color: {{ section.settings.card_text_color }};
  }

  #custom__image_columns-{{ section.id }} .image-columns__service-number,
  #custom__image_columns-{{ section.id }} .image-columns__note {
    color: {{ section.settings.accent_color }};
  }

  #custom__image_columns-{{ section.id }} .drag-scroller__bar {
    background-color: {{ section.settings.track_color | color_modify: 'alpha', 0.25 }};
  }

  #custom__image_columns-{{ section.id }} .drag-scroller__bar i {
    background-color: {{ section.settings.track_color }};
  }

  #custom__image_columns-{{ section.id }} .image-columns__tab.is-active {
    background-color: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text }};
    border-color: {{ section.settings.tab_active_bg }};
  }

  #custom__image_columns-{{ section.id }} .image-columns__tab {
    background-color: {{ section.settings.tab_inactive_bg }};
    color: {{ section.settings.tab_inactive_text }};
    border-color: {{ section.settings.tab_border_color }};
  }

  .image-columns .image-columns__item {
    display: flex;
    flex-direction: column;
  }

  .image-columns .image-columns__item .image-columns__menu,
  .image-columns .image-columns__item .image-columns__menu .image-columns__ingredients {
    flex: 1;
  }

  .top__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 30px;
  }

  .top__heading-content {
    flex: 1 1 auto;
    max-width: 650px;
  }

  .top__heading-content .theme-block.subheading {
    margin-bottom: 18px;
  }

  .top__heading-actions {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-end;
    gap: 24px;
  }

  .top__heading-actions .image-columns__tabs {
    margin: 0;
  }

  .serve-richtext {
    border-top: 1px solid rgba(45, 49, 53, .32);
  }

  .serve-richtext p {
    margin: 15px 0 5px;
    font-size: var(--type-body-sm-size);
  }

  @media screen and (max-width: 900px) {
    #custom__image_columns-{{ section.id }} .image-columns__grid {
      grid-template-columns: repeat({{ tablet_columns }}, minmax(0, 1fr));
    }

    #custom__image_columns-{{ section.id }} .image-columns__rail .image-columns__item {
      flex-basis: calc(
        (100% - {{ tablet_columns | minus: 1 }} * var(--image-columns-gap-rail)) / {{ tablet_columns }}
      );
    }

    .top__heading {
      flex-direction: column;
      align-items: stretch;
    }

    .top__heading-content {
      max-width: none;
    }

    .top__heading-actions {
      align-items: flex-start;
    }

    #custom__image_columns-{{ section.id }} .page-width.image-columns__inner:has(.image-columns__rail) {
        padding-right: 0;
    }

  }

  @media screen and (max-width: 589px) {
    #custom__image_columns-{{ section.id }} .image-columns__grid {
      grid-template-columns: 1fr;
    }

    #custom__image_columns-{{ section.id }} .image-columns__rail .image-columns__item {
      flex-basis: min(60vw, 352px);
    }

    #custom__image_columns-{{ section.id }} .image-columns__step-text p {
        font-size: 14px;
    }
  }
{%- endstyle -%}

{%- capture blocks_markup -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign block_tags_attr = block.settings.tags | default: 'All' | downcase | remove: ' '
      assign padded_tags = ',' | append: block_tags_attr | append: ','
      assign is_visible_default = true

      if has_tabs
        assign default_needle = ',' | append: default_tag | append: ','
        assign is_visible_default = false

        if padded_tags contains default_needle
          assign is_visible_default = true
        endif
      endif
    -%}

    <article
      class="image-columns__item"
      {% if has_tabs %}data-tags="{{ block_tags_attr }}"{% endif %}
      {% if has_tabs and is_visible_default == false %}hidden{% endif %}
      {{ block.shopify_attributes }}
    >
      <figure class="image-columns__image-wrap">
        {%- if block.settings.image != blank -%}
          {%- render 'image-element', img: block.settings.image, widths: '360, 540, 720, 900, 1080', sizeVariable: image_size_vw, append: 'vw', fallback: '100vw', loading: 'lazy', classes: 'image-columns__image' -%}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </figure>

      {%- case block.type -%}
        {%- when 'step' -%}
          {%- if block.settings.number != blank -%}
            <h2 class="image-columns__step-number">
              {{ block.settings.number }}
            </h2>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h4 class="image-columns__step-heading">
              {{ block.settings.heading }}
            </h4>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="image-columns__step-text has-primary--font rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'service' -%}
          <div class="image-columns__menu">
            <div class="image-columns__menu-header">
              {%- if block.settings.title != blank -%}
                <h5 class="image-columns__service-title">
                  {{ block.settings.title }}
                </h5>
              {%- endif -%}

              {%- if block.settings.number != blank -%}
                <span class="image-columns__service-number">
                  {{ block.settings.number }}
                </span>
              {%- endif -%}
            </div>

            {%- if block.settings.ingredients != blank -%}
              <div class="image-columns__ingredients rte">
                {{ block.settings.ingredients }}
              </div>
            {%- endif -%}

            {%- if block.settings.serve_richtext != blank -%}
              <div class="serve-richtext">
                {{ block.settings.serve_richtext }}
              </div>
            {%- endif -%}

            {%- if block.settings.note != blank -%}
              <div class="image-columns__note">
                {{ block.settings.note }}
              </div>
            {%- endif -%}
          </div>
      {%- endcase -%}
    </article>
  {%- endfor -%}
{%- endcapture -%}

<div
  id="custom__image_columns-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} image-columns{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
  {% if has_tabs %}
    data-has-tabs="true"
  {% endif %}
>
  <div class="page-width image-columns__inner" data-aos="fade-up">
    {%- if section.settings.preheading != blank
      or section.settings.title != blank
      or section.settings.text != blank
      or has_tabs
      or section.settings.link_text != blank
    -%}
      <div class="top__heading">
        {%- if section.settings.preheading != blank
          or section.settings.title != blank
          or section.settings.text != blank
        -%}
          <div class="top__heading-content">
            {%- if section.settings.preheading != blank -%}
              <div
                class="theme-block subheading {% if section.settings.enable_fade_preheading %}text--faded{% endif %} appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}"
              >
                {{ section.settings.preheading }}
              </div>
            {%- endif -%}

            {%- if section.settings.title != blank -%}
              <div class="theme-block appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}">
                <h2>
                  {{ section.settings.title }}
                </h2>
              </div>
            {%- endif -%}

            {%- if section.settings.text != blank -%}
              <div
                class="theme-block theme-block__text {% if section.settings.enable_fade_text %}text--faded{% endif %}"
              >
                <div class="appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}">
                  {%- if section.settings.enlarge_text -%}
                    <div class="enlarge-text">
                  {%- endif -%}

                  {{ section.settings.text }}

                  {%- if section.settings.enlarge_text -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="top__heading-actions">
          {%- if has_tabs -%}
            <div
              class="image-columns__tabs"
              role="tablist"
              aria-label="Filter"
            >
              {%- for tag in tag_list -%}
                {%- assign tag_label = tag | strip -%}
                {%- assign tag_slug = tag_label | downcase | remove: ' ' -%}

                <button
                  type="button"
                  class="image-columns__tab{% if tag_slug == default_tag %} is-active{% endif %}"
                  data-tab-value="{{ tag_slug }}"
                  data-tab-label="{{ tag_label | escape }}"
                  role="tab"
                  aria-selected="{% if tag_slug == default_tag %}true{% else %}false{% endif %}"
                >
                  {{ tag_label }}
                </button>
              {%- endfor -%}
            </div>

            <div class="image-columns__serve-count text-fade" aria-live="polite"></div>
          {%- endif -%}

          {% if section.settings.link_text != blank %}
            <div class="theme-block theme-block__buttons appear-delay{% cycle '', '-1', '-2', '-3', '-4' %}">
              {% render 'button',
                label: section.settings.link_text,
                url: section.settings.link,
                type: section.settings.button_type,
                arrow: true
              %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
    {%- if section.blocks.size > 0 -%}
      {%- if layout_type == 'slider' -%}
        {%- capture rail_markup -%}
          <div class="image-columns__rail">
            {{ blocks_markup }}
          </div>
        {%- endcapture -%}

        {%- render 'layout.drag-scroller', slot: rail_markup, label: 'Image columns, scroll horizontally' -%}
      {%- else -%}
        <div class="image-columns__grid">
          {{ blocks_markup }}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}

  .section-image-columns.background-image {
    z-index: 0;
  }

  .image-columns__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 32px;
  }

  .image-columns__tab {
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    padding: .95rem 1.4rem;
    min-width: 96px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--type-button-size);
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    transition: background-color .15s ease, color .15s ease, border-color .15s ease;
  }

  .image-columns__serve-count {
    font-size: var(--type-button-size);
  }

  .image-columns__grid {
    display: grid;
    gap: var(--image-columns-gap-grid);
  }

  .image-columns__rail {
    display: flex;
    gap: var(--image-columns-gap-rail);
    /* width: max-content; */
    min-width: 100%;
    padding: 0 20px 19px 0;
  }

  .image-columns__rail .image-columns__item {
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  .image-columns .image-columns__item[hidden] {
    display: none;
  }

  .image-columns__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1.25;
    margin: 0;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    background-color: rgba(0, 0, 0, 0.05);
    pointer-events: none;
  }

  .image-columns__image-wrap image-element,
  .image-columns__image-wrap .image-element,
  .image-columns__image-wrap .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-columns__step-number {
    margin: 25px 0 19px;
    font-family: var(--typeBasePrimary);
    font-weight: 700;
    font-size: 64px;
  }

  .image-columns__step-heading {
    margin: 0 0 11px;
  }

  .image-columns__step-text {
    margin: 0;
  }

  .image-columns__menu {
    display: flex;
    flex-direction: column;
    padding: 16px 17px 14px;
  }

  .image-columns__menu-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding-bottom: 11px;
    border-bottom: 1px solid rgba(45, 49, 53, 0.32);
  }

  .image-columns__service-title {
    margin: 0;
    font-weight: 400;
    line-height: 1.14;
  }

  .image-columns__service-number {
    flex: none;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: var(--type-caption-size);
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1;
  }

  .image-columns__ingredients {
    padding: 4px 0 2px;
  }

  .image-columns__ingredients p {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin: 0;
    padding: 8px 0;
    font-size: var(--type-caption-size);
    text-transform: uppercase;
  }

  .image-columns__ingredients p::before {
    order: 1;
    flex: 1 1 auto;
    border-bottom: 1px dotted rgba(45, 49, 53, 0.38);
    content: '';
    transform: translateY(-0.2em);
  }

  .image-columns__ingredients strong {
    order: 2;
    font-weight: 700;
    white-space: nowrap;
  }

  .image-columns__note {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid rgba(45, 49, 53, 0.32);
    text-transform: uppercase;
  }

  .image-columns__note p {
    font-size: var(--type-caption-size);
    margin: 0;
  }

  @media screen and (max-width: 589px) {
    .image-columns__menu {
      padding: 14px;
    }
  }

  @media screen and (min-width: 901px) {
    .image-columns {
      --image-columns-bleed: max(68px, calc((100vw - 1560px) / 2 + 68px));

    }

    .image-columns .drag-scroller__bar {
      margin: 18px auto;
      width: calc(100% - var(--image-columns-bleed));
    }
  }
{% endstylesheet %}

<script>
  const initTagFilter = (root) => {
    if (!root || root.dataset.tagFilterInit === 'true') return;

    root.dataset.tagFilterInit = 'true';

    const tabs = [...root.querySelectorAll('[data-tab-value]')];
    const items = [...root.querySelectorAll('[data-tags]')];
    const serveCount = root.querySelector('.image-columns__serve-count');

    const updateServeCount = (tab) => {
      if (!serveCount) return;

      const value = tab.dataset.tabValue;
      const label = tab.dataset.tabLabel || value;

      if (value === 'all') {
        serveCount.textContent = `ALL ${items.length} SERVES`;
        return;
      }

      const count = items.filter((item) => {
        const tags = item.dataset.tags?.split(',') || [];
        return tags.includes(value);
      }).length;

      serveCount.textContent = `${count} SERVES WITH ${label.toUpperCase()}`;
    };

    const updateFilter = (tab) => {
      const value = tab.dataset.tabValue;

      tabs.forEach((currentTab) => {
        const isActive = currentTab === tab;

        currentTab.classList.toggle('is-active', isActive);
        currentTab.setAttribute('aria-selected', isActive);
      });

      items.forEach((item) => {
        const tags = item.dataset.tags?.split(',') || [];

        item.hidden = value !== 'all' && !tags.includes(value);
      });

      updateServeCount(tab);

      requestAnimationFrame(() => {
        window.dispatchEvent(new Event('resize'));
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        updateFilter(tab);
      });
    });

    const activeTab = tabs.find((tab) => tab.classList.contains('is-active'));

    if (activeTab) {
      updateServeCount(activeTab);
    }
  };

  const initAllTagFilters = () => {
    document.querySelectorAll('.image-columns[data-has-tabs="true"]').forEach(initTagFilter);
  };

  initAllTagFilters();

  document.addEventListener('shopify:section:load', initAllTagFilters);
</script>

{% schema %}
{
  "name": "Image columns",
  "tag": "section",
  "class": "section-image-columns",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-6" },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "header",
      "content": "Top heading"
    },
    {
      "type": "inline_richtext",
      "id": "preheading",
      "label": "Prehading"
    },
    {
      "type": "checkbox",
      "id": "enable_fade_preheading",
      "label": "Lighten preheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "info": "Color will apply on bold and italic."
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Text",
      "info": "Color will apply on bold and italic."
    },
    {
      "type": "checkbox",
      "id": "enlarge_text",
      "label": "Enlarge text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "subheading",
      "label": "Subheading",
      "info": "Will convert the text into subheading format (changes font size)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_italic",
      "label": "Italic",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_fade_text",
      "label": "Lighten text",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button text"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button style",
      "default": "secondary",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "header",
      "content": "Block settings"
    },
    { "type": "color", "id": "number_color", "label": "Step number color", "default": "#9b3a15" },
    { "type": "color", "id": "card_background", "label": "Service card background", "default": "#f9f6f1" },
    { "type": "color", "id": "card_text_color", "label": "Service card text color", "default": "#2d3135" },
    { "type": "color", "id": "accent_color", "label": "Service accent color", "default": "#9b3a15" },
    { "type": "color", "id": "track_color", "label": "Slider scroll indicator color", "default": "#2d3135" },

    {
      "type": "header",
      "content": "Tabs"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Tabs (comma separated)",
      "info": "Leave blank to disable tabs. First tag is the default active tab. Example: All, Silver, Reposado, Añejo"
    },
    { "type": "color", "id": "tab_active_bg", "label": "Active tab background", "default": "#2d3135" },
    { "type": "color", "id": "tab_active_text", "label": "Active tab text", "default": "#ffffff" },
    { "type": "color", "id": "tab_inactive_bg", "label": "Inactive tab background", "default": "#f9f6f1" },
    { "type": "color", "id": "tab_inactive_text", "label": "Inactive tab text", "default": "#2d3135" },
    { "type": "color", "id": "tab_border_color", "label": "Tab border color", "default": "#2d3135", "alpha": true },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout type",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Number of columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mb",
      "label": "Gap between items (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
