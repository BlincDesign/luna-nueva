{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .additives {
    width: 100%;
  }

  .additives__header {
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr) auto;
    align-items: center;

    border-top: 1px solid rgba(45, 49, 53, 0.35);
    border-bottom: 1px solid rgba(45, 49, 53, 0.35);
  }

  .additives__header-left,
  .additives__header-product,
  .additives__header-permitted,
  .additives__header-bottle {
    padding: 14px 0;
  }

  .additives__header-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
  }

  .additives__header-title {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .additives__header-permitted {
    margin-left: 40px;
    margin-right: 40px;
  }

  .additives__header-bottle {
    text-align: right;
  }

  .additives__row {
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr) 108px;

    border-bottom: 1px solid rgba(45, 49, 53, 0.35);
  }

  .additives__additive {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
    padding: 18px 0;
  }

  .additives__icon {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .additives__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .additives__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .additives__name {
    margin: 0;
    min-width: 0;
  }

  .additives__progress {
    width: 100%;
    padding-right: 30px;

    display: flex;
    align-items: center;
  }

  .additives__progress-bar {
    position: relative;
    width: 100%;
    height: 20px;

    display: flex;
    align-items: center;
  }

  .additives__progress-track {
    position: absolute;
    left: 0;
    right: 0;

    height: 1px;

    background: rgba(45, 49, 53, 0.7);
  }

  .additives__progress-fill {
    position: absolute;
    left: 0;

    width: var(--progress-width);
    max-width: 100%;
    height: 1px;

    background: #2D3135;
  }

  .additives__progress-marker {
    position: absolute;
    left: var(--progress-width);
    top: 50%;

    width: 10px;
    height: 10px;

    border: 1px solid #2D3135;
    border-radius: 50%;
    background: {{ section.settings.background_color }};

    transform: translate(-50%, -50%);
  }

  .additives__progress-marker-100 {
    position: absolute;
    left: 100%;
    top: 50%;

    width: 10px;
    height: 10px;

    border-radius: 50%;
    background: #2D3135;

    transform: translate(-50%, -50%);
  }

  .additives__percentage {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    width: 108px;

    font-weight: 700;
    font-size: 1.06rem;
    white-space: nowrap;
  }

  @media screen and (max-width: 589px) {

    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .additives__header-luna {
      display: none;
    }

    .additives__header {
      grid-template-columns: 1fr auto;
    }

    .additives__header-left {
      grid-column: 1;
    }

    .additives__header-bottle {
      grid-column: 2;
      text-align: right;
    }

    .additives__header-product,
    .additives__header-permitted {
      display: none;
    }

    .additives__row {
      grid-template-columns: minmax(0, 1fr) 108px;

      grid-template-areas:
        "additive percentage"
        "progress progress";
    }

    .additives__additive {
      grid-area: additive;

      padding: 18px 0 10px;
    }

    .additives__progress {
      grid-area: progress;

      padding: 0 0 10px;
    }

    .additives__percentage {
      grid-area: percentage;

      width: auto;
      align-self: center;
      padding-top: 0;
    }
  }
{% endstyle %}

<div class="page-width">
  <div class="additives">
    <div class="additives__header">
      <div class="additives__header-left">
        <div class="additives__header-title">
          {{ section.settings.heading_additive }}
        </div>
      </div>

      <div class="additives__header-right">
        <div class="additives__header-title additives__header-luna">
          {{ section.settings.heading_product }}
        </div>

        <div style="display: flex;">
          <div class="additives__header-title additives__header-permitted">
            {{ section.settings.heading_permitted }}
          </div>

          <div class="additives__header-title additives__header-bottle">
            {{ section.settings.heading_bottle }}
          </div>
        </div>
      </div>
    </div>

    <div class="additives__body">
      {% for block in section.blocks %}
        {% liquid
          assign percentage_value = block.settings.percentage | strip_html | strip | remove: '%' | replace: ',', '.' | plus: 0.0
          assign progress_width = percentage_value | times: 100
        %}

        <div
          class="additives__row"
          {{ block.shopify_attributes }}
        >

          <div class="additives__additive">
            <div class="additives__icon">
              {% if block.settings.custom_icon_image != blank %}
                {{
                  block.settings.custom_icon_image
                  | image_url: width: 80
                  | image_tag: loading: 'lazy', widths: '40, 80', sizes: '40px'
                }}

              {% elsif block.settings.icon != blank %}
                {% render 'icon', name: block.settings.icon %}

              {% else %}
                {% liquid
                  assign fallback_icons = 'droplet,leaf,cube,half-circle' | split: ','
                  assign fallback_index = forloop.index0 | modulo: fallback_icons.size
                  assign fallback_icon = fallback_icons[fallback_index]
                %}

                {% render 'icon', name: fallback_icon %}
              {% endif %}
            </div>

            <div class="additives__name">
              {{ block.settings.name }}
            </div>
          </div>

          <div class="additives__progress">
            <div
              class="additives__progress-bar"
              role="progressbar"
              aria-valuenow="{{ percentage_value }}"
              aria-valuemin="0"
              aria-valuemax="{{ section.settings.maximum_percentage }}"
              style="--progress-width: {{ progress_width }}%;"
            >
              <span class="additives__progress-track"></span>

              <span class="additives__progress-fill"></span>

              <span class="additives__progress-marker"></span>

              <span class="additives__progress-marker-100"></span>
            </div>
          </div>

          <div class="additives__percentage">
            {{ block.settings.percentage }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

