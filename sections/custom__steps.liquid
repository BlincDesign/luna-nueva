{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    background-image: {%- if section.settings.background_image != blank -%}url('{{ section.settings.background_image | image_url: width: 2400 }}'){%- else -%}none{%- endif -%};
    background-position: {{ section.settings.background_position }};
    background-repeat: {{ section.settings.background_repeat }};
    background-size: {{ section.settings.background_size }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .steps-section__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .steps-section__rule,
  #shopify-section-{{ section.id }} .steps-section__item::before {
    border-color: {{ section.settings.rule_color }};
  }

  #shopify-section-{{ section.id }} .steps-section__eyebrow,
  #shopify-section-{{ section.id }} .steps-section__detail {
    color: {{ section.settings.muted_text_color }};
  }

  #shopify-section-{{ section.id }} .steps-section__number {
    color: {{ section.settings.number_color }};
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .steps-section__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="steps-section">
  <div class="page-width steps-section__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="steps-section__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="steps-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_rule -%}
      <hr class="steps-section__rule">
    {%- endif -%}

    <div class="steps-section__intro">
      {%- if section.settings.statement != blank -%}
        <div class="steps-section__statement rte">{{ section.settings.statement }}</div>
      {%- endif -%}

      {%- assign detail_blocks = section.blocks | where: 'type', 'detail' -%}
      {%- if detail_blocks.size > 0 -%}
        <div class="steps-section__details">
          {%- for block in detail_blocks -%}
            <div class="steps-section__detail rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
    {%- if step_blocks.size > 0 -%}
      <div class="steps">
        {%- for block in step_blocks -%}
          <article class="step steps-section__item" {{ block.shopify_attributes }}>
            <figure class="steps-section__image-wrap">
              {%- if block.settings.image != blank -%}
                {%- render 'image-element',
                  img: block.settings.image,
                  widths: '360, 540, 720, 900, 1080',
                  sizeVariable: '33vw',
                  fallback: '100vw',
                  loading: 'lazy',
                  classes: 'steps-section__image'
                -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </figure>

            {%- if block.settings.number != blank -%}
              <span class="steps-section__number">{{ block.settings.number }}</span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="steps-section__step-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="steps-section__step-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .steps-section__eyebrow {
    margin: 0 0 18px;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .steps-section__heading {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(38px, 4vw, 64px);
    font-weight: 400;
    line-height: 1.08;
  }

  .steps-section__rule {
    width: calc(100% + 68px);
    margin: 26px 0 30px -68px;
    border-width: 1px 0 0;
  }

  .steps-section__intro {
    display: grid;
    grid-template-columns: 34fr 66fr;
    gap: clamp(28px, 4vw, 72px);
    align-items: start;
  }

  .steps-section__statement {
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: clamp(15px, 1.25vw, 17px);
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.75;
    text-transform: uppercase;
  }

  .steps-section__statement p,
  .steps-section__detail p,
  .steps-section__step-text p {
    margin: 0;
  }

  .steps-section__details {
    display: grid;
    gap: 18px;
  }

  .steps-section__detail {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr);
    gap: 16px;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: 14px;
    line-height: 1.7;
  }

  .steps-section__detail::before {
    width: 9px;
    height: 9px;
    margin-top: 9px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: currentColor;
    content: '';
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.4vw, 52px);
    margin-top: clamp(48px, 6vw, 88px);
  }

  .steps-section__item {
    min-width: 0;
  }

  .steps-section__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1.25;
    margin: 0 0 26px;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .steps-section__image-wrap image-element,
  .steps-section__image-wrap .image-element,
  .steps-section__image-wrap .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .steps-section__number {
    display: block;
    margin-bottom: 19px;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .steps-section__step-heading {
    margin: 0 0 11px;
    font-size: clamp(24px, 2vw, 32px);
    font-weight: 400;
    line-height: 1.2;
  }

  .steps-section__step-text {
    font-size: 14px;
    line-height: 1.7;
  }

  @media screen and (max-width: 900px) {
    .steps-section__rule {
      width: calc(100% + 40px);
      margin-left: -40px;
    }

    .steps-section__intro,
    .steps {
      grid-template-columns: 1fr;
    }

    .steps {
      gap: 45px;
    }
  }

  @media screen and (max-width: 589px) {
    .steps-section__rule {
      width: calc(100% + 20px);
      margin-left: -20px;
    }

    .steps-section__heading {
      font-size: clamp(36px, 10vw, 48px);
    }

    .steps-section__image-wrap {
      margin-bottom: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Steps",
  "tag": "section",
  "class": "section-steps",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Making" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From the Highlands to your table." },
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "default": "<p>The liquid was built with integrity before the brand had a name.</p>"
    },
    { "type": "checkbox", "id": "show_rule", "label": "Show divider", "default": true },
    { "type": "header", "content": "Colors and background" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#aebfb4" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "select",
      "id": "background_position",
      "label": "Background image position",
      "default": "center center",
      "options": [
        { "value": "left top", "label": "Top left" },
        { "value": "center top", "label": "Top center" },
        { "value": "right top", "label": "Top right" },
        { "value": "left center", "label": "Center left" },
        { "value": "center center", "label": "Center" },
        { "value": "right center", "label": "Center right" },
        { "value": "left bottom", "label": "Bottom left" },
        { "value": "center bottom", "label": "Bottom center" },
        { "value": "right bottom", "label": "Bottom right" }
      ]
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "Background image size",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "auto", "label": "Original size" }
      ]
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "Background image repeat",
      "default": "no-repeat",
      "options": [
        { "value": "no-repeat", "label": "Don't repeat" },
        { "value": "repeat", "label": "Repeat" }
      ]
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2d3135" },
    { "type": "color", "id": "muted_text_color", "label": "Muted text color", "default": "#52605a" },
    { "type": "color", "id": "number_color", "label": "Step number color", "default": "#9b3a15" },
    { "type": "color", "id": "rule_color", "label": "Divider color", "default": "#82938a" },
    { "type": "header", "content": "Desktop spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    { "type": "header", "content": "Mobile spacing" },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p><strong>Highland and lowland agave.</strong> The agave grows across highland and lowland terrain, each plant taking years to reach its moment.</p>"
        }
      ]
    },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The land decides" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>The agave grows across highland and lowland terrain, each plant taking years to reach its moment.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "detail" },
        {
          "type": "detail",
          "settings": {
            "text": "<p><strong>The Vivanco family, NOM 1414.</strong> One of the most respected producers in Mexico, where the craft of tequila runs generations deep.</p>"
          }
        },
        {
          "type": "detail",
          "settings": {
            "text": "<p><strong>Additive-free, in full.</strong> No additives, no shortcuts, no compromise.</p>"
          }
        },
        {
          "type": "detail",
          "settings": {
            "text": "<p><strong>Rested, not rushed.</strong> Silver goes straight to the glass. Reposado is aged seven months. Añejo, thirteen.</p>"
          }
        },
        { "type": "step" },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "heading": "Then it waits",
            "text": "<p>Reposado and Añejo rest in barrel at the Vivanco family distillery in the Highlands of Jalisco. Nothing is added while they do. Silver skips this part entirely.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "heading": "The table it was made for",
            "text": "<p>The point was never the bottle. It was the room the bottle ends up in, and the people who are still there at the end of the night.</p>"
          }
        }
      ]
    }
  ],
  "disabled_on": { "groups": ["footer", "header", "custom.popups"] }
}
{% endschema %}
