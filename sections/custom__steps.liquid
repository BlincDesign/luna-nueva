{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    background-image: {%- if section.settings.background_image != blank -%}url('{{ section.settings.background_image | image_url: width: 2400 }}'){%- else -%}none{%- endif -%};
    background-position: {{ section.settings.background_position }};
    background-repeat: {{ section.settings.background_repeat }};
    background-size: {{ section.settings.background_size }};
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .steps-section__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .steps-section__number {
    color: {{ section.settings.number_color }};
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .steps-section__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="steps-section">
  <div class="page-width steps-section__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="steps">
        {%- for block in section.blocks -%}
          <article class="step steps-section__item" {{ block.shopify_attributes }}>
            <figure class="steps-section__image-wrap">
              {%- if block.settings.image != blank -%}
                {%- render 'image-element',
                  img: block.settings.image,
                  widths: '360, 540, 720, 900, 1080',
                  sizeVariable: '33vw',
                  fallback: '100vw',
                  loading: 'lazy',
                  classes: 'steps-section__image'
                -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </figure>

            {%- if block.settings.number != blank -%}
              <span class="steps-section__number">{{ block.settings.number }}</span>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="steps-section__step-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="steps-section__step-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .steps-section__step-text p {
    margin: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.4vw, 52px);
  }

  .steps-section__item {
    min-width: 0;
  }

  .steps-section__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1.25;
    margin: 0 0 26px;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / 40% 40% 0 0;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .steps-section__image-wrap image-element,
  .steps-section__image-wrap .image-element,
  .steps-section__image-wrap .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .steps-section__number {
    display: block;
    margin-bottom: 19px;
    font-family: var(--typeBasePrimary), var(--typeBaseFallback);
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .steps-section__step-heading {
    margin: 0 0 11px;
    font-size: clamp(24px, 2vw, 32px);
    font-weight: 400;
    line-height: 1.2;
  }

  .steps-section__step-text {
    font-size: 14px;
    line-height: 1.7;
  }

  @media screen and (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .steps {
      gap: 45px;
    }
  }

  @media screen and (max-width: 589px) {
    .steps-section__image-wrap {
      margin-bottom: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Steps",
  "tag": "section",
  "class": "section-steps background-image",
  "settings": [
    { "type": "header", "content": "Colors and background" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#aebfb4" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2d3135" },
    { "type": "color", "id": "number_color", "label": "Step number color", "default": "#9b3a15" },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "mobile_padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "The land decides" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The agave grows across highland and lowland terrain, each plant taking years to reach its moment.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "number": "02", "heading": "Then it waits", "text": "<p>Reposado and Añejo rest in barrel at the Vivanco family distillery in the Highlands of Jalisco. Nothing is added while they do. Silver skips this part entirely.</p>" } },
        { "type": "step", "settings": { "number": "03", "heading": "The table it was made for", "text": "<p>The point was never the bottle. It was the room the bottle ends up in, and the people who are still there at the end of the night.</p>" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["footer", "header", "custom.popups"] }
}
{% endschema %}
