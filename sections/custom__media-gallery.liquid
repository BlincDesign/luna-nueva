{%- liquid
  assign content_block = null
  for block in section.blocks
    if block.type == 'content' and content_block == null
      assign content_block = block
    endif
  endfor

  assign image_blocks = section.blocks | where: 'type', 'image'

  assign d_span = section.settings.tile_width_max | minus: section.settings.tile_width_min
  assign d_slope = d_span | divided_by: 610.0
  assign d_coefficient = d_slope | times: 100 | round: 3
  assign d_min_contribution = d_slope | times: 990
  assign d_intercept = section.settings.tile_width_min | minus: d_min_contribution | round: 3

  assign m_span = section.settings.tile_width_mobile_max | minus: section.settings.tile_width_mobile_min
  assign m_slope = m_span | divided_by: 360.0
  assign m_coefficient = m_slope | times: 100 | round: 3
  assign m_min_contribution = m_slope | times: 320
  assign m_intercept = section.settings.tile_width_mobile_min | minus: m_min_contribution | round: 3
-%}

{% stylesheet %}
  .media-gallery__inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: clamp(32px, 5vw, 96px);
  }

  .media-gallery__media {
    flex: 1 1 0;
    min-width: 0;
  }

  .media-gallery__grid .spacer {
      max-width: 50px;
  }


  @media screen and (min-width: 901px) {
    .media-gallery__inner--flush-right {
      --media-gallery-right-bleed: max(68px, calc((100vw - 1560px) / 2 + 68px));
    }

    .media-gallery__inner--flush-right .media-gallery__media {
      margin-right: calc(0px - var(--media-gallery-right-bleed));
    }

    .media-gallery__inner--flush-right .drag-scroller__bar {
      width: calc(100% - var(--media-gallery-right-bleed));
    }
  }

  .media-gallery__eyebrow {
    margin: 0 0 12px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: var(--type-body-sm-size);
  }

  .media-gallery__heading {
    margin: 0 0 16px;
  }

  .media-gallery__body {
    margin: 0 0 24px;
  }

  .media-gallery__divider {
    width: 100%;
    height: 1px;
    margin: 0 0 24px;
    border: 0;
    background-color: currentColor;
    opacity: 0.15;
  }

  .media-gallery__grid {
    display: grid;
    grid-auto-flow: column;
    padding-bottom: 12px;
  }

  .media-gallery__tile {
    position: relative;
    display: flex;
    flex-direction: row;
    margin: 0;
    overflow: hidden;
    scroll-snap-align: start;
    pointer-events: none;

  }

  
  .media-gallery__tile {
    grid-row: 2;
  }

  .media-gallery__tile--tall {
    grid-row: span 2;
    flex-direction: column;
  }

  .media-gallery__image {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .media-gallery__image image-element,
  .media-gallery__image .media-gallery__image-img,
  .media-gallery__image .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-gallery__image--video is-land,
  .media-gallery__image--video .element-video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 900px) {
    .media-gallery__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    .media-gallery__grid .spacer {
      max-width: 0;
    }
  }

  @media screen and (max-width: 680px) {
    .media-gallery__tile--split,
    .media-gallery__tile--tall.media-gallery__tile--split {
      flex-direction: row;
    }
  }
{% endstylesheet %}

{% style %}
  #custom__media-gallery-{{ section.id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  {% if section.settings.position == 'right' %}
    #custom__media-gallery-{{ section.id }} .media-gallery__inner {
      flex-direction: row-reverse;
    }
  {% endif %}

  @media only screen and (max-width:589px){
    #custom__media-gallery-{{ section.id }}{
        padding-top: {{ section.settings.padding_top_mb }}px;
        padding-bottom: {{ section.settings.padding_bottom_mb }}px;
    }
  }

  #shopify-section-{{ section.id }} .media-gallery__content {
    flex: 0 0 {{ section.settings.content_width }}%;
    max-width: {{ section.settings.content_width }}%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .media-gallery__grid {
    grid-template-rows: repeat(2, {{ section.settings.row_height }}px);
    grid-auto-columns: clamp({{ section.settings.tile_width_min }}px, calc({{ d_intercept }}px + {{ d_coefficient }}vw), {{ section.settings.tile_width_max }}px);
    gap: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery__tile {
    gap: {{ section.settings.gap }}px;
  }

  @media screen and (max-width: 680px) {
    #shopify-section-{{ section.id }} .media-gallery__grid {
      grid-template-rows: repeat(2, {{ section.settings.row_height_mobile }}px);
      grid-auto-columns: clamp({{ section.settings.tile_width_mobile_min }}px, calc({{ m_intercept }}px + {{ m_coefficient }}vw), {{ section.settings.tile_width_mobile_max }}px);
      gap: {{ section.settings.gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__tile {
      gap: {{ section.settings.gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__grid.media-gallery__grid--stack {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: none;
      padding-bottom: 0;
    }

    #shopify-section-{{ section.id }} .media-gallery__grid--stack .media-gallery__tile {
      grid-row: auto;
      aspect-ratio: 1 / 1;
    }

    #shopify-section-{{ section.id }} .media-gallery__grid--stack .media-gallery__tile--tall {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 5;
    }

    #shopify-section-{{ section.id }} .media-gallery__grid--stack .media-gallery__tile:first-child {
      grid-column: 1 / -1;
    }

    #shopify-section-{{ section.id }} .media-gallery__grid--stack .spacer {
      display: none;
    }
  }

  {% if section.settings.mobile_layout == 'grid' %}
    @media screen and (max-width: 589px) {
      #shopify-section-{{ section.id }} .media-gallery__inner--flush-right .media-gallery__media {
        margin-right: -20px;
      }
    }

    @media screen and (min-width: 590px) and (max-width: 680px) {
      #shopify-section-{{ section.id }} .media-gallery__inner--flush-right .media-gallery__media {
        margin-right: -40px;
      }
    }
  {% endif %}

  @media screen and (max-width: 900px) {
     #shopify-section-{{ section.id }} .media-gallery__content {
      flex-basis: 100%;
      max-width: 100%;
    }
  }
{% endstyle %}

{% capture content_markup %}
  {% if content_block != nil %}
    <div class="media-gallery__content" {{ content_block.shopify_attributes }}>
      {% if content_block.settings.eyebrow != blank %}
        <p class="media-gallery__eyebrow">{{ content_block.settings.eyebrow }}</p>
      {% endif %}
      {% if content_block.settings.heading != blank %}
        {% assign heading_tag = content_block.settings.heading_size %}
      <{{ heading_tag }} class="media-gallery__heading"> {{ content_block.settings.heading }} </{{ heading_tag }}>
      {% endif %}

      {%- if content_block.settings.show_divider -%}
        <div class="media-gallery__divider"></div>
      {%- endif -%}
      
      {% if content_block.settings.body != blank %}
        <div class="media-gallery__body has-primary--font rte{% if content_block.settings.enlarge_text %} enlarge-text{% endif %}">{{ content_block.settings.body }}</div>
      {% endif %}
      {% if content_block.settings.button_label != blank %}
        <div class="media-gallery__actions">
          {% render 'button', label: content_block.settings.button_label, url: content_block.settings.button_url, type: 'primary', arrow: true %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

{% capture media_markup %}
  {% if image_blocks.size > 0 %}
    <div class="media-gallery__media" data-aos="fade-up">
      {% capture track %}
        <div class="media-gallery__grid{% if section.settings.mobile_layout == 'grid' %} media-gallery__grid--stack{% endif %}">
          {% for block in image_blocks %}
            {% render 'media-gallery-tile',
              block: block,
              tile_width: section.settings.tile_width_max,
              tile_width_mobile: section.settings.tile_width_mobile_max
            %}
          {% endfor %}
          <div class="spacer"></div>
        </div>
      {% endcapture %}
      {% render 'layout.drag-scroller', slot: track, label: 'Gallery, scroll horizontally' %}
    </div>
  {% endif %}
{% endcapture %}

<div
  id="custom__media-gallery-{{ section.id }}"
  class="color-{{ section.settings.color_scheme }} media-gallery{% if section.settings.stylized_bg %} background-image{% endif %}{% if section.settings.header_secondary %} section--scheme-secondary{% endif %}"
>
  <div class="media-gallery__inner{% unless section.settings.full_width %} page-width{% endunless %}{% if section.settings.flow_right and section.settings.full_width == false %} media-gallery__inner--flush-right{% endif %}">
    {{ content_markup }}
    {{ media_markup }}
  </div>
</div>

{% schema %}
{
  "name": "Media gallery",
  "tag": "section",
  "class": "section-media-gallery",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "header_secondary",
      "label": "Secondary header",
      "info": "Changes header's color scheme on intersection.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "stylized_bg",
      "label": "Enable stylized background",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "position",
      "default": "left",
      "label": "Position",
      "options": [
        {
          "label": "Content left, Media right",
          "value": "left"
        },
        {
          "label": "Content right, Media left",
          "value": "right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "info": "Works when Content block is added",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "flow_right",
      "label": "Flow to right",
      "info": "Extends the gallery to the right edge of the viewport.",
      "default": false
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "number",
      "id": "tile_width_min",
      "label": "Smallest column width (desktop)",
      "default": 240
    },
    {
      "type": "number",
      "id": "tile_width_max",
      "label": "Largest Column width (desktop)",
      "default": 360
    },
    {
      "type": "number",
      "id": "row_height",
      "label": "Tile height (desktop)",
      "default": 220
    },
    {
      "type": "number",
      "id": "tile_width_mobile_min",
      "label": "Smallest column width (mobile)",
      "default": 150
    },
    {
      "type": "number",
      "id": "tile_width_mobile_max",
      "label": "Largest column width (mobile)",
      "default": 280
    },
    {
      "type": "number",
      "id": "row_height_mobile",
      "label": "Column height (mobile)",
      "default": 150
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between images (desktop)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Space between images (mobile)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "info": "Scroll keeps the desktop drag gallery, resized. Grid stacks the first (full-height) tile on top and lays the rest out two per row.",
      "options": [
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        },
        {
          "value": "grid",
          "label": "Stacked grid"
        }
      ],
      "default": "scroll"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mb",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mb",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "info": "Small label shown above the heading.",
          "default": "Bring the Party"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The bottle you grab before the night starts."
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            }
          ],
          "default": "h2"
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show divider",
          "default": false
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Description",
          "default": "<p>Add your description here.</p>"
        },
        {
          "type": "checkbox",
          "id": "enlarge_text",
          "label": "Enlarge text",
          "default": true
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "See what's coming up"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "checkbox",
          "id": "tall",
          "label": "Full-height tile",
          "info": "Makes this tile twice as tall. If you add two images below, they'll stack on top of each other instead of sitting side by side.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "split_images",
          "label": "Split images side by side (mobile)",
          "info": "On mobile, makes the first and second image each take up 50% of the tile's width instead of stacking. Overrides the stacking from Full-height tile. Desktop is unaffected.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_one",
          "label": "First image"
        },
        {
          "type": "video",
          "id": "video_one",
          "label": "First video",
          "info": "Optional. If added, this video plays instead of the first image above."
        },
        {
          "type": "text",
          "id": "image_one_caption",
          "label": "First image caption"
        },
        {
          "type": "image_picker",
          "id": "image_two",
          "label": "Second image",
          "info": "Optional. Add a second photo to share this tile with the first image."
        },
        {
          "type": "video",
          "id": "video_two",
          "label": "Second video",
          "info": "Optional. If added, this video plays instead of the second image above."
        },
        {
          "type": "text",
          "id": "image_two_caption",
          "label": "Second image caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media gallery",
      "blocks": [
        { "type": "content" },
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    },
    {
      "name": "Media gallery - media only",
      "blocks": [
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
