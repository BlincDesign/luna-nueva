{%- comment -%}
  Tile sizing model (all driven by section settings, see schema below):

  Desktop (>= 750px)
    tall OFF -> tile is `tile_width` wide, `tile_height` tall. The two
      images stack (column) and split that height 50/50.
    tall ON  -> tile is two tile-widths + one gap wide, `tile_height`
      tall. The two images sit side by side (row) and split that width
      50/50, each filling the full height.

  Mobile (< 750px) — the axis flips relative to desktop
    tall OFF -> tile is full width, `mobile_tile_height` tall. The two
      images sit side by side (row) and split that width 50/50.
    tall ON  -> tile is full width, auto height. The two images stack
      (column), each explicitly `mobile_tile_height` tall.

  A block with only image_one set always renders that image alone at
  100% of whatever box the tile resolves to above.

  Scrolling/dragging is intentionally not implemented yet.
{%- endcomment -%}

{%- liquid
  assign content_block = nil
  assign content_index = -1
  assign first_image_index = -1

  for block in section.blocks
    case block.type
      when 'content'
        if content_block == nil
          assign content_block = block
          assign content_index = forloop.index0
        endif
      when 'image'
        if first_image_index == -1
          assign first_image_index = forloop.index0
        endif
    endcase
  endfor

  assign content_after_media = false
  if content_block != nil and first_image_index != -1 and content_index > first_image_index
    assign content_after_media = true
  endif

  assign image_blocks = section.blocks | where: 'type', 'image'
  assign half_gap = section.settings.gap | divided_by: 2.0
-%}

{% style %}
  #shopify-section-{{ section.id }} .media-gallery__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .media-gallery__content {
    width: 100%;
    max-width: {{ section.settings.content_width }}%;
  }

  #shopify-section-{{ section.id }} .media-gallery__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .media-gallery__heading {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .media-gallery__body {
    margin: 0 0 24px;
  }

  /* Tiles: the tile itself is the flex row/column; tile-media is the
     per-image sizing slot; image is the cropped visual box. */
  #shopify-section-{{ section.id }} .media-gallery__tile-media {
    position: relative;
  }

  #shopify-section-{{ section.id }} .media-gallery__image {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.05);
  }

  #shopify-section-{{ section.id }} .media-gallery__image image-element,
  #shopify-section-{{ section.id }} .media-gallery__image .media-gallery__image-img,
  #shopify-section-{{ section.id }} .media-gallery__image .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .media-gallery__caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 13px;
    border-radius: 999px;
  }

  /* Gallery wrap — flexbox, not grid: a "tall" tile's width is just
     2 tile-widths + 1 gap, which flex-basis/calc() expresses directly.
     The grid equivalent would need column spans to line up with a
     percentage track size, which is far more fragile. */
  #shopify-section-{{ section.id }} .media-gallery__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery__tile {
    display: flex;
    flex-direction: column;
    flex: 0 0 {{ section.settings.tile_width }}%;
    max-width: {{ section.settings.tile_width }}%;
    height: {{ section.settings.tile_height }}px;
    gap: {{ section.settings.gap }}px;
  }

  /* tall, desktop: double-wide, row of two, each full tile height */
  #shopify-section-{{ section.id }} .media-gallery__tile--wide {
    flex-direction: row;
    flex-basis: calc({{ section.settings.tile_width }}% * 2 + {{ section.settings.gap }}px);
    max-width: calc({{ section.settings.tile_width }}% * 2 + {{ section.settings.gap }}px);
  }

  #shopify-section-{{ section.id }} .media-gallery__tile--wide .media-gallery__tile-media {
    flex: 0 0 calc(50% - {{ half_gap }}px);
    width: calc(50% - {{ half_gap }}px);
    height: 100%;
  }

  #shopify-section-{{ section.id }} .media-gallery__tile--wide .media-gallery__tile-media:only-child {
    flex: 1 1 100%;
    width: 100%;
  }

  /* not tall, desktop: normal width, column of two, splitting the height */
  #shopify-section-{{ section.id }} .media-gallery__tile:not(.media-gallery__tile--wide) .media-gallery__tile-media {
    flex: 1 1 0;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .media-gallery__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__content {
      max-width: 100%;
    }

    /* One tile per row on mobile regardless of tall */
    #shopify-section-{{ section.id }} .media-gallery__tile {
      flex-basis: 100%;
      max-width: 100%;
    }

    /* not tall, mobile: row of two sharing the mobile tile height */
    #shopify-section-{{ section.id }} .media-gallery__tile:not(.media-gallery__tile--wide) {
      flex-direction: row;
      height: {{ section.settings.mobile_tile_height }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__tile:not(.media-gallery__tile--wide) .media-gallery__tile-media {
      flex: 0 0 calc(50% - {{ half_gap }}px);
      width: calc(50% - {{ half_gap }}px);
      height: 100%;
    }

    #shopify-section-{{ section.id }} .media-gallery__tile:not(.media-gallery__tile--wide) .media-gallery__tile-media:only-child {
      flex: 1 1 100%;
      width: 100%;
    }

    /* tall, mobile: column of two, each image explicitly sized —
       the tile itself is auto height, not the mobile tile height */
    #shopify-section-{{ section.id }} .media-gallery__tile--wide {
      flex-direction: column;
      height: auto;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .media-gallery__tile--wide .media-gallery__tile-media {
      flex: 0 0 {{ section.settings.mobile_tile_height }}px;
      width: 100%;
      height: {{ section.settings.mobile_tile_height }}px;
    }
  }
{% endstyle %}

{% capture content_markup %}
  {% if content_block != nil %}
    <div class="media-gallery__content" {{ content_block.shopify_attributes }}>
      {% if content_block.settings.eyebrow != blank %}
        <p class="media-gallery__eyebrow">{{ content_block.settings.eyebrow }}</p>
      {% endif %}
      {% if content_block.settings.heading != blank %}
        <h2 class="media-gallery__heading">{{ content_block.settings.heading }}</h2>
      {% endif %}
      {% if content_block.settings.body != blank %}
        <div class="media-gallery__body rte">{{ content_block.settings.body }}</div>
      {% endif %}
      {% if content_block.settings.button_label != blank %}
        <div class="media-gallery__actions">
          {% render 'button', label: content_block.settings.button_label, url: content_block.settings.button_url, type: 'primary', arrow: true %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

{% capture media_markup %}
  {% if image_blocks.size > 0 %}
    <div class="media-gallery__grid">
      {% for block in image_blocks %}
        {% render 'media-gallery-tile', block: block, tile_width: section.settings.tile_width %}
      {% endfor %}
    </div>
  {% endif %}
{% endcapture %}

<div class="media-gallery">
  <div class="media-gallery__inner{% unless section.settings.full_width %} page-width{% endunless %}">
    {% if content_after_media %}
      {{ media_markup }}
      {{ content_markup }}
    {% else %}
      {{ content_markup }}
      {{ media_markup }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Media gallery",
  "tag": "section",
  "class": "section-media-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "info": "Only applies when a Content block has been added.",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "range",
      "id": "tile_width",
      "label": "Tile width (desktop)",
      "info": "A wide tile (see Image block) is 2 tile-widths plus one gap.",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
    "type": "number",
    "id": "tile_height",
    "label": "Tile height (desktop)",
    "default": 595
    },
    {
    "type": "number",
    "id": "mobile_tile_height",
    "label": "Tile height (mobile)",
    "info": "For a wide tile this is the height of each image, since they stack on mobile.",
    "default": 450
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Bring the Party"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The bottle you grab before the night starts."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Add your description here.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See what's coming up"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "checkbox",
          "id": "tall",
          "label": "Make this block wide — two images side by side",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_one",
          "label": "Image one"
        },
        {
          "type": "text",
          "id": "image_one_caption",
          "label": "Image one caption"
        },
        {
          "type": "image_picker",
          "id": "image_two",
          "label": "Image two"
        },
        {
          "type": "text",
          "id": "image_two_caption",
          "label": "Image two caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media gallery",
      "blocks": [
        { "type": "content" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" }
      ]
    },
    {
      "name": "Media gallery - media only",
      "blocks": [
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
