{%- liquid
  assign content_block = nil
  assign content_index = -1
  assign first_image_index = -1

  for block in section.blocks
    case block.type
      when 'content'
        if content_block == nil
          assign content_block = block
          assign content_index = forloop.index0
        endif
      when 'image'
        if first_image_index == -1
          assign first_image_index = forloop.index0
        endif
    endcase
  endfor

  assign content_after_media = false
  if content_block != nil and first_image_index != -1 and content_index > first_image_index
    assign content_after_media = true
  endif

  assign image_blocks = section.blocks | where: 'type', 'image'
-%}

{% style %}
  #shopify-section-{{ section.id }} .media-gallery__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .media-gallery__content {
    max-width: {{ section.settings.content_width }}%;
  }

  #shopify-section-{{ section.id }} .media-gallery__grid,
  #shopify-section-{{ section.id }} .media-gallery__track {
    gap: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery__grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
  }

  #shopify-section-{{ section.id }} .media-gallery__tile {
    --media-gallery-card-width: {{ section.settings.card_width }}px;
    --media-gallery-gap: {{ section.settings.gap }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .media-gallery__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .media-gallery__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .media-gallery__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__content {
      max-width: 100%;
    }
  }




  
/* Story gallery section */

.story-gallery__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.story-gallery--left .story-gallery__inner,
.story-gallery--right .story-gallery__inner {
    flex-direction: row;
    align-items: center;
}

.story-gallery--right .story-gallery__inner {
    flex-direction: row-reverse;
}

.story-gallery__content {
    flex: 0 0 auto;
    width: 100%;
    max-width: var(--story-gallery-content-width, 480px);
}

.story-gallery--above .story-gallery__content {
    max-width: 100%;
}

.story-gallery__gallery {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
}

.story-gallery--gallery-only .story-gallery__content {
    display: none;
}

.story-gallery__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.story-gallery__heading {
    margin: 0 0 16px;
}

.story-gallery__text {
    margin: 0 0 24px;
}

.story-gallery__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
}

.story-gallery__track {
    display: flex;
    gap: var(--story-gallery-gap, 16px);
    padding-bottom: 4px;
}

.story-gallery__tile {
    position: relative;
    flex: 0 0 var(--story-gallery-tile-width, 320px);
    width: var(--story-gallery-tile-width, 320px);
    scroll-snap-align: start;
}

.story-gallery__tile--pair {
    flex-basis: calc(var(--story-gallery-tile-width, 320px) * 1.6);
    width: calc(var(--story-gallery-tile-width, 320px) * 1.6);
}

.story-gallery__tile-media {
    display: flex;
    gap: 8px;
    width: 100%;
    height: 100%;
}

.story-gallery__tile-image-wrap {
    position: relative;
    flex: 1 1 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.05);
}

.story-gallery__tile--tall .story-gallery__tile-image-wrap {
    aspect-ratio: 3 / 5;
}

.story-gallery__tile-image-wrap image-element,
.story-gallery__tile-image-wrap img,
.story-gallery__tile-image-wrap .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.story-gallery__caption {
    margin: 8px 0 0;
    font-size: 13px;
}

.story-gallery__caption--overlay {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    margin: 0;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    border-radius: 999px;
}

.story-gallery__drag-hint {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 0 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.story-gallery__gallery drag-scroller:not([data-overflowing]) ~ .story-gallery__drag-hint {
    display: none;
}

@media screen and (max-width: 749px) {
    .story-gallery--left .story-gallery__inner,
    .story-gallery--right .story-gallery__inner {
        flex-direction: column;
        align-items: stretch;
    }

    .story-gallery__content {
        max-width: 100%;
    }
}

/* End story gallery section */


/* Media gallery section */

.media-gallery__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.media-gallery--media-only .media-gallery__content {
    display: none;
}

.media-gallery__content {
    width: 100%;
}

.media-gallery__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.media-gallery__heading {
    margin: 0 0 16px;
}

.media-gallery__body {
    margin: 0 0 24px;
}

.media-gallery__actions {
    display: flex;
}

/* Fixed grid mode */

.media-gallery__grid {
    display: grid;
    grid-auto-flow: row dense;
}

.media-gallery__tile--wide {
    grid-column: span 1;
}

@media screen and (min-width: 750px) {
    .media-gallery--grid .media-gallery__tile--wide {
        grid-column: span 2;
    }
}

/* Scrolling row mode */

.media-gallery__scroll drag-scroller {
    display: block;
}

.media-gallery__track {
    display: flex;
}

.media-gallery--scroll .media-gallery__tile {
    flex: 0 0 var(--media-gallery-card-width, 320px);
    width: var(--media-gallery-card-width, 320px);
    scroll-snap-align: start;
}

.media-gallery--scroll .media-gallery__tile--wide {
    flex-basis: calc(var(--media-gallery-card-width, 320px) * 2 + var(--media-gallery-gap, 16px));
    width: calc(var(--media-gallery-card-width, 320px) * 2 + var(--media-gallery-gap, 16px));
}



{% endstyle %}

{% capture content_markup %}
  {% if content_block != nil %}
    <div class="media-gallery__content" {{ content_block.shopify_attributes }}>
      {% if content_block.settings.eyebrow != blank %}
        <p class="media-gallery__eyebrow">{{ content_block.settings.eyebrow }}</p>
      {% endif %}
      {% if content_block.settings.heading != blank %}
        <h2 class="media-gallery__heading">{{ content_block.settings.heading }}</h2>
      {% endif %}
      {% if content_block.settings.body != blank %}
        <div class="media-gallery__body rte">{{ content_block.settings.body }}</div>
      {% endif %}
      {% if content_block.settings.button_label != blank %}
        <div class="media-gallery__actions">
          {% render 'button', label: content_block.settings.button_label, url: content_block.settings.button_url, type: 'primary', arrow: true %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

{% capture media_markup %}
  {% if image_blocks.size > 0 %}
    {% if section.settings.layout_mode == 'scroll' %}
      {% capture track %}
        <div class="media-gallery__track">
          {% for block in image_blocks %}
            {% render 'media-gallery-tile', block: block, layout_mode: section.settings.layout_mode, card_width: section.settings.card_width, columns_desktop: section.settings.columns_desktop %}
          {% endfor %}
        </div>
      {% endcapture %}
      <div class="media-gallery__scroll">
        {% render 'layout.drag-scroller', slot: track, label: 'Media gallery, scroll horizontally' %}
      </div>
    {% else %}
      <div class="media-gallery__grid">
        {% for block in image_blocks %}
          {% render 'media-gallery-tile', block: block, layout_mode: section.settings.layout_mode, card_width: section.settings.card_width, columns_desktop: section.settings.columns_desktop %}
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
{% endcapture %}

<div class="media-gallery media-gallery--{{ section.settings.layout_mode }}{% if content_block == nil %} media-gallery--media-only{% endif %}">
  <div class="media-gallery__inner{% unless section.settings.full_width %} page-width{% endunless %}">
    {% if content_after_media %}
      {{ media_markup }}
      {{ content_markup }}
    {% else %}
      {{ content_markup }}
      {{ media_markup }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Media gallery",
  "tag": "section",
  "class": "section-media-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Fixed grid" },
        { "value": "scroll", "label": "Scrolling row" }
      ]
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Grid columns"
    },
    {
      "type": "paragraph",
      "content": "Only applies in Fixed grid mode."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Scrolling row"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "info": "Only applies in Scrolling row mode. Controls how much of the next card peeks into view.",
      "min": 200,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "info": "Only applies when a Content block has been added.",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Bring the Party"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The bottle you grab before the night starts."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Add your description here.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See what's coming up"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "limit": 9,
      "settings": [
        {
          "type": "checkbox",
          "id": "tall",
          "label": "Make this block wide — two images side by side",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_one",
          "label": "Image one"
        },
        {
          "type": "text",
          "id": "image_one_caption",
          "label": "Image one caption"
        },
        {
          "type": "image_picker",
          "id": "image_two",
          "label": "Image two"
        },
        {
          "type": "text",
          "id": "image_two_caption",
          "label": "Image two caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media gallery - grid",
      "settings": {
        "layout_mode": "grid"
      },
      "blocks": [
        { "type": "content" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    },
    {
      "name": "Media gallery - scrolling wall",
      "settings": {
        "layout_mode": "scroll"
      },
      "blocks": [
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image", "settings": { "tall": true } }
      ]
    }
  ]
}
{% endschema %}
