{%- comment -%}
  Layout model, reverse-engineered from design.html's actual .wall (section
  7, "the uneven grid") and .ev/.ev-grid (section 8, "community & events")
  rather than from a hand-written spec:

  Content + media (from .ev, plus .sec-head's "content above the wall")
    content_position picks the arrangement: "before" is .ev's real
    two-column split (content_width controls the content column, media
    takes the rest, stacks to one column at <=900px); "above" stacks
    content full width above the gallery, unconditionally, matching how
    sections 7/9 put their heading above the wall instead of beside it.

  The gallery wall (from .wall)
    CSS Grid, grid-auto-flow: column, exactly 2 fixed-height rows,
    fixed-width auto-columns. A normal image block is 1 column x 1 row.
    `tall` is grid-row: span 2 — same width, full wall height, not wider.
    Overflow scrolls horizontally and drags (see layout.drag-scroller);
    on mobile (<=680px, .wall's own breakpoint) it stays the same 2-row
    wall, just with smaller tiles — it never collapses to one column.

  Two images in one block (Shopify-only; design.html tiles are always a
  single image) follow the shape the tile already has: a normal
  (half-height) tile is short and wide, so two images sit side by side;
  a tall (full-height) tile is narrow and tall, so two images stack.
{%- endcomment -%}

{%- liquid
  assign content_block = nil
  for block in section.blocks
    if block.type == 'content' and content_block == nil
      assign content_block = block
    endif
  endfor

  assign image_blocks = section.blocks | where: 'type', 'image'

  # Fluid tile width: clamp(min, calc(intercept + coefficient*vw), max), scaling
  # linearly between (viewport_min, tile_width_min) and (viewport_max, tile_width_max)
  # instead of jumping between two fixed values at the breakpoint — same technique
  # design.html uses for .wall's grid-auto-columns (clamp(240px, 25vw, 360px)).
  assign d_span = section.settings.tile_width_max | minus: section.settings.tile_width_min
  assign d_slope = d_span | divided_by: 610.0
  assign d_coefficient = d_slope | times: 100 | round: 3
  assign d_min_contribution = d_slope | times: 990
  assign d_intercept = section.settings.tile_width_min | minus: d_min_contribution | round: 3

  assign m_span = section.settings.tile_width_mobile_max | minus: section.settings.tile_width_mobile_min
  assign m_slope = m_span | divided_by: 360.0
  assign m_coefficient = m_slope | times: 100 | round: 3
  assign m_min_contribution = m_slope | times: 320
  assign m_intercept = section.settings.tile_width_mobile_min | minus: m_min_contribution | round: 3
-%}

{% style %}
  #shopify-section-{{ section.id }} .media-gallery__inner {
    display: flex;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .media-gallery__inner--above {
    flex-direction: column;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .media-gallery__inner--before {
    flex-direction: row;
    align-items: center;
    gap: clamp(32px, 5vw, 96px);
  }

  #shopify-section-{{ section.id }} .media-gallery {
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .media-gallery__inner--before .media-gallery__content {
    flex: 0 0 {{ section.settings.content_width }}%;
    max-width: {{ section.settings.content_width }}%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .media-gallery__media {
    flex: 1 1 0;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .media-gallery__eyebrow {
    margin: 0 0 12px;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .media-gallery__heading {
    margin: 0 0 16px;
  }

  #shopify-section-{{ section.id }} .media-gallery__body {
    margin: 0 0 24px;
  }

  /* The wall — CSS Grid, not flex: grid-auto-flow: column lets normal
     tiles pack two-per-column automatically, and a tall tile just spans
     both rows of its own column. That auto-placement is what a flex
     track can't give us for free. */
  #shopify-section-{{ section.id }} .media-gallery__grid {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, {{ section.settings.row_height }}px);
    grid-auto-columns: clamp({{ section.settings.tile_width_min }}px, calc({{ d_intercept }}px + {{ d_coefficient }}vw), {{ section.settings.tile_width_max }}px);
    gap: {{ section.settings.gap }}px;
    padding-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .media-gallery__tile {
    position: relative;
    display: flex;
    flex-direction: row;
    gap: {{ section.settings.gap }}px;
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    scroll-snap-align: start;
  }

  #shopify-section-{{ section.id }} .media-gallery__tile--tall {
    grid-row: span 2;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .media-gallery__image {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 18px;
  }

  #shopify-section-{{ section.id }} .media-gallery__image image-element,
  #shopify-section-{{ section.id }} .media-gallery__image .media-gallery__image-img,
  #shopify-section-{{ section.id }} .media-gallery__image .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .media-gallery__caption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 1;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  @media screen and (max-width: 900px) {
    #shopify-section-{{ section.id }} .media-gallery__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .media-gallery__inner--before {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }

    #shopify-section-{{ section.id }} .media-gallery__inner--before .media-gallery__content {
      flex-basis: 100%;
      max-width: 100%;
    }
  }

  /* The wall itself only steps down at its own (narrower) breakpoint —
     it stays a 2-row scroller here, just with smaller tiles. */
  @media screen and (max-width: 680px) {
    #shopify-section-{{ section.id }} .media-gallery__grid {
      grid-template-rows: repeat(2, {{ section.settings.row_height_mobile }}px);
      grid-auto-columns: clamp({{ section.settings.tile_width_mobile_min }}px, calc({{ m_intercept }}px + {{ m_coefficient }}vw), {{ section.settings.tile_width_mobile_max }}px);
    }
  }
{% endstyle %}

{% capture content_markup %}
  {% if content_block != nil %}
    <div class="media-gallery__content" {{ content_block.shopify_attributes }}>
      {% if content_block.settings.eyebrow != blank %}
        <p class="media-gallery__eyebrow">{{ content_block.settings.eyebrow }}</p>
      {% endif %}
      {% if content_block.settings.heading != blank %}
        <h2 class="media-gallery__heading">{{ content_block.settings.heading }}</h2>
      {% endif %}
      {% if content_block.settings.body != blank %}
        <div class="media-gallery__body rte">{{ content_block.settings.body }}</div>
      {% endif %}
      {% if content_block.settings.button_label != blank %}
        <div class="media-gallery__actions">
          {% render 'button', label: content_block.settings.button_label, url: content_block.settings.button_url, type: 'primary', arrow: true %}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endcapture %}

{% capture media_markup %}
  {% if image_blocks.size > 0 %}
    <div class="media-gallery__media">
      {% capture track %}
        <div class="media-gallery__grid">
          {% for block in image_blocks %}
            {% render 'media-gallery-tile',
              block: block,
              tile_width: section.settings.tile_width_max,
              tile_width_mobile: section.settings.tile_width_mobile_max
            %}
          {% endfor %}
        </div>
      {% endcapture %}
      {% render 'layout.drag-scroller', slot: track, label: 'Gallery, scroll horizontally' %}
    </div>
  {% endif %}
{% endcapture %}

<div class="media-gallery">
  <div class="media-gallery__inner media-gallery__inner--{{ section.settings.content_position }}{% unless section.settings.full_width %} page-width{% endunless %}">
    {{ content_markup }}
    {{ media_markup }}
  </div>
</div>

{% schema %}
{
  "name": "Media gallery",
  "tag": "section",
  "class": "section-media-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "info": "Only applies when a Content block has been added.",
      "default": "before",
      "options": [
        { "value": "above", "label": "Above gallery" },
        { "value": "before", "label": "Before gallery" }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "info": "Only applies in \"Before gallery\" position. Content and gallery stack below 900px.",
      "min": 20,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "paragraph",
      "content": "The gallery is a 2-row wall that scrolls and drags sideways once tiles overflow the container."
    },
    {
      "type": "range",
      "id": "tile_width_min",
      "label": "Tile width — min (desktop)",
      "info": "Tile width scales fluidly with screen size between min and max, instead of jumping at a breakpoint.",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "tile_width_max",
      "label": "Tile width — max (desktop)",
      "min": 240,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height (desktop)",
      "info": "A normal tile is one row tall. A wide tile spans both rows.",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "tile_width_mobile_min",
      "label": "Tile width — min (mobile)",
      "min": 100,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "tile_width_mobile_max",
      "label": "Tile width — max (mobile)",
      "min": 180,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "Row height (mobile)",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Bring the Party"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The bottle you grab before the night starts."
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Add your description here.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "See what's coming up"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "checkbox",
          "id": "tall",
          "label": "Full height (spans both rows)",
          "info": "Off: a half-height tile — two images (if both are set) sit side by side. On: a full-height tile — two images stack instead.",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image_one",
          "label": "Image one"
        },
        {
          "type": "text",
          "id": "image_one_caption",
          "label": "Image one caption"
        },
        {
          "type": "image_picker",
          "id": "image_two",
          "label": "Image two"
        },
        {
          "type": "text",
          "id": "image_two_caption",
          "label": "Image two caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media gallery",
      "blocks": [
        { "type": "content" },
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    },
    {
      "name": "Media gallery - media only",
      "blocks": [
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image", "settings": { "tall": true } },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
